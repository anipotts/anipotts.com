#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${CODEX_WORKTREE_PATH:-$repo_root}"

if [ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]; then
  # shellcheck disable=SC1090
  . "${NVM_DIR:-$HOME/.nvm}/nvm.sh"
  nvm use --silent "$(cat "$repo_root/.nvmrc")" >/dev/null
fi

require_tool() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required tool: $1" >&2
    echo "PATH=$PATH" >&2
    exit 127
  fi
}

validate_toolchain() {
  require_tool node
  require_tool pnpm
  node -e 'const [M,m,p]=process.versions.node.split(".").map(Number); if (!((M===24&&(m>19||(m===19&&p>=0)))||M===25)) { console.error(`anipotts.com requires Node >=24.19.0 <26; found ${process.version}. Run: nvm install && nvm use`); process.exit(1) }'
}

require_dependencies() {
  if [ ! -d node_modules ] || [ ! -x node_modules/.bin/turbo ]; then
    echo "Dependencies are not ready in this worktree. Run: bash ./scripts/codex-action bootstrap" >&2
    echo "Bootstrap installs the frozen lockfile; ensure sufficient disk space first." >&2
    exit 1
  fi
}

pnpm_cmd() {
  validate_toolchain
  require_dependencies
  pnpm "$@"
}

case "${1:-}" in
  setup)
    validate_toolchain
    git rev-parse --is-inside-work-tree >/dev/null
    if [ ! -f package.json ] || [ ! -f pnpm-workspace.yaml ] || [ ! -f pnpm-lock.yaml ]; then
      echo "Not an anipotts.com workspace: package and lockfile manifests are required." >&2
      exit 1
    fi
    echo "Repository and Node/pnpm preflight passed. No dependencies installed; no application checks run."
    if [ -x node_modules/.bin/turbo ]; then
      echo "Existing dependencies detected. Develop/check actions will validate through their normal commands."
    else
      echo "Dependency bootstrap deferred. When ready, run: bash ./scripts/codex-action bootstrap"
    fi
    ;;
  bootstrap)
    validate_toolchain
    pnpm install --frozen-lockfile
    ;;
  www-dev)
    pnpm_cmd dev:www
    ;;
  admin-dev)
    pnpm_cmd dev:admin
    ;;
  local-dev)
    pnpm_cmd dev:all
    ;;
  local-status)
    validate_toolchain
    pnpm dev:local:status
    ;;
  local-stop)
    validate_toolchain
    pnpm dev:local:stop
    ;;
  check-www)
    pnpm_cmd turbo build --filter=@anipotts/www...
    pnpm_cmd turbo typecheck --filter=@anipotts/www...
    ;;
  check-all)
    pnpm_cmd validate
    ;;
  check-changed)
    pnpm_cmd check:changed
    ;;
  pr-status)
    require_tool gh
    exec gh pr view --json number,title,state,isDraft,headRefOid,mergeStateStatus,statusCheckRollup,url
    ;;
  live-state)
    require_tool gh
    gh run list --workflow Deploy --limit 5
    for path in / /making /orchestrating /writing /writing/saturdays-are-for-claude-code /api/health; do
      code="$(curl -s -o /dev/null -w '%{http_code}' "https://anipotts.com$path")"
      echo "anipotts.com$path -> $code"
    done

    for path in /shipping /running; do
      location="$(curl -sSI "https://anipotts.com$path" | awk 'tolower($1)=="location:" {print $2}' | tr -d '\r')"
      echo "anipotts.com$path -> $location"
    done
    ;;
  *)
    echo "usage: $0 {setup|bootstrap|www-dev|admin-dev|local-dev|local-status|local-stop|check-www|check-all|check-changed|pr-status|live-state}" >&2
    exit 2
    ;;
esac
