---
const { nonce } = Astro.props;
---

<details data-review-indicator>
  <summary>local preview · checking identity</summary>
  <p data-review-revision></p>
  <p data-review-content></p>
  <p>
    <strong>code:</strong> review this combined candidate before production merge.
  </p>
  <p>
    <strong>content:</strong> use production admin to publish real content. local
    edits stay local.
  </p>
  <p>
    <strong>deployment:</strong> approve the exact checked release separately.
  </p>
</details>
<style is:inline>
  [data-review-indicator] {
    position: fixed;
    bottom: 12px;
    right: 12px;
    z-index: 10000;
    max-width: min(360px, calc(100vw - 24px));
    font:
      12px/1.4 system-ui,
      sans-serif;
    color: #f4f5f7;
    background: #171b24;
    border: 1px solid #596274;
    border-radius: 8px;
    padding: 8px 10px;
    box-shadow: 0 2px 8px #0003;
  }
  [data-review-indicator] summary {
    cursor: pointer;
    min-height: 28px;
    display: list-item;
    overflow-wrap: anywhere;
  }
  [data-review-indicator] p {
    margin: 8px 0 0;
    overflow-wrap: anywhere;
    font-size: 12px;
  }
  [data-review-indicator][data-state="stale"],
  [data-review-indicator][data-state="error"],
  [data-review-indicator][data-state="unavailable"] {
    border-color: #f4b364;
    color: #ffdda8;
  }
  [data-review-indicator] summary:focus-visible {
    outline: 2px solid #94b9ff;
    outline-offset: 4px;
  }
</style>
<script is:inline nonce={nonce}>
  (() => {
    const previous = window.__previewIdentityCleanup;
    if (previous) previous();
    let timer,
      controller,
      retired = false;
    const refresh = async () => {
      const host = document.querySelector("[data-review-indicator]");
      if (!host || retired) return;
      controller = new AbortController();
      try {
        const response = await fetch("/api/review-identity", {
          cache: "no-store",
          signal: controller.signal,
        });
        if (!response.ok) throw Error();
        const identity = await response.json();
        if (retired) return;
        const sync = identity.sync ?? {
          state: "unavailable",
          label: "content sync unavailable",
        };
        host.dataset.state = sync.state;
        host.querySelector("summary").textContent =
          `local · ${identity.revision.slice(0, 8)}${identity.dirty ? " + edits" : ""} · ${sync.label}`;
        host.querySelector("[data-review-revision]").textContent =
          `${identity.branch} · ${identity.revision}`;
        host.querySelector("[data-review-content]").textContent =
          `${sync.records ?? "?"} published records · synced ${sync.syncedAt ?? "never"}`;
      } catch {
        if (!retired) {
          host.dataset.state = "error";
          host.querySelector("summary").textContent =
            "local preview · identity unavailable";
        }
      }
      if (!retired) timer = setTimeout(refresh, 5000);
    };
    const cleanup = () => {
      retired = true;
      clearTimeout(timer);
      controller?.abort();
      document.removeEventListener("astro:before-swap", cleanup);
      window.removeEventListener("pagehide", cleanup);
    };
    window.__previewIdentityCleanup = cleanup;
    document.addEventListener("astro:before-swap", cleanup, { once: true });
    window.addEventListener("pagehide", cleanup, { once: true });
    refresh();
  })();
</script>
