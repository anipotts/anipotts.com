{
  "name": "@anipotts/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./public/site": "./src/public/site.ts",
    "./public/pages": "./src/public/pages.ts",
    "./public/references": "./src/public/references.ts",
    "./public/schema": {
      "types": "./dist/public/schema.d.ts",
      "import": "./dist/public/schema.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./public": {
      "types": "./dist/public/index.d.ts",
      "import": "./dist/public/index.js"
    },
    "./public/defaults": {
      "types": "./dist/public/defaults.d.ts",
      "import": "./dist/public/defaults.js"
    },
    "./public/editor": {
      "types": "./dist/public/editor.d.ts",
      "import": "./dist/public/editor.js"
    },
    "./public/homepage": {
      "types": "./dist/public/homepage.d.ts",
      "import": "./dist/public/homepage.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js"
    }
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anipotts/types": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
