{
  "name": "anipotts.com",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Ani Potts",
  "homepage": "https://anipotts.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/anipotts/anipotts.com"
  },
  "description": "Personal website and content platform for anipotts.com",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=24.19.0 <26"
  },
  "scripts": {
    "dev": "pnpm dev:all",
    "dev:www": "node scripts/dev/portless-preview.mjs ensure www",
    "dev:admin": "node scripts/dev/portless-preview.mjs ensure admin",
    "dev:all": "node scripts/dev/portless-preview.mjs ensure all",
    "dev:status": "node scripts/dev/portless-preview.mjs status all",
    "dev:stop": "node scripts/dev/portless-preview.mjs stop all",
    "dev:local": "pnpm dev:all",
    "dev:local:ensure": "pnpm dev:all",
    "dev:local:status": "pnpm dev:status",
    "dev:local:stop": "pnpm dev:stop",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{astro,ts,tsx,mjs,md,json}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,tsx,mjs,md,json}\"",
    "admin:preview": "node scripts/admin/admin-preview.mjs ensure",
    "admin:preview:ensure": "node scripts/admin/admin-preview.mjs ensure",
    "admin:preview:status": "node scripts/admin/admin-preview.mjs status",
    "admin:preview:stop": "node scripts/admin/admin-preview.mjs stop",
    "proof:admin-passkey": "node scripts/admin/passkey-proof.mjs",
    "proof:admin-content": "node scripts/admin/content-proof.mjs",
    "content:generate": "node scripts/content/generate-public-content.mjs",
    "content:check": "node scripts/content/generate-public-content.mjs --check",
    "update-claude-stats": "node scripts/claude/generate-claude-stats.mjs",
    "test:deploy-targets": "node scripts/ci/compute-deploy-targets.test.mjs",
    "test:deployment-plan": "node scripts/ci/deployment-plan.test.mjs",
    "test:admin-preview": "node scripts/ci/admin-preview.test.mjs",
    "test:portless-preview": "node scripts/ci/portless-preview.test.mjs",
    "test:brand": "node scripts/ci/brand-contract.test.mjs",
    "test:admin-solid-retirement": "node scripts/ci/admin-solid-retirement.test.mjs",
    "test:admin-routes": "node scripts/ci/admin-route-parity.test.mjs",
    "test:admin-fixture-boundary": "node scripts/ci/admin-fixture-boundary.test.mjs",
    "test:content-platform": "pnpm content:check && pnpm --filter @anipotts/content build && node scripts/ci/content-platform.test.mjs",
    "test:public-boundary": "node scripts/ci/public-app-boundary.test.mjs",
    "test:public-routes": "node scripts/ci/public-route-inventory.test.mjs && node scripts/ci/public-route-parity.test.mjs",
    "test:path-hygiene": "node scripts/ci/path-hygiene.test.mjs",
    "test:workspace": "node scripts/ci/workspace-inventory.test.mjs",
    "test:workflows": "node scripts/ci/workflow-inventory.test.mjs",
    "test:security-review": "node scripts/ci/security-review.test.mjs",
    "test:public-copy": "pnpm --filter @anipotts/content build && node scripts/ci/public-copy-lint.test.mjs && node scripts/ci/public-copy-lint.mjs",
    "test:public-copy:policy": "node scripts/ci/public-copy-lint.test.mjs && node scripts/ci/public-copy-lint.mjs",
    "test:release-policy": "node scripts/ci/release-policy.test.mjs && node scripts/ci/migration-policy.mjs",
    "test:d1-bootstrap": "node scripts/ci/d1-ledger-bootstrap.test.mjs",
    "test:migration-local": "node scripts/ci/migration-local-proof.mjs",
    "test:site-migrations": "node scripts/ci/site-migrations-local-proof.mjs",
    "test:release-smoke": "node scripts/ci/release-smoke.test.mjs",
    "check:changed": "node scripts/ci/check-changed-scope.mjs",
    "release:protection:plan": "node scripts/ci/branch-protection.mjs",
    "test:ci-invariants": "pnpm test:workspace && pnpm test:deploy-targets && pnpm test:deployment-plan && pnpm test:admin-preview && pnpm test:portless-preview && pnpm test:brand && pnpm test:admin-solid-retirement && pnpm test:admin-routes && pnpm test:admin-fixture-boundary && pnpm test:public-boundary && pnpm test:public-routes && pnpm test:path-hygiene && pnpm test:content-platform && pnpm test:public-copy:policy && pnpm test:workflows && pnpm test:security-review && pnpm test:release-policy && pnpm test:d1-bootstrap && pnpm test:migration-local && pnpm test:site-migrations && pnpm test:release-smoke",
    "test:unit": "turbo test",
    "test": "pnpm test:unit",
    "validate": "pnpm test:ci-invariants && pnpm format:check && pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/www/**/*.{astro,ts,tsx}": [
      "prettier --write"
    ],
    "apps/admin/**/*.{astro,ts,tsx}": [
      "prettier --write"
    ],
    "workers/**/*.ts": [
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "scripts/**/*.mjs": [
      "prettier --write"
    ],
    "packages/**/*.mjs": [
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "minimatch@<4": "3.1.4",
      "minimatch@>=9": "9.0.7",
      "rollup@>=4 <4.59.0": "4.59.0",
      "flatted@<=3.4.1": "3.4.2",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4 <4.0.4": "4.0.4",
      "protobufjs@<7.5.5": "7.5.5",
      "fast-xml-builder@<1.1.7": "1.1.7"
    }
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "portless": "0.15.5",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0",
    "yaml": "2.8.2"
  }
}
