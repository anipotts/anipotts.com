---
import { Timestamp } from "@astryxdesign/core/Timestamp";
import AdminLayout from "../layouts/AdminLayout.astro";
import { SourceMark } from "../components/SourceMark";
import { OperatorWorkTable } from "../components/astryx/OperatorWorkTable";
import SemanticInspector from "../components/SemanticInspector.astro";
import {
  assertValidOperatorWorkProjection,
  groupOperatorTasks,
  readOperatorWorkProjection,
} from "../data/operator-work";
import {
  buildOperatorTaskSemanticReferences,
  semanticReferenceId,
  type SemanticReference,
} from "../data/semantic-reference";

if (!Astro.url.searchParams.has("view")) {
  return Astro.redirect("/work?view=now", 302);
}

const projection = readOperatorWorkProjection();
assertValidOperatorWorkProjection(projection);

const groups = groupOperatorTasks(projection);
const view = Astro.url.searchParams.get("view") ?? "now";
const allRows = (
  ["foreground", "background", "waiting", "recently_completed"] as const
).flatMap((lane) =>
  groups[lane].map((task) => ({
    ...task,
    lane,
    semantic_reference_id: semanticReferenceId(task.task_id, "task"),
    source_state:
      projection.mode === "tracked_fixture" || task.freshness !== "fresh"
        ? ("stale" as const)
        : ("verified" as const),
  })),
);
const visibleRows =
  view === "history"
    ? allRows.filter((task) => task.lane === "recently_completed")
    : view === "projects"
      ? [...allRows].sort((a, b) =>
          a.project_label.localeCompare(b.project_label),
        )
      : allRows;
const semanticReferences = projection.task_states.flatMap((task) =>
  Object.values(
    buildOperatorTaskSemanticReferences(
      task,
      task.freshness === "fresh" ? "verified" : "stale",
    ),
  ),
) as SemanticReference[];
---

<AdminLayout title="work" hideHeader>
  <main class="operator-page operator-work-page" data-work-now>
    <header class="operator-page-header">
      <h1 class="brand-display">
        {
          view === "projects"
            ? "Projects"
            : view === "history"
              ? "Work history"
              : visibleRows.some((task) => task.source_state === "verified")
                ? "Currently working"
                : "Last verified work"
        }
      </h1>
      <span>{visibleRows.length} visible</span>
    </header>

    <nav class="quiet-view-tabs" aria-label="work views">
      <a
        href="/work?view=now"
        aria-current={view === "now" ? "page" : undefined}
      >
        now
      </a>
      <a
        href="/work?view=projects"
        aria-current={view === "projects" ? "page" : undefined}
      >
        projects
      </a>
      <a
        href="/work?view=history"
        aria-current={view === "history" ? "page" : undefined}
      >
        history
      </a>
    </nav>

    <section class="operator-ledger" aria-label="current work">
      {
        visibleRows.length > 0 ? (
          <OperatorWorkTable rows={visibleRows} client:load />
        ) : (
          <p class="quiet-empty-state">Nothing here yet.</p>
        )
      }
    </section>

    <details class="operator-loose-sources">
      <summary>
        <span>loose conversations</span>
        <strong>{projection.source_states.length} preserved</strong>
      </summary>
      {
        projection.source_states.map((source) => (
          <div class="operator-loose-source">
            <SourceMark provider={source.provider} />
            <div>
              <strong>{source.canonical_title}</strong>
              <span>
                collapsed · observed{" "}
                <Timestamp
                  value={source.last_observed_at}
                  format="date_time"
                  isTimezoneShown
                  client:load
                />
              </span>
            </div>
            <code>{source.native_ref}</code>
          </div>
        ))
      }
    </details>

    <SemanticInspector references={semanticReferences} />
  </main>
</AdminLayout>
