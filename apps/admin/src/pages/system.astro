---
import { Timestamp } from "@astryxdesign/core/Timestamp";
import AdminLayout from "../layouts/AdminLayout.astro";
import SemanticInspector from "../components/SemanticInspector.astro";
import SemanticReference from "../components/SemanticReference.astro";
import { deployRows, handoffRows, mutationRows, repoRows } from "../data/admin";
import { countProofEntries, readProofEntries } from "../data/proof";
import { loadRuntimeOverlayResponse } from "../data/runtime";
import {
  internalRecordReference,
  type SemanticReference as SemanticReferenceModel,
} from "../data/semantic-reference";

const [proofEntries, runtime] = await Promise.all([
  readProofEntries(Astro.locals.runtime?.env.DB),
  loadRuntimeOverlayResponse(),
]);
const proofCounts = countProofEntries(proofEntries);
const destinations = [
  {
    href: "/fleet",
    title: "Fleet",
    fact: `${runtime.overlays.length} repository observations`,
  },
  {
    href: "/deploys",
    title: "Deploys",
    fact: `${deployRows.length} scoped targets`,
  },
  {
    href: "/repos",
    title: "Repositories",
    fact: `${repoRows.length} registered surfaces`,
  },
  {
    href: "/proof",
    title: "Proof",
    fact: `${proofCounts.pending} pending · ${proofCounts.blocked} blocked`,
  },
  {
    href: "/handoffs",
    title: "Handoffs",
    fact: `${handoffRows.length} current records`,
  },
  {
    href: "/mutations",
    title: "Gates",
    fact: `${mutationRows.length} controlled actions`,
  },
];
const destinationReferences = destinations.map((item) =>
  internalRecordReference({
    id: item.href,
    kind: "route",
    label: item.title,
    value: item.title,
    summary: item.fact,
    source: "admin system index",
    source_ref: item.href,
    checked_at: runtime.generated_at,
    source_state: runtime.available ? "verified" : "unknown",
  }),
);
---

<AdminLayout title="System" hideHeader>
  <main class="quiet-page quiet-system-page">
    <header class="quiet-page-header">
      <h1 class="brand-display">System</h1>
      <span>{runtime.available ? "current" : "source unavailable"}</span>
    </header>

    <section class="quiet-system-index" aria-label="System areas">
      {
        destinations.map((item, index) => (
          <article>
            <a href={item.href}>
              <strong>{item.title}</strong>
              <span>{item.fact}</span>
            </a>
            <SemanticReference
              reference={destinationReferences[index]!}
              variant="action"
              label="Details"
            />
          </article>
        ))
      }
    </section>

    <section
      class="quiet-system-timeline"
      aria-labelledby="system-status-heading"
    >
      <header>
        <h2 id="system-status-heading">Current status</h2>
        {
          runtime.generated_at ? (
            <Timestamp
              value={runtime.generated_at}
              format="date_time"
              isTimezoneShown
              client:load
            />
          ) : (
            <span>Not reconciled</span>
          )
        }
      </header>
      <div>
        <article>
          <span
            class={`quiet-state-dot ${runtime.available ? "is-working" : "is-unknown"}`}
          ></span>
          <div>
            <h3>Runtime feed</h3>
            <p>
              {
                runtime.available
                  ? "Current read-only observations are available."
                  : "No current runtime observation is available."
              }
            </p>
          </div>
        </article>
        <article>
          <span
            class={`quiet-state-dot ${proofCounts.blocked ? "is-blocked" : "is-working"}`}
          ></span>
          <div>
            <h3>Proof</h3>
            <p>
              {proofCounts.verified} verified, {proofCounts.pending} pending, {
                proofCounts.blocked
              } blocked.
            </p>
          </div>
        </article>
        <article>
          <span class="quiet-state-dot is-waiting"></span>
          <div>
            <h3>Production gates</h3>
            <p>
              Merge, deploy, migration, Access, and provider actions remain
              closed.
            </p>
          </div>
        </article>
      </div>
    </section>
    <SemanticInspector
      references={destinationReferences as SemanticReferenceModel[]}
    />
  </main>
</AdminLayout>
