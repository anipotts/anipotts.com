---
import { Banner } from "@astryxdesign/core/Banner";
import { Button } from "@astryxdesign/core/Button";
import AdminLayout from "../layouts/AdminLayout.astro";
import SemanticInspector from "../components/SemanticInspector.astro";
import SemanticReference from "../components/SemanticReference.astro";
import { readAdminKnowledge } from "../data/knowledge";
import {
  internalRecordReference,
  type SemanticReference as SemanticReferenceModel,
} from "../data/semantic-reference";

const knowledge = await readAdminKnowledge(Astro.locals.runtime?.env.DB);
const requestedKind = Astro.url.searchParams.get("kind") ?? "all";
const filters = [
  ["all", "all"],
  ["people", "people"],
  ["project", "projects"],
  ["decision", "decisions"],
  ["concept", "concepts"],
  ["place", "places"],
  ["system", "systems"],
] as const;
const normalizedKind = (kind: string) =>
  kind === "person" || kind === "people" ? "people" : kind;
const cards = knowledge.cards.filter(
  (card) =>
    requestedKind === "all" || normalizedKind(card.kind) === requestedKind,
);
const humanize = (value: string) => value.replaceAll("_", " ");
const displayTime = (value?: string | null) =>
  value
    ? new Intl.DateTimeFormat("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
      }).format(new Date(value))
    : "unknown";
const references = cards.map((card) =>
  internalRecordReference({
    id: card.card_id,
    kind: card.kind === "person" ? "person" : "graph_entity",
    label: card.title,
    value: card.title,
    summary: card.summary,
    source: card.source_system,
    source_ref: card.source_locator,
    checked_at: card.observed_at,
    source_state:
      card.freshness_state === "fresh"
        ? "verified"
        : card.freshness_state === "stale"
          ? "stale"
          : "unknown",
    sensitivity: card.sensitivity === "open" ? "internal" : "private",
    evidence_refs: card.proof_refs,
  }),
);
const referenceByCard = new Map(
  cards.map((card, index) => [card.card_id, references[index]!]),
);
---

<AdminLayout title="Knowledge" hideHeader>
  <main class="quiet-page quiet-knowledge-page">
    <header class="quiet-page-header">
      <h1 class="brand-display">Knowledge</h1>
      <span data-knowledge-count
        >{
          knowledge.available ? `${cards.length} results` : "Source unavailable"
        }</span
      >
    </header>

    <nav class="quiet-view-tabs" aria-label="Knowledge filters">
      {
        filters.map(([kind, label]) => (
          <a
            href={kind === "all" ? "/knowledge" : `/knowledge?kind=${kind}`}
            aria-current={requestedKind === kind ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>

    {
      !knowledge.available && (
        <aside class="quiet-inline-notice">
          <Banner
            status="warning"
            title="Knowledge unavailable"
            description="Your records could not be loaded. Try again when the source is available."
          />
          <Button
            label="Try again"
            href={`${Astro.url.pathname}${Astro.url.search}`}
            size="sm"
          />
        </aside>
      )
    }
    <section class="quiet-result-list" aria-label="Knowledge results">
      {
        cards.map((card) => {
          return (
            <article
              class="quiet-result-row"
              data-knowledge-card
              id={`card-${card.card_id}`}
            >
              <div class="quiet-result-kind">
                <span>{humanize(card.kind)}</span>
                <small>{card.source_system}</small>
              </div>
              <div class="quiet-result-copy">
                <h2>{card.title}</h2>
                <p>{card.summary}</p>
              </div>
              <div class="quiet-result-freshness">
                <span>{humanize(card.freshness_state)}</span>
                <time datetime={card.observed_at ?? undefined}>
                  {displayTime(card.observed_at)}
                </time>
              </div>
              <SemanticReference
                reference={referenceByCard.get(card.card_id)!}
                variant="action"
                label="Details"
                class="quiet-row-link"
              />
            </article>
          );
        })
      }
      <p
        class="quiet-empty-state"
        hidden={cards.length > 0 || !knowledge.available}
      >
        No current result matches.
      </p>
    </section>

    <SemanticInspector references={references as SemanticReferenceModel[]} />
  </main>

  <script is:inline>
    (() => {
      const cardId = new URLSearchParams(location.search).get("card");
      if (cardId) {
        document
          .querySelector(`#card-${CSS.escape(cardId)}`)
          ?.scrollIntoView({ block: "center" });
      }
    })();
  </script>
</AdminLayout>
