---
import AdminDocument from "../layouts/AdminDocument.astro";
import { AdminWordmark } from "../components/astryx/AdminWordmark";
import { editorialReturnPath } from "../lib/editorial-return-path";
import { isDevLoopbackPreviewRequest } from "../lib/admin-access-policy";

const destination = editorialReturnPath(Astro.url.searchParams.get("next"));
const localPreview = isDevLoopbackPreviewRequest({
  isDev: import.meta.env.DEV,
  method: "GET",
  url: new URL(destination, Astro.url),
});
---

<AdminDocument title="Sign in" shell={false}>
  <main class="admin-standalone" aria-label="Sign in">
    <AdminWordmark
      href={destination}
      label={localPreview ? "Open preview" : "Sign in"}
      className="sign-in"
    />
  </main>
</AdminDocument>

<style>
  /* The wordmark renders from React, outside Astro's scoped classes. */
  :global(.sign-in) {
    font-size: clamp(2.5rem, 12vw, 4.5rem);
    min-height: var(--spacing-11);
    padding-inline: var(--spacing-2);
    margin-inline: calc(-1 * var(--spacing-2));
    border-radius: var(--radius-element);
    text-decoration: none;
  }
  /* Keyboard focus tints the surface; admin draws no rings. */
  :global(.sign-in:focus-visible) {
    background-color: var(--color-accent-muted);
  }
  :global(.sign-in:active) {
    color: var(--color-accent);
  }
</style>
