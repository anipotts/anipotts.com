---
import "@fontsource-variable/instrument-sans";
import "@astryxdesign/core/reset.css";
import "@astryxdesign/core/astryx.css";
import "../themes/editorial.generated.css";
import "../styles/scrollbars.css";
import BrandMark from "@anipotts/brand/BrandMark.astro";
import { editorialReturnPath } from "../lib/editorial-return-path";
import { isDevLoopbackPreviewRequest } from "../lib/admin-access-policy";

const destination = editorialReturnPath(Astro.url.searchParams.get("next"));
const localPreview = isDevLoopbackPreviewRequest({
  isDev: import.meta.env.DEV,
  method: "GET",
  url: new URL(destination, Astro.url),
});
---

<!doctype html>
<html lang="en" data-astryx-theme="editorial">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>sign in | admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main aria-label="Sign in">
      <a
        class="sign-in wordmark"
        href={destination}
        aria-label={localPreview ? "open preview" : "sign in"}
        title={localPreview ? "open preview" : "sign in"}
      >
        <BrandMark />
      </a>
    </main>
  </body>
</html>

<style>
  :global(html) {
    color-scheme: light dark;
    background: var(--color-background-body);
    font-family: var(--font-family-body);
  }
  :global(body) {
    margin: 0;
  }
  main {
    box-sizing: border-box;
  }
  .sign-in:focus-visible {
    outline: var(--focus-outline-width) var(--focus-outline-style)
      var(--focus-outline-color);
    outline-offset: var(--focus-outline-offset);
  }
  main {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: var(--spacing-8);
  }

  .sign-in {
    display: block;
    width: calc(var(--spacing-8) * 4);
    height: calc(var(--spacing-8) * 4);
    color: var(--color-text-primary);
    text-decoration: none;
    border-radius: var(--radius-container);
  }

  .sign-in:active {
    color: var(--color-accent);
  }
</style>
