---
import "@fontsource-variable/instrument-sans";
import "../styles/scrollbars.css";
import BrandMark from "@anipotts/brand/BrandMark.astro";
import { editorialReturnPath } from "../lib/editorial-return-path";
import { isDevLoopbackPreviewRequest } from "../lib/admin-access-policy";

const destination = editorialReturnPath(Astro.url.searchParams.get("next"));
const localPreview = isDevLoopbackPreviewRequest({
  isDev: import.meta.env.DEV,
  method: "GET",
  url: new URL(destination, Astro.url),
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>sign in | admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main aria-label="sign in">
      <a
        class="sign-in wordmark"
        href={destination}
        aria-label={localPreview ? "open preview" : "sign in"}
        title={localPreview ? "open preview" : "sign in"}
      >
        <BrandMark />
      </a>
    </main>
  </body>
</html>

<style>
  :global(html) {
    color-scheme: light dark;
    --paper: #f7f9fc;
    --ink: #182334;
    --accent: #175ea8;
    background: var(--paper);
    font-family: "Instrument Sans Variable", sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :global(html) {
      --paper: #0b111a;
      --ink: #edf3fd;
      --accent: #8abfff;
    }
  }
  :global(body) {
    margin: 0;
  }
  main {
    box-sizing: border-box;
  }
  .sign-in:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  main {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 2rem;
  }

  .sign-in {
    display: block;
    width: 8rem;
    height: 8rem;
    color: var(--ink);
    text-decoration: none;
    border-radius: 1rem;
  }

  .sign-in:active {
    color: var(--accent);
  }
</style>
