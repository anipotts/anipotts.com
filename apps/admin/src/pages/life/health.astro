---
import { LifeSupportingView } from "../../components/life/LifeSupportingView";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { readAdminKnowledge } from "../../data/knowledge";
import { measureServerTiming, serverTimingD1 } from "../../lib/server-timing";

const knowledge = await measureServerTiming(Astro.locals, "life", () =>
  readAdminKnowledge(
    serverTimingD1(Astro.locals, Astro.locals.runtime?.env.DB),
    "health vitals",
    { domain: "life", limit: 4 },
  ),
);
const healthCards = knowledge.bundle.cards.filter(
  (card) =>
    card.entity_ref.includes("health") ||
    card.title.toLowerCase().includes("health") ||
    card.summary.toLowerCase().includes("vital"),
);
// This view does not infer tasks, diagnose, or expose raw readings.
Astro.response.headers.set("Cache-Control", "private, no-store");
---

<AdminLayout title="Health" hideHeader>
  <LifeSupportingView
    section="health"
    summaries={healthCards}
    available={knowledge.available}
    client:load
  />
</AdminLayout>
