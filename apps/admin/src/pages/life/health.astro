---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { readAdminKnowledge } from "../../data/knowledge";

const knowledge = await readAdminKnowledge(
  Astro.locals.runtime?.env.DB,
  "health vitals",
  { domain: "life", limit: 4 },
);
const healthCards = knowledge.bundle.cards.filter(
  (card) =>
    card.entity_ref.includes("health") ||
    card.title.toLowerCase().includes("health") ||
    card.summary.toLowerCase().includes("vital"),
);
---

<AdminLayout
  title="Health"
  deck="Status-only health visibility. This page does not infer tasks, diagnose, or expose raw readings."
>
  <section class="meta-strip" aria-label="Health boundary">
    <span>Status only</span>
    <span>{healthCards.length} source pointers</span>
    <span>No inferred tasks</span>
    <span>No raw vitals</span>
  </section>

  <section class="table-card life-boundary">
    <div class="section-head">
      <div>
        <p>privacy boundary</p>
        <h2>Health source state</h2>
      </div>
      <span>Read only</span>
    </div>
    <div class="life-reference-list">
      {
        healthCards.length === 0 ? (
          <article>
            <div>
              <p>unavailable</p>
              <h3>No sanitized health pointer is visible</h3>
            </div>
            <span>Verify the private source locally before asking Ani.</span>
          </article>
        ) : (
          healthCards.map((card) => (
            <article>
              <div>
                <p>
                  {card.freshness_state} / {card.reveal_policy}
                </p>
                <h3>{card.title}</h3>
              </div>
              <span>{card.summary}</span>
              <code>{card.source_locator}</code>
            </article>
          ))
        )
      }
    </div>
  </section>
</AdminLayout>
