---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { LifeWorkspace } from "../../components/life/LifeWorkspace";
import { PrivateDataWorkspace } from "../../components/life/PrivateDataWorkspace";
import { readPersonalContext } from "../../data/personal-context";
import { measureServerTiming } from "../../lib/server-timing";
// Off unless exactly "true". Off keeps the existing Life owner reader path.
const privateReader =
  Astro.locals.runtime?.env?.PRIVATE_READER_ENABLED === "true";
const result = privateReader
  ? null
  : await measureServerTiming(Astro.locals, "life", () =>
      readPersonalContext({ method: "status" }),
    );
Astro.response.headers.set("Cache-Control", "private, no-store");
---

<AdminLayout title="Data" hideHeader
  >{
    result ? (
      <LifeWorkspace section="overview" result={result} client:load />
    ) : (
      <PrivateDataWorkspace client:load />
    )
  }</AdminLayout
>
