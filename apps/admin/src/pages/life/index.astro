---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { LifeWorkspace } from "../../components/life/LifeWorkspace";
import { readPersonalContext } from "../../data/personal-context";
import { measureServerTiming } from "../../lib/server-timing";
const result = await measureServerTiming(Astro.locals, "life", () =>
  readPersonalContext({ method: "status" }),
);
Astro.response.headers.set("Cache-Control", "private, no-store");
---

<AdminLayout title="Life" hideHeader
  ><LifeWorkspace section="overview" result={result} client:load /></AdminLayout
>
