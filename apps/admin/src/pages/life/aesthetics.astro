---
import AdminLayout from "../../layouts/AdminLayout.astro";

const futureAreas = [
  "wardrobe",
  "outfits",
  "looks",
  "references",
  "personal style",
];
---

<AdminLayout
  title="Aesthetics"
  deck="A clean personal-style boundary. No wardrobe automation or image ingestion is active."
>
  <section class="meta-strip" aria-label="Aesthetics boundary">
    <span>Shell only</span>
    <span>No ingestion</span>
    <span>No automation</span>
    <span>Global Inbox for future actions</span>
  </section>

  <section class="aesthetics-canvas">
    <div>
      <p>life / aesthetics</p>
      <h2>Space reserved for a personal visual language</h2>
      <span>
        This page establishes a predictable home without inventing data or
        workflows before the source model is reviewed.
      </span>
    </div>
    <ul aria-label="Future aesthetics areas">
      {futureAreas.map((area) => <li>{area}</li>)}
    </ul>
  </section>
</AdminLayout>
