---
import EditorialLayout from "../../layouts/EditorialLayout.astro";
import { loadEditorialInventory } from "../../lib/editorial-inventory-server";
const inventoryProjection = await loadEditorialInventory(
  Astro.locals.runtime?.env,
);
---

<EditorialLayout
  inventoryProjection={inventoryProjection}
  title="Content"
  groups={inventoryProjection.groups}
  selectedGroup={Astro.url.searchParams.get("group") ?? "pages"}
/>
