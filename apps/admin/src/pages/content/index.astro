---
import EditorialLayout from "../../layouts/EditorialLayout.astro";
import { editorialInventory, recordUpdate } from "../../lib/editorial-content";
import { productionEditor } from "../../lib/editorial-server";
import { privateWritingRecords } from "../../lib/writing-inventory";
const { pages, projects, writing } = await editorialInventory();
let privateRecords: import("../../components/astryx/EditorialApp").CatalogRecord[] =
  [];
let inventoryError = false;
try {
  const storage = import.meta.env.DEV
    ? await (await import("../../lib/editorial-local")).localDraftStorage()
    : productionEditor(Astro.locals.runtime?.env)?.storage;
  if (!storage) throw new Error("storage_unavailable");
  privateRecords = privateWritingRecords(
    await storage.listWritingDrafts(),
  ).filter(
    (record) =>
      !writing.some((item) => record.href === `/content/writing/${item.id}`),
  );
} catch {
  inventoryError = true;
}
const sections = {
  home: "home",
  projects: "work",
  workPage: "work",
  writing: "writing",
  writingPage: "writing",
  systemsPage: "systems",
  newsletterPage: "newsletter",
} as const;
const groups = [
  {
    name: "pages",
    href: "/content?group=pages",
    records: [
      ...privateRecords,
      ...[...pages, ...projects, ...writing].map((item) => ({
        section: sections[item.collection],
        title: "title" in item.data ? item.data.title : item.id,
        status:
          item.collection === "projects"
            ? item.data.public_state
            : item.collection === "writing" ||
                item.collection === "newsletterPage"
              ? item.data.status
              : "published",
        href: `/content/${item.collection}/${encodeURIComponent(item.id)}`,
        updated: recordUpdate(item.collection, item.id),
      })),
    ],
  },
  {
    name: "work",
    href: "/content?group=work",
    records: projects.map((item) => ({
      title: item.data.title,
      status: item.data.public_state,
      href: `/content/${item.collection}/${encodeURIComponent(item.id)}`,
      updated: recordUpdate(item.collection, item.id),
    })),
  },
  {
    name: "writing",
    href: "/content?group=writing",
    records: [
      ...privateRecords,
      ...writing.map((item) => ({
        title: item.data.title,
        status: item.data.status,
        href: `/content/${item.collection}/${encodeURIComponent(item.id)}`,
        updated: recordUpdate(item.collection, item.id),
      })),
    ],
  },
  {
    name: "systems",
    href: "/content?group=systems",
    records: pages
      .filter((item) => item.collection === "systemsPage")
      .map((item) => ({
        title: "systems",
        status: "published",
        href: `/content/${item.collection}/${encodeURIComponent(item.id)}`,
        updated: recordUpdate(item.collection, item.id),
      })),
  },
];
---

<EditorialLayout
  inventoryError={inventoryError}
  title="content"
  groups={groups}
  selectedGroup={Astro.url.searchParams.get("group") ?? "pages"}
/>
