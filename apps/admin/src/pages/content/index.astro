---
import {
  libraryStateUrl,
  readLibraryState,
} from "../../lib/content-library-state";
// Retired: the mixed Content overview. `/` is the one overview, and the old
// `?group=` links land on their library route with their filters kept.
return Astro.redirect(
  libraryStateUrl(
    "/content",
    Astro.url.search,
    readLibraryState(Astro.url.search),
  ),
  308,
);
---
