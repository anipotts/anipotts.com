---
import AdminLayout from "../../layouts/AdminLayout.astro";
import {
  carouselPosts,
  carouselSeries,
  carouselSummary,
} from "../../data/carousels";

const reviewGates = [
  "final post order",
  "caption and hashtag approval",
  "sound choice",
  "posting or scheduling",
];
---

<AdminLayout
  title="Carousels"
  deck="Owner review for prepared carousel sets. Read-only assets, crops, captions, and render state."
>
  <section class="meta-strip" aria-label="Carousel feed state">
    <span>{carouselSeries.status}</span>
    <span>{carouselSummary.posts} posts</span>
    <span>{carouselSummary.slides} slides</span>
    <span>{carouselSummary.platformExports} platform exports</span>
    <span>{carouselSummary.staleExports} stale exports</span>
    <span>{carouselSummary.soundApprovalsNeeded} sound approvals</span>
    <span>{carouselSeries.generatedAt}</span>
  </section>

  <section class="table-card carousel-brief">
    <div class="section-head">
      <div>
        <p>durable agent workflows v2</p>
        <h2>Review, do not publish</h2>
      </div>
      <span
        >instagram {carouselSeries.cropTargets.instagram} / tiktok {
          carouselSeries.cropTargets.tiktok
        }</span
      >
    </div>
    <div class="carousel-brief-body">
      <div>
        <p>
          This page mirrors the media handoff into admin so the carousel packet
          can be inspected beside site content. It does not upload, schedule,
          post, edit source photos, or mutate the media workspace.
        </p>
      </div>
      <dl>
        <div>
          <dt>Source</dt>
          <dd>media/carousel handoff 2026-07-01</dd>
        </div>
        <div>
          <dt>Local editor</dt>
          <dd>{carouselSeries.localEditorUrl || "not linked in production"}</dd>
        </div>
        <div>
          <dt>Assets copied</dt>
          <dd>phone mocks, contact strips, 1080 platform exports</dd>
        </div>
        <div>
          <dt>Not copied</dt>
          <dd>raw photos, highres sources, 2x masters</dd>
        </div>
      </dl>
      <div class="gate-list" aria-label="Approval gates">
        {reviewGates.map((gate) => <span>{gate}</span>)}
      </div>
    </div>
  </section>

  <section class="carousel-post-grid" aria-label="Carousel posts">
    {
      carouselPosts.map((post) => (
        <article class="carousel-post-card">
          {post.phoneMockInstagram && (
            <img
              src={post.phoneMockInstagram}
              alt={`${post.title} instagram phone mock`}
              loading="lazy"
            />
          )}
          <div>
            <p>
              post {post.index} / {post.status}
            </p>
            <h2>{post.title}</h2>
            <dl>
              <div>
                <dt>Slides</dt>
                <dd>{post.slideCount}</dd>
              </div>
              <div>
                <dt>Ready exports</dt>
                <dd>{post.readyExports}</dd>
              </div>
              <div>
                <dt>Stale</dt>
                <dd>{post.staleCount}</dd>
              </div>
              <div>
                <dt>Sound</dt>
                <dd>{post.soundStatus}</dd>
              </div>
            </dl>
          </div>
        </article>
      ))
    }
  </section>

  {
    carouselPosts.map((post) => (
      <section class="table-card carousel-detail" id={post.id}>
        <div class="section-head">
          <div>
            <p>
              post {post.index} / {post.status}
            </p>
            <h2>{post.title}</h2>
          </div>
          <span>
            {post.slideCount} slides / {post.readyExports} ready exports
          </span>
        </div>

        <div class="carousel-review-grid">
          <div class="carousel-copy-panel">
            <span>Caption</span>
            <p>{post.caption}</p>
            <div class="hashtag-list" aria-label={`${post.title} hashtags`}>
              {post.hashtags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </div>
          <div class="carousel-contact-panel">
            {post.contactInstagram && (
              <figure>
                <img
                  src={post.contactInstagram}
                  alt={`${post.title} instagram contact strip`}
                  loading="lazy"
                />
                <figcaption>instagram contact strip</figcaption>
              </figure>
            )}
            {post.contactTiktok && (
              <figure>
                <img
                  src={post.contactTiktok}
                  alt={`${post.title} tiktok contact strip`}
                  loading="lazy"
                />
                <figcaption>tiktok contact strip</figcaption>
              </figure>
            )}
          </div>
        </div>

        <div class="carousel-slide-list" aria-label={`${post.title} slides`}>
          {post.slides.map((slide) => (
            <article class="carousel-slide-card">
              <div class="carousel-slide-copy">
                <p>
                  slide {slide.number} / {slide.goal}
                </p>
                <h3>{slide.text}</h3>
                <dl>
                  <div>
                    <dt>Visual</dt>
                    <dd>{slide.visualId}</dd>
                  </div>
                  <div>
                    <dt>Source</dt>
                    <dd>
                      {slide.sourceStatus} / {slide.sourceSize}
                    </dd>
                  </div>
                  <div>
                    <dt>IG</dt>
                    <dd>
                      {slide.instagram.freshness} / {slide.instagram.size}
                    </dd>
                  </div>
                  <div>
                    <dt>TT</dt>
                    <dd>
                      {slide.tiktok.freshness} / {slide.tiktok.size}
                    </dd>
                  </div>
                </dl>
              </div>
              <div class="carousel-shot-grid">
                {slide.instagram.image && (
                  <figure class="carousel-shot instagram-shot">
                    <img
                      src={slide.instagram.image}
                      alt={`${post.title} slide ${slide.number} instagram export`}
                      loading="lazy"
                    />
                    <figcaption>
                      instagram / {slide.instagram.renderedAt}
                    </figcaption>
                  </figure>
                )}
                {slide.tiktok.image && (
                  <figure class="carousel-shot tiktok-shot">
                    <img
                      src={slide.tiktok.image}
                      alt={`${post.title} slide ${slide.number} tiktok export`}
                      loading="lazy"
                    />
                    <figcaption>tiktok / {slide.tiktok.renderedAt}</figcaption>
                  </figure>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))
  }
</AdminLayout>
