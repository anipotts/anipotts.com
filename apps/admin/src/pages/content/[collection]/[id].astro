---
import { inventoryIdentity } from "../../../lib/editorial-inventory-projection";
import { readEditorialSnapshot } from "../../../lib/editorial-snapshot-read";
import { render } from "astro:content";
import EditorialLayout from "../../../layouts/EditorialLayout.astro";
import {
  editorialInventory,
  publicSiteUrl,
  recordUpdate,
} from "../../../lib/editorial-content";
import type { Review } from "../../../components/astryx/EditorialApp";
import {
  editorialRecordSchema,
  parseEditorialSource,
} from "@anipotts/content/editorial/source";
import { productionEditor } from "../../../lib/editorial-server";
import { libraryPath } from "../../../lib/content-library-state";
import { startServerTiming } from "../../../lib/server-timing";
const stopRecordTiming = startServerTiming(Astro.locals, "record");
const inventory = await editorialInventory();
const entry = [
  ...inventory.pages,
  ...inventory.projects,
  ...inventory.writing,
].find(
  (item) =>
    item.collection === Astro.params.collection && item.id === Astro.params.id,
);
let privateUnavailable = false;
let privateDraft: import("../../../editorial/draft-store").Draft | null = null;
const privateIdentity = editorialRecordSchema.safeParse({
  kind:
    Astro.params.collection === "projects" ? "work" : Astro.params.collection,
  id: Astro.params.id,
});
if (
  !entry &&
  privateIdentity.success &&
  ["writing", "work"].includes(privateIdentity.data.kind)
) {
  const snapshot = await readEditorialSnapshot(async () => {
    const storage = import.meta.env.DEV
      ? await (await import("../../../lib/editorial-local")).localDraftStorage()
      : productionEditor(Astro.locals.runtime?.env)?.storage;
    if (!storage) throw new Error("storage_unavailable");
    return storage.get(privateIdentity.data);
  });
  privateUnavailable = snapshot.status === "unavailable";
  privateDraft = snapshot.status === "found" ? snapshot.draft : null;
}
if (!entry && !privateDraft)
  Astro.response.status = privateUnavailable ? 503 : 404;
let privateTitle =
  Astro.params.collection === "projects"
    ? "Untitled project"
    : "Untitled article";
if (privateDraft) {
  try {
    privateTitle = String(
      parseEditorialSource(privateDraft.source).document.get("title") ||
        privateTitle,
    );
  } catch {}
}
const title =
  entry && "title" in entry.data
    ? entry.data.title
    : privateDraft
      ? privateTitle
      : (entry?.id ??
        (privateUnavailable ? "Record unavailable" : "Record not found"));
const editorRecord = entry
  ? (inventoryIdentity(entry) ?? undefined)
  : privateDraft && privateIdentity.success
    ? privateIdentity.data
    : undefined;
// An editable record opens its editor, which reads the record itself; the
// rendered article and review props are only for read-only records.
const rendered = entry && !editorRecord ? await render(entry) : null;
stopRecordTiming();
const Content = rendered?.Content;
const project = entry?.collection === "projects" ? entry.data : null;
const writing = entry?.collection === "writing" ? entry.data : null;
const publicPath =
  entry && project && project.public_state !== "hidden"
    ? `/work/${project.slug ?? entry.id}`
    : entry && writing?.status === "published"
      ? `/writing/${writing.slug ?? entry.id}`
      : entry &&
          ["home", "workPage", "writingPage", "systemsPage"].includes(
            entry.collection,
          )
        ? entry.collection === "home"
          ? "/"
          : `/${entry.id}`
        : null;
// The library the URL names, so a missing record still selects it in the
// sidebar and its way back leads there.
const library =
  Astro.params.collection === "projects"
    ? "work"
    : Astro.params.collection === "writing"
      ? "writing"
      : "website";
const review: Review | undefined =
  entry && !editorRecord
    ? {
        updated: recordUpdate(entry.collection, entry.id),
        back: libraryPath(library),
        status:
          project?.public_state ??
          writing?.status ??
          (entry.collection === "newsletterPage"
            ? entry.data.status
            : "published"),
        publicUrl: publicPath ? new URL(publicPath, publicSiteUrl).href : null,
        metadata: project ? [project.role, project.year] : [],
        summary: project?.description ?? writing?.summary,
        media: project?.preview_media
          ? {
              ...project.preview_media,
              src: new URL(project.preview_media.src, publicSiteUrl).href,
            }
          : null,
        sections: project?.story.map((section) => ({
          heading: section.title,
          paragraphs: section.paragraphs,
        })),
        fields: project
          ? {
              subtitle: project.subtitle,
              card_copy: project.card_copy,
              duration: project.duration,
              status: project.status,
              live: project.link_live,
              repository: project.link_repo,
              tags: project.tags,
              technical: project.technical,
              roadmap: project.roadmap,
            }
          : writing
            ? {
                published: writing.published_at,
                scheduled: writing.scheduled_at,
                tags: writing.tags,
                type: writing.content_type,
                series: writing.series_type,
                project: writing.project,
                artifact: writing.artifact_url,
              }
            : undefined,
        contentFields: !project && !writing ? entry.data : undefined,
      }
    : undefined;
---

<EditorialLayout
  selectedGroup={library}
  hasContent={Boolean(Content)}
  inventoryError={privateUnavailable}
  title={title}
  review={review}
  editHome={entry?.collection === "home"}
  editorRecord={editorRecord}
>
  {Content && <Content />}
</EditorialLayout>
