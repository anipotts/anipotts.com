---
import { getCollection } from "astro:content";
import EditorialLayout from "../layouts/EditorialLayout.astro";
import { recordUpdate } from "../lib/editorial-content";
const drafts = await getCollection("newsletterDrafts");
const groups = [
  {
    name: "drafts",
    href: "/newsletter",
    records: drafts.map(({ data, id }) => ({
      title: data.title,
      summary: data.summary,
      status: data.status,
      href: `/newsletter/${data.slug}`,
      updated: recordUpdate("newsletterDrafts", id),
    })),
  },
];
---

<EditorialLayout title="Newsletter" groups={groups} />
