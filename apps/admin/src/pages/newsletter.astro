---
import {
  libraryStateUrl,
  readLibraryState,
} from "../lib/content-library-state";
// Retired: the Newsletter library moved to /content/newsletter. Draft editor
// URLs under /newsletter/ stay where they are.
return Astro.redirect(
  libraryStateUrl(
    "/newsletter",
    Astro.url.search,
    readLibraryState(Astro.url.search),
  ),
  308,
);
---
