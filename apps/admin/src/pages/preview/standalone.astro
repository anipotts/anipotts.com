---
import AdminDocument from "../../layouts/AdminDocument.astro";
import { standalonePreviewFrameUrl } from "../../lib/preview-html";
import { privateJson } from "../../lib/editorial-security";

const frame = standalonePreviewFrameUrl(Astro.url);
if (!frame) return privateJson({ error: "invalid_preview" }, 400);
---

<AdminDocument title="Draft preview">
  <iframe
    src={frame.pathname + frame.search}
    title="Saved draft preview"
    sandbox="allow-scripts"
    referrerpolicy="no-referrer"
    style="width:100%;height:100dvh;border:0;display:block"></iframe>
</AdminDocument>
