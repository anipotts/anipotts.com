---
import { readEditorialPreviewSource } from "../../lib/editorial-preview-source";
import { runtimeEnv } from "../../lib/runtime-env";
import { applyEditorialPreviewContext } from "../../lib/editorial-preview-context";
applyEditorialPreviewContext(Astro.locals);
import { publicContentContext } from "../../../../www/src/lib/published-runtime";
const context = publicContentContext(Astro.locals);
import HomePage from "../../../../www/src/components/HomePage.astro";
import { homepageSchema } from "@anipotts/content/public/pages";
import { parseEditorialSource } from "@anipotts/content/editorial/source";
import {
  publishedWriting,
  visibleProjects,
} from "../../../../www/src/lib/content";
import { productionEditor } from "../../lib/editorial-server";
import { previewFailure } from "../../lib/preview-status";
const record = { kind: "page", id: "home" } as const;
const snapshot = await readEditorialPreviewSource(Astro.url, {
  draft: async () => {
    const editor = productionEditor(runtimeEnv());
    if (!editor) throw new Error("storage_unavailable");
    return editor.storage.get(record);
  },
  baseline: async () => {
    const editor = productionEditor(runtimeEnv());
    if (!editor) throw new Error("storage_unavailable");
    return editor.readBase(record);
  },
});
if (snapshot.status !== "found")
  return previewFailure(
    Astro.url,
    snapshot.status,
    snapshot.status === "stale" ? 409 : 503,
  );
let home;
try {
  home = homepageSchema.parse(parseEditorialSource(snapshot.source).data);
} catch {
  return previewFailure(Astro.url, "invalid-source", 409);
}
---

<HomePage
  cmsHome={home}
  allWork={await visibleProjects(context)}
  allWriting={await publishedWriting(context)}
  preview
/>

<script is:inline>
  // The editor's frame trusts a status and a size only from this exact
  // navigation, the same handshake the record preview makes.
  const request =
    new URL(location.href).searchParams.get("previewRequest") ?? "";
  parent.postMessage(
    { type: "editorial-preview-status", request, status: "ready" },
    "*",
  );
  let queued = false;
  const reportSize = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      parent.postMessage(
        {
          type: "editorial-preview-size",
          request,
          height: Math.ceil(document.body.getBoundingClientRect().height),
        },
        "*",
      );
    });
  };
  new ResizeObserver(reportSize).observe(document.body);
  window.addEventListener("load", reportSize);
  reportSize();
</script>
