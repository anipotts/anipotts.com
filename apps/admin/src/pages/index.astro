---
import { runtimeEnv } from "../lib/runtime-env";
import AdminLayout from "../layouts/AdminLayout.astro";
import { PrivateShell } from "../components/data/PrivateShell";
import { recentlyUpdated } from "../components/astryx/ContentLibrary";
import { loadEditorialInventory } from "../lib/editorial-inventory-server";
import { privateShellFlags } from "../lib/private-reader-credential";
import { measureServerTiming } from "../lib/server-timing";
import { loadShellFixtures } from "../lib/shell-fixtures";

// The one overview. Content is read here from the editorial inventory; ops
// and Data are read in the browser, each behind its own gate. The shell also
// draws Data, so a record opened from here keeps the private session.
const inventory = await measureServerTiming(Astro.locals, "inventory", () =>
  loadEditorialInventory(runtimeEnv()),
);
const content = recentlyUpdated(inventory.records)
  .slice(0, 5)
  .map(
    ({
      title,
      href,
      status,
      collection,
      section,
      changesPending,
      updated,
    }) => ({
      title,
      href,
      status,
      collection,
      section,
      changesPending,
      updated,
    }),
  );
const env = runtimeEnv();
// Development shows System's snapshot sample, a synthetic events page and a
// synthetic Data set (lib/shell-fixtures.ts); none ships.
const fixtures = await loadShellFixtures(Astro.url);
Astro.response.headers.set("Cache-Control", "private, no-store");
---

<AdminLayout title="Overview" searchEntries={inventory.searchEntries}>
  <PrivateShell
    initialPath="/"
    content={content}
    {...privateShellFlags(env)}
    dataFixture={fixtures?.data}
    fixture={fixtures?.snapshot}
    eventsFixture={fixtures?.events}
    fixtureOrigin={fixtures && {
      replay: fixtures.replay,
      frozen: fixtures.frozen,
      capturedAt: fixtures.capturedAt,
      payloads: fixtures.payloads,
    }}
    renderedAt={Date.now()}
    client:load
  />
</AdminLayout>
