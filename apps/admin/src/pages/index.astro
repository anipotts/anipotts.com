---
import AdminLayout from "../layouts/AdminLayout.astro";
import { PrivateShell } from "../components/data/PrivateShell";
import { recentlyUpdated } from "../components/astryx/ContentLibrary";
import { loadDataExtras } from "../lib/data-extras";
import { loadEditorialInventory } from "../lib/editorial-inventory-server";
import { privateReaderOpsEnabled } from "../lib/private-reader-credential";
import { measureServerTiming } from "../lib/server-timing";

// The one overview. Content is read here from the editorial inventory; ops
// and Data are read in the browser, each behind its own gate. The shell also
// draws Data, so a record opened from here keeps the private session.
const inventory = await measureServerTiming(Astro.locals, "inventory", () =>
  loadEditorialInventory(Astro.locals.runtime?.env),
);
const content = recentlyUpdated(inventory.records)
  .slice(0, 5)
  .map(
    ({
      title,
      href,
      status,
      collection,
      section,
      changesPending,
      updated,
    }) => ({
      title,
      href,
      status,
      collection,
      section,
      changesPending,
      updated,
    }),
  );
const env = Astro.locals.runtime?.env ?? {};

// Development uses System's snapshot sample, a synthetic events page and a
// synthetic Data set by default; `?fixture=none` shows the real local states.
// `import.meta.env.DEV` is false in builds, so no fixture ships.
const sample =
  import.meta.env.DEV && Astro.url.searchParams.get("fixture") !== "none";
const fixtures = sample
  ? {
      snapshot: (await import("../fixtures/ops_v1.sample.json")).default,
      events: (await import("../fixtures/ops_events_v1.synthetic.json"))
        .default,
      data: (await import("../fixtures/data_v1.synthetic.json")).default,
    }
  : undefined;
const extras = sample ? undefined : await loadDataExtras(env.DB);
Astro.response.headers.set("Cache-Control", "private, no-store");
---

<AdminLayout title="Overview" hideHeader>
  <PrivateShell
    initialPath="/"
    content={content}
    dataEnabled={env.PRIVATE_READER_ENABLED === "true"}
    dataFixture={fixtures?.data}
    extras={extras}
    enabled={privateReaderOpsEnabled(env)}
    fixture={fixtures?.snapshot}
    eventsFixture={fixtures?.events}
    renderedAt={Date.now()}
    client:load
  />
</AdminLayout>
