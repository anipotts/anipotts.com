---
import { getCollection } from "astro:content";
import EditorialLayout from "../../layouts/EditorialLayout.astro";
import { recordUpdate } from "../../lib/editorial-content";
import type { Review } from "../../components/astryx/EditorialApp";
const entry = (await getCollection("newsletterDrafts")).find(
  (item) => item.data.slug === Astro.params.slug,
);
const draft = entry?.data;
if (!draft) Astro.response.status = 404;
const review: Review | undefined = draft
  ? {
      back: "/newsletter",
      updated: entry ? recordUpdate("newsletterDrafts", entry.id) : undefined,
      status: draft.status,
      metadata: draft.subject === draft.title ? [] : [draft.subject],
      summary: draft.dek,
      sections: [
        { heading: "", paragraphs: [draft.hook.body] },
        ...draft.sections.map((section) => ({
          heading: section.heading ?? section.label ?? "",
          paragraphs: [section.body],
          items: section.items,
        })),
        { heading: "", paragraphs: [draft.close.body, draft.close.cta] },
      ],
      claims: draft.claims,
      sources: draft.source_refs,
      fields: {
        audience: draft.audience,
        outline: draft.spine,
        thread: draft.x_thread_beats,
        notes: draft.preview_notes,
      },
    }
  : undefined;
---

<EditorialLayout title={draft?.title ?? "draft not found"} review={review} />
