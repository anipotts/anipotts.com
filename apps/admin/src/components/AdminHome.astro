---
import AdminLayout from "../layouts/AdminLayout.astro";
import { SourceMark } from "./SourceMark";
import AttentionRow from "./AttentionRow.astro";
import ActivationGraph from "./ActivationGraph.astro";
import ControlPlaneReceipt from "./ControlPlaneReceipt.astro";
import SemanticInspector from "./SemanticInspector.astro";
import SemanticReference from "./SemanticReference.astro";
import {
  ArrowsClockwiseIcon,
  ClockIcon,
  EyeIcon,
  StopIcon,
} from "./admin-icons";
import { readAdminInbox, type AdminInboxItem } from "../data/inbox";
import { readOperatorWorkProjection } from "../data/operator-work";
import { operatorTaskDisplay } from "../data/operator-work-view";
import {
  buildActivationGraph,
  itemMatchesOperationalProjection,
  OPERATIONAL_PROJECTIONS,
  type OperationalProjection,
} from "../data/activation-graph";
import {
  buildOperatorTaskSemanticReferences,
  semanticStateLabel,
  type OperatorTaskSemanticReferences,
  type SemanticReference as SemanticReferenceModel,
} from "../data/semantic-reference";

const [inbox, work] = await Promise.all([
  readAdminInbox(Astro.locals.runtime?.env.DB),
  Promise.resolve(readOperatorWorkProjection()),
]);

const categories = ["work", "content", "life", "system"] as const;
const requestedCategory = Astro.url.searchParams.get("category");
const requestedView = Astro.url.searchParams.get("view");
const selectedOperationalView = OPERATIONAL_PROJECTIONS.find(
  (view) => view === requestedView,
) as OperationalProjection | undefined;
const selectedCategory = categories.find(
  (category) => category === requestedCategory,
);
const activation = buildActivationGraph(inbox, work);
const visibleItems = inbox.items.filter((item) => {
  const categoryMatches =
    !selectedCategory ||
    item.category === selectedCategory ||
    (selectedCategory === "system" && item.category === "fleet");
  const viewMatches = selectedOperationalView
    ? itemMatchesOperationalProjection(item, selectedOperationalView)
    : requestedView === "urgent"
      ? item.risk === "high"
      : true;
  return categoryMatches && viewMatches;
});
const topItems = visibleItems.slice(0, 4);
const remainingItems = visibleItems.slice(4);
const beingHandled = work.task_states.filter(
  (task) =>
    task.operator_state === "working" || task.operator_state === "review",
);
const workReferencesAreCurrent = activation.work_source_state === "current";
const workReferenceState = workReferencesAreCurrent ? "verified" : "stale";
const taskReferences = new Map(
  work.task_states.map((task) => [
    task.task_id,
    buildOperatorTaskSemanticReferences(task, workReferenceState),
  ]),
);

const displayTime = (value: string) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
  }).format(new Date(value));
const humanize = (value: string) => value.replaceAll("_", " ");
const linkedTaskFor = (item: AdminInboxItem) =>
  work.task_states.find(
    (task) =>
      task.attention_ref === item.id ||
      task.primary_entity_ref === item.entity_id ||
      task.entity_refs.includes(item.entity_id),
  );
const linkedTaskReferencesFor = (
  item: AdminInboxItem,
): OperatorTaskSemanticReferences | undefined => {
  const task = linkedTaskFor(item);
  return task ? taskReferences.get(task.task_id) : undefined;
};
const itemSemanticReferences = (item: AdminInboxItem) =>
  Object.values(item.references).filter(
    (reference) => reference !== null,
  ) as SemanticReferenceModel[];
const taskSemanticReferences = (references: OperatorTaskSemanticReferences) =>
  Object.values(references) as SemanticReferenceModel[];
const semanticReferences: SemanticReferenceModel[] = [
  inbox.source,
  ...activation.sources,
  ...activation.lanes.map((lane) => lane.reference),
  ...(activation.foreground_reference ? [activation.foreground_reference] : []),
  ...activation.nodes.flatMap((node) => [
    node.reference,
    node.source_reference,
  ]),
  ...visibleItems.flatMap(itemSemanticReferences),
  ...[...taskReferences.values()].flatMap(taskSemanticReferences),
];
const attentionTitle = selectedCategory
  ? humanize(selectedCategory)
  : requestedView
    ? humanize(requestedView)
    : "needs you";
const handledTitle = workReferencesAreCurrent
  ? "being handled"
  : "last verified work";
---

<AdminLayout title="Inbox" hideHeader>
  <main class="operator-page operator-inbox-page admin-canvas">
    <header class="operator-page-header admin-canvas-header">
      <div>
        <p class="operator-eyebrow">current attention</p>
        <h1 class="brand-display">Inbox</h1>
      </div>
      <div class="admin-canvas-summary" aria-label="Inbox source summary">
        <span>
          <EyeIcon size={18} weight="regular" aria-hidden="true" />
          <strong>{inbox.counts.total}</strong>
          open
        </span>
        <span class:list={[inbox.counts.high > 0 && "is-urgent"]}>
          <StopIcon size={18} weight="regular" aria-hidden="true" />
          <strong>{inbox.counts.high}</strong>
          urgent
        </span>
        <span>
          <ClockIcon size={18} weight="regular" aria-hidden="true" />
          checked {displayTime(inbox.generated_at)}
        </span>
        <SemanticReference
          reference={inbox.source}
          variant="compact"
          label={semanticStateLabel(inbox.source.source_state)}
        />
        <button
          type="button"
          class="admin-canvas-refresh is-icon-only"
          data-canvas-refresh
          aria-label="Refresh current read-only sources"
          title="Refresh current read-only sources"
        >
          <ArrowsClockwiseIcon size={20} weight="regular" aria-hidden="true" />
        </button>
      </div>
    </header>

    <nav
      class="operator-segmented-filter inbox-category-filter"
      aria-label="Filter attention"
    >
      <a
        href="/inbox"
        class:list={[!selectedCategory && !requestedView && "is-active"]}
        aria-current={!selectedCategory && !requestedView ? "page" : undefined}
        >all</a
      >
      <a
        href="/inbox?view=urgent"
        class:list={[requestedView === "urgent" && "is-active"]}
        aria-current={requestedView === "urgent" ? "page" : undefined}>urgent</a
      >
      <a
        href="/inbox?view=waiting"
        class:list={[requestedView === "waiting" && "is-active"]}
        aria-current={requestedView === "waiting" ? "page" : undefined}
        >waiting</a
      >
      {
        categories.map((category) => (
          <a
            href={`/inbox?category=${category}`}
            class:list={[selectedCategory === category && "is-active"]}
            aria-current={selectedCategory === category ? "page" : undefined}
          >
            {category}
          </a>
        ))
      }
    </nav>

    <ActivationGraph
      projection={activation}
      selectedView={selectedOperationalView ?? null}
    />

    <section
      class="operator-attention"
      aria-labelledby="attention-title"
      data-attention-projection
    >
      <div class="operator-section-heading">
        <div>
          <p>foreground decisions</p>
          <h2 id="attention-title">{attentionTitle}</h2>
        </div>
        <span>{visibleItems.length} visible</span>
      </div>

      <ol class="operator-attention-list">
        {
          topItems.map((item, index) => (
            <AttentionRow
              item={item}
              index={index}
              linkedTaskReferences={linkedTaskReferencesFor(item)}
            />
          ))
        }
      </ol>
    </section>

    <ControlPlaneReceipt />

    <section class="operator-handled" aria-labelledby="being-handled-title">
      <div class="operator-section-heading">
        <div>
          <p>
            {
              workReferencesAreCurrent
                ? "current execution"
                : "stale projection"
            }
          </p>
          <h2 id="being-handled-title">{handledTitle}</h2>
        </div>
        <a href="/work?view=now">open Work</a>
      </div>
      <div class="operator-handled-strip">
        {
          beingHandled.map((task) => {
            const references = taskReferences.get(task.task_id)!;
            return (
              <article class="operator-handled-item">
                <SourceMark provider={task.provider} compact />
                <div>
                  <SemanticReference
                    reference={references.task}
                    variant="value"
                  />
                  <span>{operatorTaskDisplay(task).bounded_goal}</span>
                </div>
                <div class="operator-handled-proof">
                  <SemanticReference
                    reference={references.source_time}
                    variant="compact"
                  />
                  <SemanticReference
                    reference={references.proof}
                    variant="compact"
                  />
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    {
      remainingItems.length > 0 && (
        <section
          class="operator-attention operator-attention-rest"
          aria-labelledby="remaining-attention-title"
        >
          <div class="operator-section-heading">
            <div>
              <p>lower in the same projection</p>
              <h2 id="remaining-attention-title">Everything else</h2>
            </div>
            <span>{remainingItems.length} visible</span>
          </div>
          <ol class="operator-attention-list is-secondary">
            {remainingItems.map((item, index) => (
              <AttentionRow
                item={item}
                index={index + topItems.length}
                linkedTaskReferences={linkedTaskReferencesFor(item)}
              />
            ))}
          </ol>
        </section>
      )
    }

    <SemanticInspector references={semanticReferences} />
    <p class="sr-only" aria-live="polite" data-admin-live-status></p>
  </main>

  <script is:inline data-astro-rerun>
    (() => {
      const itemId = new URLSearchParams(location.search).get("item");
      if (itemId) {
        const item = document.querySelector(
          `[data-attention-id="${CSS.escape(itemId)}"]`,
        );
        if (item instanceof HTMLElement) {
          item.dataset.linked = "true";
          item.scrollIntoView({ block: "center" });
        }
      }

      const manualRefresh = document.querySelector("[data-canvas-refresh]");
      manualRefresh?.addEventListener("click", () => location.reload());

      const currentItems = [
        ...document.querySelectorAll("[data-attention-id]"),
      ];
      let currentInboxSignature = JSON.stringify(
        currentItems.map((node) => [
          node.getAttribute("data-attention-id"),
          node.getAttribute("data-attention-status"),
          node.getAttribute("data-attention-updated"),
        ]),
      );
      let currentRuntimeSignature = null;
      const refresh = async () => {
        if (document.hidden) return;
        try {
          const [inboxResponse, runtimeResponse] = await Promise.all([
            fetch("/api/admin/inbox", {
              headers: { accept: "application/json" },
            }),
            fetch("/api/admin/runtime-feed", {
              headers: { accept: "application/json" },
            }),
          ]);
          if (!inboxResponse.ok || !runtimeResponse.ok) return;
          const [inboxPayload, runtimePayload] = await Promise.all([
            inboxResponse.json(),
            runtimeResponse.json(),
          ]);
          const nextInboxSignature = JSON.stringify(
            Array.isArray(inboxPayload.items)
              ? inboxPayload.items.map((entry) => [
                  entry.id,
                  entry.status,
                  entry.updated_at,
                ])
              : [],
          );
          const nextRuntimeSignature = JSON.stringify(
            Array.isArray(runtimePayload.overlays)
              ? runtimePayload.overlays.map((entry) => [
                  entry.repo_state_id,
                  entry.branch,
                  entry.ahead,
                  entry.behind,
                  entry.dirty_tracked_count,
                  entry.untracked_count,
                  entry.git_available,
                ])
              : [],
          );
          const inboxChanged = nextInboxSignature !== currentInboxSignature;
          const runtimeChanged =
            currentRuntimeSignature !== null &&
            nextRuntimeSignature !== currentRuntimeSignature;
          if (inboxChanged || runtimeChanged) {
            sessionStorage.setItem("admin:inbox-updated", "true");
            location.reload();
          }
          currentInboxSignature = nextInboxSignature;
          currentRuntimeSignature = nextRuntimeSignature;
        } catch {
          // The current source-backed view remains intact while disconnected.
        }
      };
      const interval = window.setInterval(refresh, 10_000);
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden) refresh();
      });
      window.addEventListener("pagehide", () => clearInterval(interval), {
        once: true,
      });
      if (sessionStorage.getItem("admin:inbox-updated") === "true") {
        sessionStorage.removeItem("admin:inbox-updated");
        document
          .querySelector("[data-attention-projection]")
          ?.classList.add("quiet-source-updated");
        const live = document.querySelector("[data-admin-live-status]");
        if (live) live.textContent = "Inbox updated from current sources.";
      }
    })();
  </script>
</AdminLayout>
