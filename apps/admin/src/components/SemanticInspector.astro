---
import {
  ArrowRightIcon,
  CheckCircleIcon,
  ClockIcon,
  DatabaseIcon,
  XIcon,
  iconForSemanticReference,
} from "./admin-icons";
import {
  isKnownSemanticReference,
  renderSemanticReference,
  semanticStateLabel,
  type SemanticReference,
} from "../data/semantic-reference";

type Props = {
  references: SemanticReference[];
};

const uniqueReferences = [
  ...new Map(
    Astro.props.references.map((reference) => [reference.id, reference]),
  ).values(),
];
const displayTime = (value: string | null) => {
  if (!value || !Number.isFinite(Date.parse(value))) return "not recorded";
  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    hour: "numeric",
    minute: "2-digit",
  }).format(new Date(value));
};
const humanize = (value: string) => value.replaceAll("_", " ");
---

<dialog
  class="semantic-inspector"
  data-semantic-inspector
  aria-label="Semantic reference inspector"
>
  <div class="semantic-inspector-sheet">
    {
      uniqueReferences.map((reference) => {
        const Icon = iconForSemanticReference[reference.kind];
        const descriptor = renderSemanticReference(reference);
        const hasDirectDestination =
          reference.source_state === "verified" &&
          (reference.destination.type === "provider" ||
            reference.destination.type === "internal");
        return (
          <section data-semantic-inspector-panel={reference.id} hidden>
            <header class="semantic-inspector-header">
              <div class="semantic-inspector-heading">
                <span class="semantic-inspector-kind">
                  <Icon size={22} weight="regular" aria-hidden="true" />
                  {humanize(reference.kind)}
                </span>
                <h2>
                  {isKnownSemanticReference(reference)
                    ? reference.value
                    : reference.label}
                </h2>
                <p>
                  {reference.authority.label} ·{" "}
                  {humanize(reference.confidence.level)} confidence
                </p>
              </div>
              <button
                type="button"
                class="semantic-inspector-close is-icon-only"
                data-semantic-close
                aria-label="Close reference inspector"
                title="Close reference inspector"
              >
                <XIcon size={22} weight="regular" aria-hidden="true" />
              </button>
            </header>

            <div class="semantic-inspector-facts">
              <article>
                <CheckCircleIcon
                  size={20}
                  weight="regular"
                  aria-hidden="true"
                />
                <span>
                  <small>current fact</small>
                  <strong>{reference.summary}</strong>
                </span>
              </article>
              <article>
                <DatabaseIcon size={20} weight="regular" aria-hidden="true" />
                <span>
                  <small>source state</small>
                  <strong>{semanticStateLabel(reference.source_state)}</strong>
                </span>
              </article>
            </div>

            <dl class="semantic-inspector-grid">
              <div>
                <dt>Authority</dt>
                <dd>{reference.authority.label}</dd>
              </div>
              <div>
                <dt>Provenance</dt>
                <dd>{reference.provenance.source_ref}</dd>
              </div>
              <div>
                <dt>Confidence</dt>
                <dd>
                  {reference.confidence.level} ·{" "}
                  {reference.confidence.explanation}
                </dd>
              </div>
              <div>
                <dt>Sensitivity</dt>
                <dd>{reference.sensitivity}</dd>
              </div>
              <div>
                <dt>Checked</dt>
                <dd>{displayTime(reference.checked_at)}</dd>
              </div>
              <div>
                <dt>Validity</dt>
                <dd>
                  {reference.validity.valid_until
                    ? `until ${displayTime(reference.validity.valid_until)}`
                    : reference.validity.valid_from
                      ? `from ${displayTime(reference.validity.valid_from)}`
                      : "no validity window recorded"}
                </dd>
              </div>
              <div class="is-wide">
                <dt>Retrieval policy</dt>
                <dd>{reference.retrieval_policy.explanation}</dd>
              </div>
              <div class="is-wide">
                <dt>Evidence</dt>
                <dd>
                  {reference.provenance.evidence_refs.length
                    ? reference.provenance.evidence_refs.join(", ")
                    : "no evidence pointer recorded"}
                </dd>
              </div>
            </dl>

            <footer class="semantic-inspector-actions">
              <button type="button" data-semantic-close>
                close
              </button>
              {reference.retrieval_policy.refresh_href && (
                <a href={reference.retrieval_policy.refresh_href}>
                  <ClockIcon size={18} weight="regular" aria-hidden="true" />
                  refresh source
                </a>
              )}
              {hasDirectDestination && (
                <a
                  class="is-primary"
                  href={descriptor.href!}
                  target={descriptor.target ?? undefined}
                  rel={descriptor.rel ?? undefined}
                >
                  {descriptor.action_label}
                  <ArrowRightIcon
                    size={18}
                    weight="regular"
                    aria-hidden="true"
                  />
                </a>
              )}
            </footer>
          </section>
        );
      })
    }
  </div>
</dialog>

<script is:inline data-astro-rerun>
  (() => {
    const dialog = document.querySelector("[data-semantic-inspector]");
    if (!(dialog instanceof HTMLDialogElement) || dialog.dataset.ready) return;
    dialog.dataset.ready = "true";
    let opener = null;

    const close = () => {
      if (dialog.open) dialog.close();
    };

    const open = (referenceId, trigger) => {
      const panels = dialog.querySelectorAll("[data-semantic-inspector-panel]");
      let selected = null;
      panels.forEach((panel) => {
        const matches =
          panel.getAttribute("data-semantic-inspector-panel") === referenceId;
        panel.hidden = !matches;
        if (matches) selected = panel;
      });
      if (!(selected instanceof HTMLElement)) return;
      opener = trigger instanceof HTMLElement ? trigger : null;
      document.body.dataset.semanticInspectorOpen = "true";
      if (!dialog.open) dialog.showModal();
      selected
        .querySelector("[data-semantic-close]")
        ?.focus({ preventScroll: true });
    };

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const openTrigger = target.closest("[data-semantic-open]");
      if (openTrigger instanceof HTMLElement) {
        event.preventDefault();
        open(openTrigger.dataset.semanticOpen, openTrigger);
        return;
      }
      if (target.closest("[data-semantic-close]")) close();
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) close();
    });
    dialog.addEventListener("close", () => {
      delete document.body.dataset.semanticInspectorOpen;
      if (opener?.isConnected) opener.focus({ preventScroll: true });
      opener = null;
    });
    dialog.addEventListener("cancel", () => {
      delete document.body.dataset.semanticInspectorOpen;
    });
  })();
</script>
