---
import SemanticReference from "./SemanticReference.astro";
import {
  ArrowRightIcon,
  DatabaseIcon,
  EyeIcon,
  iconForGraphLayer,
  iconForOperationalProjection,
} from "./admin-icons";
import {
  renderSemanticReference,
  semanticStateLabel,
} from "../data/semantic-reference";
import type {
  ActivationGraphProjection,
  OperationalProjection,
} from "../data/activation-graph";

type Props = {
  projection: ActivationGraphProjection;
  selectedView: OperationalProjection | null;
};

const { projection, selectedView } = Astro.props;
const displayTime = (value: string) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
  }).format(new Date(value));
const humanize = (value: string) => value.replaceAll("_", " ");
---

<section class="activation-surface" aria-labelledby="activation-title">
  <header class="activation-focus">
    <div class="activation-focus-copy">
      <span class="activation-kicker">
        <EyeIcon size={18} weight="regular" aria-hidden="true" />
        suggested foreground
      </span>
      <h2 id="activation-title">
        {projection.foreground?.title ?? "No current focus suggestion"}
      </h2>
      <p>{projection.foreground_reason}</p>
    </div>
    {
      projection.foreground_reference && (
        <SemanticReference
          reference={projection.foreground_reference}
          variant="action"
          label="Inspect focus"
        />
      )
    }
  </header>

  <section class="activation-projections" aria-labelledby="work-states-title">
    <header class="activation-section-heading">
      <div>
        <span>operational projections</span>
        <h3 id="work-states-title">Work states</h3>
      </div>
      <p>derived from dependencies, authority, and evidence</p>
    </header>

    <nav class="activation-lanes" aria-label="Operational state projections">
      {
        projection.lanes.map((lane) => {
          const Icon = iconForOperationalProjection[lane.key];
          const descriptor = renderSemanticReference(lane.reference);
          return (
            <a
              href={descriptor.href ?? lane.href}
              class:list={[
                `lane-${lane.key}`,
                lane.source_state !== "current" && "is-stale",
                selectedView === lane.key && "is-active",
              ]}
              aria-current={selectedView === lane.key ? "page" : undefined}
              aria-label={`${lane.count} ${lane.label}. ${lane.basis}. ${lane.source_state}.`}
              title={`${lane.basis}. ${lane.source_state}.`}
              data-semantic-reference={lane.reference.id}
            >
              <span class="activation-lane-icon">
                <Icon size={21} weight="regular" aria-hidden="true" />
              </span>
              <strong>{lane.count}</strong>
              <span>{lane.label}</span>
              <small>
                {lane.source_state === "stale"
                  ? "last verified"
                  : lane.source_state === "partial"
                    ? "partial source"
                    : "current"}
              </small>
            </a>
          );
        })
      }
    </nav>
  </section>

  <section class="activation-source-state" aria-labelledby="source-state-title">
    <header>
      <span class="activation-source-icon">
        <DatabaseIcon size={20} weight="regular" aria-hidden="true" />
      </span>
      <div>
        <span>source state</span>
        <h3 id="source-state-title">
          {
            projection.mode === "ready" &&
            projection.work_source_state === "current"
              ? "current sources"
              : "source limits are visible"
          }
        </h3>
      </div>
    </header>
    <div>
      {
        projection.sources.map((source) => (
          <SemanticReference
            reference={source}
            variant="compact"
            label={source.value === null ? source.label : undefined}
            showState
          />
        ))
      }
    </div>
  </section>

  {
    projection.nodes.length > 0 && (
      <section class="activation-graph-section" aria-labelledby="graph-title">
        <header class="activation-section-heading">
          <div>
            <span>connected context</span>
            <h3 id="graph-title">Four-layer graph</h3>
          </div>
          <p>world, obligation, execution, and trajectory stay distinct</p>
        </header>

        <div class="activation-graph" data-activation-graph>
          {projection.nodes.map((node, index) => {
            const Icon = iconForGraphLayer[node.layer];
            return (
              <div class="activation-node-wrap">
                <article class={`activation-node layer-${node.layer}`}>
                  <header>
                    <span class="activation-node-layer">
                      <Icon size={20} weight="regular" aria-hidden="true" />
                      {node.layer}
                    </span>
                    <small>{humanize(node.label)}</small>
                  </header>
                  <h4>{node.title}</h4>
                  <p>{node.detail}</p>
                  <footer>
                    <SemanticReference
                      reference={node.source_reference}
                      variant="compact"
                      showState
                    />
                    <SemanticReference
                      reference={node.reference}
                      variant="action"
                      label="Inspect"
                    />
                  </footer>
                </article>
                {index < projection.nodes.length - 1 && (
                  <span class="activation-edge" aria-hidden="true">
                    <i />
                    <small>
                      {humanize(projection.connections[index]!.relation)}
                    </small>
                    <ArrowRightIcon size={16} weight="regular" />
                  </span>
                )}
              </div>
            );
          })}
        </div>
      </section>
    )
  }

  <footer class="activation-contract">
    <span>overlapping projections, not stored top-level states</span>
    <span>
      work last verified {displayTime(projection.work_last_verified_at)} · {
        projection.mode
      } attention source · {
        semanticStateLabel(projection.sources[0]!.source_state)
      }
    </span>
  </footer>
</section>
