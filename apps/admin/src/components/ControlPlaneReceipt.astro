---
import { readControlPlane } from "../data/control-plane";

const state = await readControlPlane(
  Astro.locals.runtime?.env.COMMAND_RELAY,
  2,
);
const latest = state.snapshot.commands[0] ?? null;
const displayTime = (value: string) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
  }).format(new Date(value));
---

<section
  class="operator-handled"
  aria-labelledby="control-plane-title"
  data-control-plane-receipt
  data-control-plane-state={latest?.state ??
    (state.available ? "unknown" : "unavailable")}
>
  <div class="operator-section-heading">
    <div>
      <h2 id="control-plane-title">Local execution proof</h2>
      <p>
        {
          state.snapshot.device_connected
            ? "ap-mini connected"
            : "ap-mini connection not currently verified"
        }
      </p>
    </div>
  </div>

  <div class="operator-handled-strip">
    <article class="operator-handled-item">
      <span class="operator-source-mark" aria-label="ap-mini executor">
        <span class="operator-source-glyph" aria-hidden="true">AP</span>
        <span class="operator-source-label">ap-mini</span>
      </span>
      <div>
        <strong
          >{latest?.outcome?.summary ?? "no verified round trip yet"}</strong
        >
        <span>
          {
            latest
              ? `${latest.state} · ${latest.kind}`
              : state.available
                ? "No proof command recorded"
                : "local relay unavailable in this preview"
          }
        </span>
      </div>
      {
        latest ? (
          <time datetime={latest.updated_at}>
            {displayTime(latest.updated_at)}
          </time>
        ) : (
          <span>{state.available ? "No command recorded" : "Unavailable"}</span>
        )
      }
    </article>

    <article class="operator-handled-item">
      <span class="operator-source-mark" aria-label="Local journal proof">
        <span class="operator-source-glyph" aria-hidden="true">J</span>
        <span class="operator-source-label">journal</span>
      </span>
      <div>
        <strong>
          {
            latest?.proof
              ? "journal proof acknowledged"
              : "No journal proof recorded"
          }
        </strong>
        <span>
          {
            latest?.proof
              ? `${latest.proof.evidence_ref} · ${latest.proof.journal_head_hash.slice(0, 12)}`
              : "relay acknowledgement will appear here"
          }
        </span>
      </div>
      <a href="/proof">inspect</a>
    </article>
  </div>
</section>
