---
import SemanticReference from "./SemanticReference.astro";
import { ArrowRightIcon, iconForInboxCategory } from "./admin-icons";
import { renderSemanticReference } from "../data/semantic-reference";
import type { AdminInboxItem } from "../data/inbox";
import type { OperatorTaskSemanticReferences } from "../data/semantic-reference";

type Props = {
  item: AdminInboxItem;
  index: number;
  linkedTaskReferences?: OperatorTaskSemanticReferences;
};

const { item, index, linkedTaskReferences } = Astro.props;
const CategoryIcon = iconForInboxCategory[item.category];
const action = renderSemanticReference(item.references.action);
const ownerReference = linkedTaskReferences?.owner ?? item.references.owner;
const proofReference = linkedTaskReferences?.proof ?? item.references.proof;
const timeReference =
  linkedTaskReferences?.source_time ?? item.references.source_time;
---

<li
  class={`operator-attention-row risk-${item.risk}`}
  data-attention-id={item.id}
  data-entity-id={item.entity_id}
  data-attention-status={item.status}
  data-attention-updated={item.updated_at}
>
  <header class="operator-attention-card-header">
    <span class="operator-attention-domain">
      <CategoryIcon size={18} weight="regular" aria-hidden="true" />
      {item.category}
    </span>
    <span class={`operator-attention-risk is-${item.risk}`}>
      {String(index + 1).padStart(2, "0")} · {item.risk}
    </span>
  </header>

  <div class="operator-attention-copy">
    <h3>
      <a
        href={action.href ?? undefined}
        aria-label={`${action.action_label} for ${item.title}`}
        data-semantic-reference={item.references.action.id}
      >
        {item.title}
      </a>
    </h3>
    <p>{item.summary}</p>
    <div class="operator-attention-next">
      <ArrowRightIcon size={17} weight="regular" aria-hidden="true" />
      <span>
        <small>next</small>
        <strong>{item.next_action}</strong>
      </span>
    </div>
  </div>

  <footer class="operator-attention-footer">
    <div class="operator-attention-references">
      <SemanticReference reference={ownerReference} variant="compact" />
      <SemanticReference reference={timeReference} variant="compact" />
      {
        item.references.deadline && (
          <SemanticReference
            reference={item.references.deadline}
            variant="compact"
          />
        )
      }
      <SemanticReference reference={proofReference} variant="compact" />
    </div>
    <SemanticReference
      reference={item.references.action}
      variant="action"
      label="Review"
    />
  </footer>
</li>
