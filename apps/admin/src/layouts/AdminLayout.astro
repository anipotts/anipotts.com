---
// The overview, Data, Observability and the retired console pages. Their
// legacy stylesheets load first, so the shared document's styles still come
// after them in the cascade.
import "@astryxdesign/core/reset.css";
import "@astryxdesign/core/astryx.css";
import "../styles/admin-interactions.css";
import "@astryxdesign/theme-neutral/theme.css";
import "../styles/admin.css";
import "../styles/fonts.css";
import "../styles/admin-canvas.css";
import AdminDocument from "./AdminDocument.astro";
import { AdminShell } from "../components/astryx/AdminShell";
import { initialAdminTheme } from "../lib/admin-theme";
import type { AdminSearchResult } from "../data/admin-search";

type Props = {
  title: string;
  deck?: string;
  hideHeader?: boolean;
  /** Content the page already read, for the palette to search. */
  searchEntries?: AdminSearchResult[];
};

const { title, deck = "", hideHeader = false, searchEntries } = Astro.props;
const initialMode = initialAdminTheme(
  Astro.url.searchParams.get("theme"),
  Astro.cookies.get("ap-theme")?.value,
);
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentRoute = `${currentPath}${Astro.url.search}`;
const localOwner =
  __LOCAL_OWNER_BUILD__ &&
  Astro.locals.adminPrincipal?.authMethod === "local_owner";
---

<AdminDocument title={title}>
  <AdminShell
    client:load
    localPreview={import.meta.env.DEV}
    localOwner={localOwner}
    initialMode={initialMode}
    currentRoute={currentRoute}
    deck={deck}
    hideHeader={hideHeader}
    searchEntries={searchEntries}
    title={title}
  >
    <slot />
  </AdminShell>
</AdminDocument>
