---
import "@astryxdesign/core/reset.css";
import "@astryxdesign/core/astryx.css";
import "../styles/admin-interactions.css";
import "../themes/editorial.generated.css";
import "@fontsource-variable/instrument-sans";
import "../styles/editorial.css";
import "../styles/scrollbars.css";
import { publicSiteUrl, editorialInventory } from "../lib/editorial-content";
import { privateWritingRecords } from "../lib/writing-inventory";
import { productionEditor } from "../lib/editorial-server";
import {
  EditorialApp,
  type EditorialAppProps,
} from "../components/astryx/EditorialApp";
type Props = Omit<
  EditorialAppProps,
  "area" | "localPreview" | "siteUrl" | "initialMode"
>;
const preference =
  Astro.url.searchParams.get("theme") ?? Astro.cookies.get("ap-theme")?.value;
const initialMode =
  preference === "dark" || preference === "system" ? preference : "light";
const area = Astro.url.pathname.startsWith("/newsletter")
  ? "newsletter"
  : "content";
const hasContent = Boolean((await Astro.slots.render("default"))?.trim());
const inventory = await editorialInventory();
const searchEntries = [
  ...inventory.pages,
  ...inventory.projects,
  ...inventory.writing,
].map((entry) => ({
  id: `content:${entry.collection}:${entry.id}`,
  label: "title" in entry.data ? entry.data.title : entry.id,
  domain: "content" as const,
  kind: entry.collection,
  currentFact:
    entry.collection === "projects"
      ? entry.data.public_state
      : entry.collection === "writing" || entry.collection === "newsletterPage"
        ? entry.data.status
        : "published",
  source: "content inventory",
  freshness: "current",
  href: `/content/${entry.collection}/${encodeURIComponent(entry.id)}`,
  keywords: [entry.id, entry.collection],
}));
let privateSearchUnavailable = false;
try {
  const storage = import.meta.env.DEV
    ? await (await import("../lib/editorial-local")).localDraftStorage()
    : productionEditor(Astro.locals.runtime?.env)?.storage;
  if (!storage) throw new Error("storage_unavailable");
  for (const record of privateWritingRecords(
    await storage.listWritingDrafts(),
  )) {
    if (searchEntries.some((entry) => entry.href === record.href)) continue;
    searchEntries.push({
      id: `private:${record.href}`,
      label: record.title,
      domain: "content",
      kind: "writing",
      currentFact: "draft",
      source: "private content inventory",
      freshness: "current",
      href: record.href,
      keywords: [record.title, "writing", "draft"],
    });
  }
} catch {
  privateSearchUnavailable = true;
}
const appProps = {
  searchEntries,
  ...Astro.props,
  inventoryError: Boolean(
    Astro.props.inventoryError || privateSearchUnavailable,
  ),
  area,
  siteUrl: publicSiteUrl,
  initialMode,
  localPreview: import.meta.env.DEV,
} satisfies EditorialAppProps;
---

<!doctype html>
<html lang="en" data-astryx-theme="editorial">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{Astro.props.title} | admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    {
      hasContent ? (
        <EditorialApp {...appProps} client:load>
          <slot />
        </EditorialApp>
      ) : (
        <EditorialApp {...appProps} client:load />
      )
    }
  </body>
</html>
