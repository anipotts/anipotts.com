---
import "@astryxdesign/core/reset.css";
import {
  initialAdminTheme,
  adminThemePrepaintScript,
} from "../lib/admin-theme";
import "@astryxdesign/core/astryx.css";
import "../styles/admin-interactions.css";
import "../themes/editorial.generated.css";
import "@fontsource-variable/instrument-sans";
import "../styles/editorial.css";
import "../styles/focus.css";
import "../styles/scrollbars.css";
import { publicSiteUrl } from "../lib/editorial-content";
import { EDITORIAL_OWNER_EMAIL } from "../lib/editorial-owner";
import { loadEditorialInventory } from "../lib/editorial-inventory-server";
import {
  EditorialApp,
  type EditorialAppProps,
} from "../components/astryx/EditorialApp";
type Props = Omit<
  EditorialAppProps,
  "area" | "localPreview" | "siteUrl" | "initialMode" | "recoveryScope"
> & {
  inventoryProjection?: Awaited<ReturnType<typeof loadEditorialInventory>>;
};
const initialMode = initialAdminTheme(
  Astro.url.searchParams.get("theme"),
  Astro.cookies.get("ap-theme")?.value,
);
const area = Astro.url.pathname.startsWith("/newsletter")
  ? "newsletter"
  : "content";
const hasContent = Boolean((await Astro.slots.render("default"))?.trim());
const { inventoryProjection: suppliedInventory, ...pageProps } = Astro.props;
const inventory =
  suppliedInventory ??
  (await loadEditorialInventory(Astro.locals.runtime?.env));
const appProps = {
  searchEntries: inventory.searchEntries,
  ...pageProps,
  inventoryError: Boolean(Astro.props.inventoryError || inventory.unavailable),
  area,
  siteUrl: publicSiteUrl,
  initialMode,
  localPreview: import.meta.env.DEV,
  recoveryScope: EDITORIAL_OWNER_EMAIL,
  librarySearch: Astro.url.search,
} satisfies EditorialAppProps;
---

<!doctype html>
<html
  lang="en"
  data-astryx-theme="editorial"
  data-theme={initialMode === "system" ? undefined : initialMode}
  style={{ colorScheme: initialMode === "system" ? "light dark" : initialMode }}
>
  <head>
    <meta charset="utf-8" />
    <link
      rel="icon"
      href="/admin-bracket.svg?v=4"
      type="image/svg+xml"
      sizes="any"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{Astro.props.title} | Admin</title>
    <script is:inline set:html={adminThemePrepaintScript} />
  </head>
  <body>
    {
      hasContent ? (
        <EditorialApp {...appProps} client:load>
          <slot />
        </EditorialApp>
      ) : (
        <EditorialApp {...appProps} client:load />
      )
    }
  </body>
</html>
