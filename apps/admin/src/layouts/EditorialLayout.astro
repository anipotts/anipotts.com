---
import "@astryxdesign/core/reset.css";
import "@astryxdesign/core/astryx.css";
import "../themes/editorial.generated.css";
import "@fontsource-variable/instrument-sans";
import "../styles/editorial.css";
import "../styles/scrollbars.css";
import { publicSiteUrl } from "../lib/editorial-content";
import {
  EditorialApp,
  type EditorialAppProps,
} from "../components/astryx/EditorialApp";
type Props = Omit<
  EditorialAppProps,
  "area" | "localPreview" | "siteUrl" | "initialMode"
>;
const preference =
  Astro.url.searchParams.get("theme") ?? Astro.cookies.get("ap-theme")?.value;
const initialMode =
  preference === "dark" || preference === "system" ? preference : "light";
const area = Astro.url.pathname.startsWith("/newsletter")
  ? "newsletter"
  : "content";
const hasContent = Boolean((await Astro.slots.render("default"))?.trim());
const appProps = {
  ...Astro.props,
  area,
  siteUrl: publicSiteUrl,
  initialMode,
  localPreview: import.meta.env.DEV,
} satisfies EditorialAppProps;
---

<!doctype html>
<html lang="en" data-astryx-theme="editorial">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{Astro.props.title} | admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    {
      hasContent ? (
        <EditorialApp {...appProps} client:load>
          <slot />
        </EditorialApp>
      ) : (
        <EditorialApp {...appProps} client:load />
      )
    }
  </body>
</html>
