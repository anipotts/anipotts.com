---
import { runtimeEnv } from "../lib/runtime-env";
import AdminDocument from "./AdminDocument.astro";
import { initialAdminTheme } from "../lib/admin-theme";
import { publicSiteUrl } from "../lib/editorial-content";
import { EDITORIAL_OWNER_EMAIL } from "../lib/editorial-owner";
import { loadEditorialInventory } from "../lib/editorial-inventory-server";
import { measureServerTiming } from "../lib/server-timing";
import {
  EditorialApp,
  type EditorialAppProps,
} from "../components/astryx/EditorialApp";
type Props = Omit<
  EditorialAppProps,
  | "area"
  | "localPreview"
  | "localOwner"
  | "siteUrl"
  | "initialMode"
  | "recoveryScope"
> & {
  inventoryProjection?: Awaited<ReturnType<typeof loadEditorialInventory>>;
  /** Set only when the route supplies actual body content, not an empty conditional slot. */
  hasContent?: boolean;
};
const initialMode = initialAdminTheme(
  Astro.url.searchParams.get("theme"),
  Astro.cookies.get("ap-theme")?.value,
);
const area =
  Astro.url.pathname.startsWith("/newsletter") ||
  Astro.url.pathname === "/content/newsletter"
    ? "newsletter"
    : "content";
const {
  inventoryProjection: suppliedInventory,
  hasContent = false,
  ...pageProps
} = Astro.props;
// Astro counts an empty conditional as a slot. The route knows whether it has
// content; rendering it here to inspect it would consume island hydration.
const renderContent = hasContent && Astro.slots.has("default");
const inventory =
  suppliedInventory ??
  (await measureServerTiming(Astro.locals, "inventory", () =>
    loadEditorialInventory(runtimeEnv()),
  ));
const appProps = {
  searchEntries: inventory.searchEntries,
  ...pageProps,
  inventoryError: Boolean(Astro.props.inventoryError || inventory.unavailable),
  homepageWritingOptions:
    pageProps.editHome ||
    (pageProps.editorRecord?.kind === "page" &&
      pageProps.editorRecord.id === "home")
      ? inventory.records
          .filter(
            (record) => record.collection === "writing" && record.publishedSlug,
          )
          .map((record) => ({
            slug: record.publishedSlug!,
            title: record.title,
            status: record.status,
          }))
      : undefined,
  area,
  siteUrl: publicSiteUrl,
  initialMode,
  localPreview: import.meta.env.DEV,
  localOwner:
    __LOCAL_OWNER_BUILD__ &&
    Astro.locals.adminPrincipal?.authMethod === "local_owner",
  recoveryScope: EDITORIAL_OWNER_EMAIL,
  librarySearch: Astro.url.search,
} satisfies EditorialAppProps;
---

<AdminDocument title={Astro.props.title}>
  {
    renderContent ? (
      <EditorialApp {...appProps} client:load>
        <slot />
      </EditorialApp>
    ) : (
      <EditorialApp {...appProps} client:load />
    )
  }
</AdminDocument>
