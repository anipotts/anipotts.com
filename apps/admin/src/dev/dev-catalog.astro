---
import EditorialLayout from "../layouts/EditorialLayout.astro";
import { DevDataCatalog } from "../components/astryx/dev-data-catalog";
import { DevReviewCatalog } from "../components/astryx/dev-review-catalog";
import { DevMarksCatalog } from "../components/dev-marks-catalog";
import { DevKitCatalog } from "../components/workspace/dev-kit-catalog";

// The normal Content owner/origin middleware still applies. This route cannot
// expose a catalog in a deployed build, even to an authenticated owner.
if (!import.meta.env.DEV) {
  return new Response(null, {
    status: 404,
    headers: { "Cache-Control": "private, no-store" },
  });
}

// Supply an empty synthetic inventory so this page never opens a draft store.
const inventoryProjection = {
  records: [],
  groups: [],
  searchEntries: [],
  unavailable: false,
};
const fixture = Astro.url.searchParams.get("fixture");

// The kit reads a local replay of the live ops payloads when one exists
// (.local/ is ignored and never committed), else System's sample.
const replay = import.meta.glob<unknown>("../../.local/replay/*.json", {
  import: "default",
});
const readReplay = (name: string) =>
  replay[`../../.local/replay/${name}`]?.() ?? Promise.resolve(null);
const kit =
  fixture === "kit"
    ? await Promise.all([
        readReplay("ops_v1.json"),
        readReplay("ops_events_v1.json"),
      ]).then(async ([ops, events]) => ({
        ops: ops ?? (await import("../fixtures/ops_v1.sample.json")).default,
        events:
          events ??
          (await import("../fixtures/ops_events_v1.synthetic.json")).default,
        source: ops ? "replay" : "sample",
      }))
    : null;
---

<EditorialLayout
  title="Component catalog"
  hideHeader
  hasContent
  inventoryProjection={inventoryProjection}
>
  {
    fixture === "data" ? (
      <DevDataCatalog client:load />
    ) : fixture === "marks" ? (
      <DevMarksCatalog />
    ) : kit ? (
      <DevKitCatalog
        client:load
        ops={kit.ops}
        opsEvents={kit.events}
        source={kit.source}
      />
    ) : (
      <DevReviewCatalog client:load />
    )
  }
</EditorialLayout>
