{
  "name": "@anipotts/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "astryx": {
    "theme": "./src/themes/editorial.ts"
  },
  "scripts": {
    "astryx": "astryx",
    "theme:build": "astryx theme build src/themes/editorial.ts --out src/themes/editorial.generated.css",
    "theme:check": "astryx theme build src/themes/editorial.ts --out src/themes/editorial.generated.css --check",
    "dev": "astro dev --port 3001",
    "build": "pnpm theme:check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "astro check",
    "typecheck": "astro check && pnpm typecheck:editorial",
    "editorial:types": "pnpm --workspace-root exec wrangler types apps/admin/test/bindings.d.ts --config apps/admin/test/wrangler.jsonc --env-interface EditorialTestEnv",
    "typecheck:editorial": "pnpm editorial:types && tsc -p tsconfig.editorial.json",
    "test": "vitest run && pnpm test:editorial",
    "test:editorial": "vitest run --config vitest.editorial.config.ts"
  },
  "dependencies": {
    "@anipotts/brand": "workspace:*",
    "@anipotts/content": "workspace:*",
    "@anipotts/lib": "workspace:*",
    "@anipotts/types": "workspace:*",
    "@astrojs/cloudflare": "^12.6.0",
    "@astrojs/markdown-remark": "6.3.11",
    "@astrojs/react": "^4.4.2",
    "@astryxdesign/core": "^0.4.6",
    "@astryxdesign/theme-neutral": "^0.4.6",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@iconify-json/ph": "^1.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "@stylexjs/stylex": "^0.19.0",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "astro": "^7.2.8",
    "astro-icon": "^1.1.5",
    "jose": "^6.2.12",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-sanitize": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astryxdesign/cli": "^0.4.6",
    "@cloudflare/vitest-plugin": "1.1.6",
    "@cloudflare/workers-types": "5.20260908.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "gpt-tokenizer": "^3.4.0",
    "miniflare": "4.20260114.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
