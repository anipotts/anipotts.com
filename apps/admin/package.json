{
  "name": "@anipotts/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "astryx": {
    "theme": "./src/themes/editorial.ts"
  },
  "scripts": {
    "astryx": "astryx",
    "theme:build": "node ../../scripts/admin/theme-build.mjs",
    "theme:check": "node ../../scripts/admin/theme-build.mjs --check",
    "dev": "astro dev --port 3001",
    "build": "pnpm --workspace-root check:system-contracts && pnpm theme:check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "astro check",
    "typecheck": "astro check && pnpm typecheck:editorial",
    "editorial:types": "pnpm --workspace-root exec wrangler types apps/admin/test/bindings.d.ts --config apps/admin/test/wrangler.jsonc --env-interface EditorialTestEnv",
    "typecheck:editorial": "pnpm editorial:types && tsc -p tsconfig.editorial.json",
    "test": "vitest run && pnpm test:astro && pnpm test:editorial && pnpm test:recovery && pnpm test:csp",
    "test:astro": "vitest run --config vitest.astro.config.ts",
    "test:editorial": "vitest run --config vitest.editorial.config.ts",
    "test:csp": "pnpm build && vitest run --config vitest.csp.config.ts",
    "test:theme-render": "node ../../scripts/admin/theme-contrast.mjs",
    "test:recovery": "node --test ../../scripts/admin/editorial-recovery.test.mjs ../../scripts/admin/editorial-recovery-capture.test.mjs ../../scripts/admin/recovery-media-container.test.mjs && vitest run --config vitest.recovery.config.ts"
  },
  "dependencies": {
    "@anipotts/brand": "workspace:*",
    "@anipotts/content": "workspace:*",
    "@anipotts/runtime-contract": "workspace:*",
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/react": "7.0.1",
    "@astryxdesign/core": "^0.4.6",
    "@astryxdesign/theme-neutral": "^0.4.6",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@iconify-json/ph": "^1.2.2",
    "@openai/apps-sdk-ui": "^0.2.2",
    "@openai/chatkit-react": "^1.6.1",
    "@phosphor-icons/react": "^2.1.10",
    "@stylexjs/stylex": "^0.19.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "astro": "7.4.0",
    "astro-icon": "^1.2.0",
    "github-slugger": "^2.0.0",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.3",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "7.3.3",
    "@astryxdesign/cli": "0.7.1",
    "@cloudflare/vitest-plugin": "1.4.3",
    "@cloudflare/workers-types": "5.20261016.1",
    "@iconify-json/logos": "^1.2.16",
    "@iconify-json/simple-icons": "^1.2.100",
    "@playwright/test": "1.64.1",
    "@types/hast": "^3.0.5",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "postcss-selector-parser": "^7.1.6",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
