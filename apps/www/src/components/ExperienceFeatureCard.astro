---
import ResponsiveCopy from "./ResponsiveCopy.astro";
import CardAction from "./CardAction.astro";
import AmbientFlow from "./AmbientFlow.astro";
import type { Project } from "../lib/content";
import { phoneMedia, responsiveScreenshot } from "../lib/responsive-image";

interface Props {
  project: Project;
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const d = project.data;
const preview = d.preview_media;
const identity = d.identity;
const slug = project.data.slug ?? project.id;
const isPgi = slug === "pgi-research-platform";
const treatment = slug === "structured-ai" ? "current" : "community";
const displayTitle = d.card_title?.trim() || d.title;
const shot =
  preview?.kind === "video"
    ? undefined
    : responsiveScreenshot(preview?.src ?? "");
// The experience grid is one column up to 640px, then two tracks under 27rem.
// The image is width: auto, so it never renders wider than this value.
const shotSizes = "(max-width: 640px) 100vw, 27rem";
---

<a
  href={d.detail_path}
  class:list={[
    "experience-feature",
    `experience-feature--${treatment}`,
    { "experience-feature--pgi": isPgi },
  ]}
>
  <AmbientFlow kind="work" seed={slug} />
  <span class="experience-feature__visual landscape-frame">
    {
      preview && (
        <span class="experience-feature__window">
          {preview.kind === "video" ? (
            <video
              src={preview.src}
              muted
              playsinline
              preload="metadata"
              aria-label={preview.alt}
            />
          ) : shot ? (
            <picture>
              <source media={phoneMedia} srcset={shot.src} />
              <img
                src={shot.src}
                srcset={shot.srcset}
                sizes={shotSizes}
                width={shot.width}
                height={shot.height}
                style={`aspect-ratio: ${shot.aspectRatio}`}
                alt={preview.alt}
                loading={eager ? "eager" : "lazy"}
                decoding="async"
              />
            </picture>
          ) : (
            <img
              src={preview.src}
              alt={preview.alt}
              loading={eager ? "eager" : "lazy"}
              decoding="async"
            />
          )}
        </span>
      )
    }
  </span>

  <span class="experience-feature__body">
    <span class="experience-feature__heading">
      <span class="experience-feature__name">{displayTitle}</span>
      <CardAction
        label="view project"
        largeMark={isPgi}
        logoSrc={identity.logo_src}
        icon={identity.icon}
        adaptive={identity.logo_tone === "adaptive" || isPgi}
      />
    </span>
    <span class="experience-feature__copy"
      ><ResponsiveCopy
        text={d.card_copy}
        compact={d.card_copy_compact}
        links={false}
      /></span
    >
  </span>
</a>

<style>
  .experience-feature {
    --feature-blue: #1247e6;
    --feature-shell: var(--paper-surface);
    --feature-ink: var(--paper-ink);
    --feature-muted: var(--paper-muted);
    --feature-control: #e7f0ff;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--paper-radius);
    background: var(--feature-shell);
    color: var(--feature-ink);
    text-decoration: none;
    box-shadow: var(--paper-shadow);
    transition: none;
  }

  .experience-feature__visual {
    position: relative;
    display: grid;
    place-items: center;
    padding: var(--card-inset);
    padding-bottom: 0;
    overflow: hidden;
    isolation: isolate;
  }

  .experience-feature__window {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-desktop-ui-media);
  }

  .experience-feature__window picture {
    display: contents;
  }

  .experience-feature__window :is(img, video) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    min-width: 0;
    min-height: 0;
    display: block;
    object-fit: contain;
    object-position: center;
    border-radius: var(--radius-desktop-ui-media);
    background: transparent;
  }

  .experience-feature__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--card-content-gap);
    padding: var(--card-inset);
  }

  .experience-feature__name {
    font-family: var(--display);
    font-size: var(--card-title-size);
    font-weight: var(--card-title-weight);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .experience-feature__copy {
    max-width: none;
    color: var(--feature-muted);
    font-size: var(--card-copy-size);
    font-weight: var(--card-copy-weight);
    line-height: var(--card-copy-leading);
    text-wrap: pretty;
  }

  .experience-feature:focus-visible {
    outline: var(--focus-width) solid var(--paper-ink);
    outline-offset: var(--focus-offset);
  }

  :global(html[data-theme="dark"]) .experience-feature {
    --feature-control: color-mix(in srgb, #61abea 16%, #11151d);
  }

  @media (max-width: 640px) {
    .experience-feature__body {
      min-height: auto;
    }
  }
</style>
