---
import { Icon } from "astro-icon/components";
import { siteConfig, siteLinks } from "@anipotts/content/public";
const footerLinks = (
  ["github", "x", "linkedin", "newsletter", "rss", "admin"] as const
).map((key) => ({ key, link: siteLinks[key] }));
---

<footer id="contact" class="frame foot">
  <div class="contact-copy">
    <span>have a question?</span>
    <a href={siteLinks.email.href} class="contact-email">{siteConfig.email}</a>
  </div>
  <nav class="glyphs" aria-label="Social and site links">
    {
      footerLinks.map(({ key, link }) => (
        <a
          href={link.href}
          class:list={["glyph", { "admin-glyph": key === "admin" }]}
          aria-label={link.label}
          title={link.title}
          target={
            ["github", "x", "linkedin"].includes(key) ? "_blank" : undefined
          }
          rel={
            ["github", "x", "linkedin"].includes(key)
              ? "noopener noreferrer"
              : undefined
          }
        >
          <Icon name={link.icon} />
        </a>
      ))
    }
  </nav>
</footer>

<style>
  .foot {
    position: relative;
    margin-top: 0;
    padding-block: var(--s-5)
      calc(var(--s-5) + env(safe-area-inset-bottom, 0px));
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-5);
    font-size: var(--p-small);
  }

  .foot::before {
    content: "";
    position: absolute;
    top: 0;
    inset-inline: clamp(1.25rem, 5vw, 2.5rem);
    border-top: 1px solid var(--border);
  }

  .glyphs {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--s-2);
  }

  .contact-copy {
    display: grid;
    min-width: 0;
    justify-items: start;
  }

  .contact-copy > span {
    color: var(--ink-muted);
    font-size: var(--p-small);
  }

  .contact-email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    max-width: 100%;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .contact-email:hover {
    color: var(--interactive);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .glyph {
    color: var(--ink-muted);
    transition: color 0.2s;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    border-radius: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }

  .glyph:hover,
  .glyph:focus-visible {
    color: var(--interactive);
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }

  :is(.glyph, .contact-email):focus-visible {
    outline: 2px solid var(--interactive);
    outline-offset: 4px;
    border-radius: 0.5rem;
  }

  .admin-glyph {
    font-size: 0.95rem;
  }

  @media (max-width: 720px) {
    .foot {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: var(--s-3);
    }
    .glyphs {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glyph {
      transition: none;
    }
  }
</style>
