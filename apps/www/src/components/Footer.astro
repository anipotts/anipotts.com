---
import { Icon } from "astro-icon/components";
import { siteConfig, siteLinks } from "@anipotts/content/public";
const footerLinks = (["github", "x", "linkedin", "rss", "admin"] as const).map(
  (key) => ({ key, link: siteLinks[key] }),
);
---

<footer id="contact" class="frame foot">
  <div class="contact-copy">
    <span>have a question?</span>
    <a href={siteLinks.email.href} class="quiet-link mono">{siteConfig.email}</a
    >
  </div>
  <nav class="glyphs" aria-label="Social and site links">
    {
      footerLinks.map(({ key, link }) => (
        <a
          href={link.href}
          class:list={["glyph", { "admin-glyph": key === "admin" }]}
          aria-label={link.label}
          title={link.title}
          target={
            ["github", "x", "linkedin"].includes(key) ? "_blank" : undefined
          }
          rel={
            ["github", "x", "linkedin"].includes(key)
              ? "noopener noreferrer"
              : undefined
          }
        >
          <Icon name={link.icon} />
        </a>
      ))
    }
  </nav>
</footer>

<style>
  .foot {
    margin-top: var(--s-8);
    padding-block: var(--s-6);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-5);
    font-size: var(--p-small);
  }

  .glyphs {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--s-2);
  }

  .contact-copy {
    display: grid;
    gap: 0.35rem;
  }

  .glyph {
    color: var(--ink-muted);
    transition: color 0.2s;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }

  .glyph:hover {
    color: var(--interactive);
  }

  .admin-glyph {
    font-size: 0.95rem;
    opacity: 0.78;
  }

  @media (width < 880px) {
    .foot {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: 1rem;
      margin-top: 0;
      padding-block: 1.5rem calc(1.5rem + env(safe-area-inset-bottom, 0px));
    }
    .foot::before {
      content: "";
      position: absolute;
      top: 0;
      inset-inline: clamp(1.25rem, 5vw, 2.5rem);
      border-top: 1px solid var(--border-strong);
    }
    .contact-copy {
      gap: 0;
    }
    .contact-copy > span {
      color: var(--ink-muted);
      font-size: 0.85rem;
    }
    .contact-copy > a {
      display: flex;
      align-items: center;
      width: fit-content;
      max-width: 100%;
      min-height: 44px;
      color: var(--ink);
      font-size: 1.05rem;
      overflow-wrap: anywhere;
    }
    .glyphs {
      display: grid;
      grid-template-columns: repeat(6, minmax(44px, 1fr));
      width: 100%;
      max-width: 22rem;
      gap: 0;
    }
    .glyph {
      width: 100%;
      border-radius: 9px;
      color: var(--ink);
      opacity: 1;
    }
    .glyph:hover,
    .glyph:focus-visible {
      background: color-mix(in srgb, var(--ink) 8%, transparent);
    }
  }
  @media (max-width: 303px) {
    .glyphs {
      grid-template-columns: repeat(3, minmax(44px, 1fr));
    }
  }
</style>
