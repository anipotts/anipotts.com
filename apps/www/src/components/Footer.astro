---
import { Icon } from "astro-icon/components";
import { siteConfig, siteLinks } from "@anipotts/content/public";
import { creatorLinks } from "../lib/identity";
const links = { ...siteLinks, ...creatorLinks };
const footerLinks = (
  ["github", "x", "linkedin", "instagram", "tiktok", "rss", "admin"] as const
).map((key) => ({ key, link: links[key] }));
const externalProfiles = [
  "github",
  "x",
  "linkedin",
  ...Object.keys(creatorLinks),
];
---

<footer id="contact" class="frame foot">
  <div class="contact-copy">
    <span>have a question?</span>
    <a href={siteLinks.email.href} class="contact-email">{siteConfig.email}</a>
  </div>
  <nav class="glyphs" aria-label="Social and site links">
    {
      footerLinks.map(({ key, link }) => (
        <a
          href={link.href}
          class:list={[
            "glyph",
            { "admin-glyph": key === "admin", "rss-glyph": key === "rss" },
          ]}
          aria-label={link.label}
          title={link.title}
          target={externalProfiles.includes(key) ? "_blank" : undefined}
          rel={
            externalProfiles.includes(key) ? "noopener noreferrer" : undefined
          }
        >
          <Icon name={link.icon} />
        </a>
      ))
    }
  </nav>
</footer>

<style>
  .foot {
    position: relative;
    margin-top: 0;
    padding-block: var(--s-5)
      calc(var(--s-5) + env(safe-area-inset-bottom, 0px));
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-5);
    font-size: var(--p-small);
  }

  .glyphs {
    display: flex;
    flex-wrap: nowrap;
    justify-content: flex-end;
    gap: var(--s-2);
  }

  .contact-copy {
    display: grid;
    min-width: 0;
    justify-items: start;
  }

  .contact-copy > span {
    color: var(--ink-muted);
    font-size: var(--p-small);
  }

  .contact-email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    max-width: 100%;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(html:not([data-touch-input])) .contact-email:hover {
      color: var(--interactive);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }

  .glyph {
    color: var(--ink-muted);
    transition: color 0.2s;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    border-radius: var(--card-ui-radius);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }

  .glyph:focus-visible {
    color: var(--interactive);
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(html:not([data-touch-input])) .glyph:hover {
      color: var(--interactive);
      background: color-mix(in srgb, var(--ink) 7%, transparent);
    }
  }

  :is(.glyph, .contact-email):focus-visible {
    outline: var(--focus-width) solid var(--ink);
    outline-offset: var(--focus-offset);
    border-radius: var(--card-ui-radius);
  }

  .admin-glyph {
    font-size: 0.95rem;
  }

  @media (max-width: 720px) {
    .foot {
      gap: 0.5rem;
    }
    .glyphs {
      gap: 0;
    }
    .glyph {
      width: 28px;
      flex-basis: 28px;
      font-size: 1rem;
    }
    .contact-email {
      font-size: 0.8rem;
      white-space: nowrap;
    }
    .contact-copy > span {
      font-size: 0.7rem;
    }
  }
  @media (max-width: 420px) {
    .foot {
      gap: 0.25rem;
    }
    .glyph {
      width: 24px;
      flex-basis: 24px;
      font-size: 0.875rem;
    }
    .contact-email {
      font-size: 0.65rem;
    }
    .contact-copy > span {
      font-size: 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glyph {
      transition: none;
    }
  }
</style>
