---
import { Icon } from "astro-icon/components";
import { siteConfig, siteLinks } from "@anipotts/content/public";
import { creatorLinks } from "../lib/identity";
import BrandMark from "@anipotts/brand/BrandMark.astro";
const links = { ...siteLinks, ...creatorLinks };
const footerLinks = (
  ["github", "x", "linkedin", "instagram", "tiktok", "rss", "admin"] as const
).map((key) => ({ key, link: links[key] }));
const externalProfiles = [
  "github",
  "x",
  "linkedin",
  ...Object.keys(creatorLinks),
];
---

<footer id="contact" class="frame foot">
  <div class="footer-identity">
    <a
      href="/"
      class="wordmark footer-wordmark"
      aria-label="home"
      data-admin-footer-logo
    >
      <BrandMark />
    </a>
    <div class="contact-copy">
      <span>have a question?</span>
      <a href={siteLinks.email.href} class="contact-email">{siteConfig.email}</a
      >
    </div>
  </div>
  <nav class="glyphs" aria-label="Social and site links">
    {
      footerLinks.map(({ key, link }) => (
        <a
          href={link.href}
          class:list={[
            "glyph",
            { "admin-glyph": key === "admin", "rss-glyph": key === "rss" },
          ]}
          aria-label={link.label}
          title={link.title}
          data-admin-enter={key === "admin" ? "" : undefined}
          data-astro-prefetch={key === "admin" ? "hover" : undefined}
          target={externalProfiles.includes(key) ? "_blank" : undefined}
          rel={
            externalProfiles.includes(key) ? "noopener noreferrer" : undefined
          }
        >
          <Icon name={link.icon} />
        </a>
      ))
    }
  </nav>
</footer>

<style>
  .foot {
    position: relative;
    margin-top: 0;
    padding-block: var(--s-5)
      calc(var(--s-3) + env(safe-area-inset-bottom, 0px));
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-5);
    font-size: var(--p-small);
  }

  .glyphs {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--s-2);
  }

  .footer-identity {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-width: 0;
  }

  .footer-wordmark {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    flex: 0 0 52px;
    color: var(--ink);
    text-decoration: none;
  }

  .footer-wordmark :global(.brand-mark) {
    width: 29.696px;
    height: 29.696px;
  }

  .contact-copy {
    display: grid;
    min-width: 0;
    justify-items: start;
  }

  .contact-copy > span {
    color: var(--ink-muted);
    font-size: var(--p-small);
  }

  .contact-email {
    display: inline-flex;
    align-items: flex-start;
    padding-top: 2px;
    min-height: 44px;
    max-width: 100%;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(html:not([data-touch-input])) .contact-email:hover {
      color: var(--interactive);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }

  .glyph {
    color: var(--ink-muted);
    transition: color 0.2s;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    border-radius: var(--card-ui-radius);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }

  .glyph:focus-visible {
    color: var(--interactive);
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(html:not([data-touch-input])) .glyph:hover {
      color: var(--interactive);
      background: color-mix(in srgb, var(--ink) 7%, transparent);
    }
  }

  :is(.glyph, .contact-email, .footer-wordmark):focus-visible {
    outline: var(--focus-width) solid var(--ink);
    outline-offset: var(--focus-offset);
    border-radius: var(--card-ui-radius);
  }

  .admin-glyph {
    font-size: 0.95rem;
  }

  @media (max-width: 720px) {
    .rss-glyph {
      display: none;
    }

    .foot {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      row-gap: 0;
    }
    .glyphs {
      justify-content: flex-start;
      column-gap: 0;
    }
  }

  @media (min-width: 360px) and (max-width: 720px) {
    .glyphs {
      margin-left: calc(52px + var(--s-3) - 12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glyph {
      transition: none;
    }
  }
</style>
