---
import type { SystemsPageContent } from "@anipotts/content/public";
import WorkflowMark from "./WorkflowMark.astro";

interface Props {
  workflow: SystemsPageContent["workflow"];
}
const { workflow } = Astro.props;
---

<figure class="workflow" data-workflow aria-label="How I work with agents">
  <div class="source-panel">
    <div class="source-window">
      <ul class="source-track" aria-label="Everyday sources">
        {
          workflow.sources.map((id) => (
            <li data-source={id}>
              <WorkflowMark id={id} />
            </li>
          ))
        }
      </ul>
    </div>
    <button
      type="button"
      data-motion-toggle
      hidden
      aria-pressed="false"
      aria-label="Pause source animation"
      title="Pause source animation"
    >
      <svg
        class="pause-symbol"
        viewBox="0 0 16 16"
        width="16"
        height="16"
        aria-hidden="true"
        ><path
          d="M5 3v10M11 3v10"
          fill="none"
          stroke="currentColor"
          stroke-width="2"></path></svg
      >
      <svg
        class="play-symbol"
        viewBox="0 0 16 16"
        width="16"
        height="16"
        aria-hidden="true"
        ><path d="m5 3 8 5-8 5Z" fill="currentColor"></path></svg
      >
    </button>
  </div>
  <div class="intake-space" aria-hidden="true">
    <span class="intake-line"></span>
  </div>
  <div class="diagram">
    <div class="step-flow">
      <ol class="steps">
        {
          workflow.steps.map((step) => (
            <li class="step" data-step={step.id}>
              <h2>
                <span>{step.label}</span>
                <span
                  class:list={[
                    "step-mark",
                    { "device-files": step.id === "outcome" },
                  ]}
                  aria-label={
                    step.id === "outcome"
                      ? "Mac mini with GitHub and Linear records"
                      : undefined
                  }
                >
                  {step.marks.map((id) => (
                    <WorkflowMark id={id} grouped={step.id === "outcome"} />
                  ))}
                </span>
              </h2>
              <p>{step.detail}</p>
            </li>
          ))
        }
      </ol>
      <span class="return-route" aria-hidden="true"></span>
    </div>
    <div class="loop-note"><p class="feedback">{workflow.feedback}</p></div>
  </div>
</figure>

<script>
  import { mountWorkflows } from "../scripts/workflow-animation";
  mountWorkflows();
  document.addEventListener("astro:page-load", mountWorkflows);
</script>

<style>
  /* Shared app tiles keep provider marks consistent across steps and the loop. */
  .workflow {
    min-width: 0;
    width: 100%;
    --app-tile-size: 36px;
    --app-tile-bg: linear-gradient(#fff, #f4f4f4);
    --app-tile-border: rgb(0 0 0 / 16%);
    margin: 0;
    position: relative;
  }
  :global([data-theme="dark"]) .workflow {
    --app-tile-bg: linear-gradient(#303130, #111313);
    --app-tile-border: rgb(255 255 255 / 24%);
  }

  .step-flow {
    position: relative;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    position: relative;
    min-width: 0;
    padding: 1.1rem 0;
    border-top: 1px solid var(--border-strong);
  }
  .step h2 {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    min-height: 2.5em;
    font-family: var(--sans);
    font-size: clamp(1.05rem, 1.7vw, 1.35rem);
    font-weight: 650;
    line-height: 1.25;
    margin: 0 0 0.75rem;
    text-wrap: balance;
  }
  .step-mark {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    min-height: 1.2em;
    color: currentColor;
    gap: 0.5rem;
  }
  .device-files {
    gap: 4px;
    padding-inline: 4px;
    width: max-content;
    height: 36px;
    border: 1px solid var(--app-tile-border);
    border-radius: 9px;
    background: var(--app-tile-bg);
    box-sizing: border-box;
  }
  .step p {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-muted);
    margin: 0;
  }
  .step:not(:last-child)::after {
    content: "→";
    position: absolute;
    right: -1.875rem;
    top: -1px;
    width: 1.5rem;
    line-height: 1.5rem;
    text-align: center;
    transform: translateY(-50%);
    color: var(--ink);
  }
  .return-route {
    display: block;
    position: relative;
    height: 1.75rem;
    margin: 0.75rem 12.5% 0;
    border: 1px solid var(--border-strong);
    border-top: 0;
  }
  .return-route::before {
    content: "";
    position: absolute;
    top: 0;
    left: -4px;
    width: 7px;
    height: 7px;
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--ink);
    transform: rotate(45deg);
  }
  .feedback {
    font-size: 0.95rem;
    color: var(--ink-muted);
    margin: 0;
    max-width: 100%;
    text-wrap: pretty;
  }
  .loop-note {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
    text-align: center;
  }
  @media (min-width: 880px) {
    .step {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-block: 2rem;
    }
    .step-flow::after {
      content: "";
      position: absolute;
      top: 0;
      /* Fourth column starts at 75% plus three quarters of the 2.25rem gap. */
      left: calc(75% + 1.6875rem);
      right: 12.5%;
      height: 0.75rem;
      border-top: 1px solid var(--border-strong);
      border-right: 1px solid var(--border-strong);
      pointer-events: none;
    }
    .step:first-child,
    .step:last-child {
      border-top-color: transparent;
    }
    .step:first-child::before {
      content: "";
      position: absolute;
      top: -1px;
      /* Half the column plus 3/8 of the grid gap meets the 12.5% intake. */
      left: calc(50% + 0.84375rem);
      right: 0;
      border-top: 1px solid var(--border-strong);
    }
    .step h2 {
      display: grid;
      grid-template-rows: 2.5em 36px;
      align-items: start;
    }
    .step-mark {
      justify-content: flex-start;
    }
  }
  @media (width < 880px) {
    .workflow {
      --step-inset: 4rem;
      --step-padding: 1.35rem;
      --step-title-size: 1.18rem;
      --step-title-leading: 1.25;
      /* Step border + padding + half the first title's line box. */
      --return-top: calc(
        1px + var(--step-padding) + var(--step-title-size) *
          var(--step-title-leading) / 2
      );
    }
    .diagram {
      position: relative;
    }
    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-left: var(--step-inset);
    }
    .step {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.75rem;
      padding: var(--step-padding) 0;
      text-align: center;
    }
    .step h2 {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 0.75rem;
      min-height: 0;
      font-size: var(--step-title-size);
      line-height: var(--step-title-leading);
      margin: 0;
      text-wrap: initial;
    }
    .step:first-child {
      border-top-color: transparent;
    }
    .step:first-child::before {
      content: "";
      position: absolute;
      top: -1px;
      left: 50%;
      right: 0;
      border-top: 1px solid var(--border-strong);
    }
    .step:not(:last-child)::after {
      content: none;
    }
    .step + .step {
      border-top-color: transparent;
    }
    .step + .step::before {
      content: "";
      position: absolute;
      top: -1px;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(
        to right,
        var(--border-strong) 0 calc(50% - 0.75rem),
        transparent calc(50% - 0.75rem) calc(50% + 0.75rem),
        var(--border-strong) calc(50% + 0.75rem)
      );
    }
    .step + .step::after {
      content: "↓";
      right: auto;
      left: 50%;
      top: -1px;
      bottom: auto;
      width: 1.5rem;
      line-height: 1.5rem;
      text-align: center;
      position: absolute;
      color: var(--ink);
      transform: translate(-50%, -50%);
    }
    .return-route {
      position: absolute;
      top: var(--return-top);
      bottom: 0;
      left: 2rem;
      right: calc((100% - var(--step-inset)) / 2);
      width: auto;
      height: auto;
      margin: 0;
      border: 1px solid var(--border-strong);
      border-top: 0;
      border-right: 0;
      pointer-events: none;
    }
    .return-route::before {
      top: -3px;
      left: calc(1.25rem - 7px);
      right: auto;
      transform: rotate(135deg);
    }
    .return-route::after {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 1.25rem;
      border-top: 1px solid var(--border-strong);
    }
    .loop-note {
      position: absolute;
      top: var(--return-top);
      bottom: 0;
      left: 0;
      width: 1.25rem;
      margin: 0;
      place-items: center;
    }
    .feedback {
      max-width: none;
      font-size: 0.8rem;
      line-height: 1.4;
      white-space: nowrap;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
    }
  }

  .source-panel {
    min-width: 0;
    position: relative;
    padding-right: 44px;
  }
  [data-motion-toggle] {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--ink-muted);
    font: inherit;
    cursor: pointer;
  }
  .play-symbol,
  [aria-pressed="true"] .pause-symbol {
    display: none;
  }
  [aria-pressed="true"] .play-symbol {
    display: block;
  }
  .workflow:not([data-animated]) .source-panel {
    padding-right: 0;
  }
  [data-motion-toggle]:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  [hidden] {
    display: none !important;
  }
  .source-window {
    min-width: 0;
    max-width: 100%;
    padding: 12px 0;
  }
  .source-track {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .source-track li {
    display: flex;
    flex: 0 0 36px;
  }
  .workflow[data-animated] .source-window {
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 32px,
      #000 calc(100% - 32px),
      transparent
    );
  }
  .workflow[data-animated] .source-track {
    flex-wrap: nowrap;
    width: max-content;
    will-change: transform;
  }
  .intake-space {
    position: relative;
    height: 3rem;
  }
  .intake-line {
    position: absolute;
    left: 12.5%;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--border-strong);
  }
  @media (width < 880px) {
    .intake-line {
      left: calc((100% + var(--step-inset)) / 2);
    }
    .source-track {
      gap: 18px;
    }
  }
</style>
