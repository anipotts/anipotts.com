---
import InlineText from "./InlineText.astro";
import { Icon } from "astro-icon/components";
import type { Project } from "../lib/content";
import AmbientFlow from "./AmbientFlow.astro";
import ProjectMeta from "./ProjectMeta.astro";

interface Props {
  project: Project;
  variant?: "experience" | "project";
  flowVariant?: number;
}

const { project, variant = project.data.kind, flowVariant } = Astro.props;
const d = project.data;
const slug = project.data.slug ?? project.id;
const identity = d.identity;
const preview = d.preview_media;
---

<a
  href={d.detail_path}
  class:list={[
    "work-card",
    `work-card--${variant}`,
    preview ? "work-card--visual" : "work-card--compact",
  ]}
>
  <AmbientFlow kind="work" seed={slug} variant={flowVariant} />
  {
    preview && (
      <span class="work-card__media landscape-frame">
        {preview.kind === "video" ? (
          <video
            src={preview.src}
            muted
            playsinline
            preload="metadata"
            aria-label={preview.alt}
          />
        ) : (
          <img
            src={preview.src}
            alt={preview.alt}
            loading="lazy"
            decoding="async"
          />
        )}
      </span>
    )
  }
  <span class="work-card__body">
    <span class="work-card__header">
      <span class="work-card__identity">
        <span class="work-card__name">{d.title}</span>
        {
          identity.logo_src ? (
            <img
              class:list={[
                "work-card__mark",
                {
                  "work-card__mark--adaptive":
                    identity.logo_tone === "adaptive",
                },
              ]}
              style={slug === "nyu-purity-test" ? "scale: 1.3" : undefined}
              src={identity.logo_src}
              alt={identity.logo_alt ?? ""}
              loading="lazy"
              decoding="async"
            />
          ) : identity.icon ? (
            <Icon
              name={`ph:${identity.icon}`}
              class="work-card__mark work-card__glyph"
              aria-hidden="true"
            />
          ) : null
        }
      </span>
      <Icon name="ph:arrow-bend-right-up" class="work-card__affordance" />
    </span>
    <span class="work-card__copy"
      ><InlineText text={d.card_copy} links={false} /></span
    >
    {variant === "project" && <ProjectMeta status={d.status} year={d.year} />}
  </span>
</a>

<style>
  .work-card {
    --work-card-mark-size: 1.875rem;
    position: relative;
    isolation: isolate;
    contain: paint;
    display: flex;
    flex-direction: column;
    min-height: 12rem;
    overflow: hidden;
    border-radius: var(--paper-radius);
    background: var(--paper-surface);
    color: var(--paper-ink);
    box-shadow: var(--paper-shadow);
    text-decoration: none;
    transition: background 160ms ease;
  }

  .work-card:hover {
    background: var(--paper-surface-hover);
  }

  .work-card--experience {
    min-height: 13rem;
  }

  .work-card--compact {
    padding: var(--s-5);
  }

  .work-card--visual {
    min-height: 22rem;
    padding: 0;
    background: var(--paper-surface);
    color: var(--paper-ink);
  }

  .work-card--visual:hover {
    background: var(--paper-surface-hover);
  }

  .work-card__media {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    padding: var(--s-4);
    isolation: isolate;
    background: var(--paper-surface-hover);
  }

  .work-card__media :is(img, video) {
    position: relative;
    z-index: 1;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    display: block;
    object-fit: contain;
    object-position: center;
    border-radius: var(--radius-desktop-ui-media);
  }

  .work-card__body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    height: 100%;
    justify-content: center;
  }

  .work-card--visual .work-card__body {
    flex: 1;
    height: auto;
    min-height: 8rem;
    padding: var(--s-4) var(--s-5) var(--s-5);
    background: transparent;
  }

  .work-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .work-card__identity {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-width: 0;
    width: fit-content;
  }

  .work-card__name {
    font-family: var(--display);
    font-size: clamp(1rem, 2vw, var(--p-h2));
    font-weight: 900;
    line-height: 1;
    font-synthesis: none;
    overflow-wrap: anywhere;
  }

  .work-card__mark {
    width: var(--work-card-mark-size);
    height: var(--work-card-mark-size);
    flex: 0 0 var(--work-card-mark-size);
    background: transparent;
    object-fit: contain;
    border-radius: 0.25rem;
  }

  .work-card__mark--adaptive {
    filter: brightness(0);
  }

  :global(html[data-theme="dark"]) .work-card__mark--adaptive {
    filter: brightness(0) invert(1);
  }

  .work-card__glyph {
    color: var(--paper-muted);
  }

  .work-card__copy {
    max-width: none;
    color: var(--paper-muted);
    font-size: var(--p-small);
    line-height: 1.45;
  }

  .work-card--visual .work-card__copy,
  .work-card--visual .work-card__affordance,
  .work-card--visual .work-card__glyph {
    color: var(--paper-muted);
  }

  .work-card--visual:hover .work-card__affordance,
  .work-card--visual:focus-visible .work-card__affordance {
    color: var(--paper-accent);
  }

  .work-card__affordance {
    flex: 0 0 auto;
    color: var(--paper-muted);
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .work-card:hover .work-card__affordance,
  .work-card:focus-visible .work-card__affordance {
    color: var(--paper-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card,
    .work-card__affordance {
      transition: none;
    }

    .work-card:hover {
      transform: none;
    }
  }
</style>
