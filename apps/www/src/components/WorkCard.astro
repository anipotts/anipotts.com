---
import InlineText from "./InlineText.astro";
import CardAction from "./CardAction.astro";
import type { Project } from "../lib/content";
import AmbientFlow from "./AmbientFlow.astro";
import ProjectMeta from "./ProjectMeta.astro";
import { phoneMedia, responsiveScreenshot } from "../lib/responsive-image";

interface Props {
  project: Project;
  variant?: "experience" | "project";
  flowVariant?: number;
  /** The first preview on a page is its likely lcp element. */
  priority?: boolean;
}

const {
  project,
  variant = project.data.kind,
  flowVariant,
  priority = false,
} = Astro.props;
const d = project.data;
const slug = project.data.slug ?? project.id;
const identity = d.identity;
const preview = d.preview_media;
const shot =
  preview?.kind === "video"
    ? undefined
    : responsiveScreenshot(preview?.src ?? "");
// Column width upper bound: one column up to 52rem, then 26rem tracks. The
// image is width: auto, so it never renders wider than this value; the
// single-column bound stays the full viewport rather than a gutter estimate.
const shotSizes = "(max-width: 52rem) 100vw, 26rem";
---

<a
  href={d.detail_path}
  class:list={[
    "work-card",
    `work-card--${variant}`,
    preview ? "work-card--visual" : "work-card--compact",
  ]}
>
  <AmbientFlow kind="work" seed={slug} variant={flowVariant} />
  {
    preview && (
      <span class="work-card__media landscape-frame">
        {preview.kind === "video" ? (
          <video
            src={preview.src}
            muted
            playsinline
            preload="metadata"
            aria-label={preview.alt}
          />
        ) : shot ? (
          <picture>
            <source media={phoneMedia} srcset={shot.src} />
            <img
              src={shot.src}
              srcset={shot.srcset}
              sizes={shotSizes}
              width={shot.width}
              height={shot.height}
              style={`aspect-ratio: ${shot.aspectRatio}`}
              alt={preview.alt}
              loading={priority ? "eager" : "lazy"}
              fetchpriority={priority ? "high" : undefined}
              decoding="async"
            />
          </picture>
        ) : (
          <img
            src={preview.src}
            alt={preview.alt}
            loading={priority ? "eager" : "lazy"}
            fetchpriority={priority ? "high" : undefined}
            decoding="async"
          />
        )}
      </span>
    )
  }
  <span class="work-card__body">
    <span class="work-card__header">
      <span class="work-card__name">{d.title}</span>
      <CardAction
        label="view project"
        logoSrc={identity.logo_src}
        icon={identity.icon}
        adaptive={identity.logo_tone === "adaptive" ||
          slug === "pgi-research-platform"}
      />
    </span>
    <span class="work-card__copy"
      ><InlineText text={d.card_copy} links={false} /></span
    >
    {variant === "project" && <ProjectMeta status={d.status} year={d.year} />}
  </span>
</a>

<style>
  .work-card {
    position: relative;
    isolation: isolate;
    contain: paint;
    display: flex;
    flex-direction: column;
    min-height: 12rem;
    overflow: hidden;
    border-radius: var(--paper-radius);
    background: var(--paper-surface);
    color: var(--paper-ink);
    box-shadow: var(--paper-shadow);
    text-decoration: none;
    transition: background 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .work-card:hover {
      background: var(--paper-surface-hover);
    }
  }

  /* Scoped so the press ring outranks the card's own resting box-shadow. */
  @media (width < 880px), (pointer: coarse) {
    .work-card:active {
      background: var(--paper-surface-hover);
      box-shadow: inset 0 0 0 2px var(--paper-accent);
    }
  }

  .work-card--experience {
    min-height: 13rem;
  }

  .work-card--compact {
    padding: var(--s-5);
  }

  .work-card--visual {
    min-height: 22rem;
    padding: 0;
    background: var(--paper-surface);
    color: var(--paper-ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .work-card--visual:hover {
      background: var(--paper-surface-hover);
    }
  }

  .work-card__media {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    padding: var(--s-4);
    isolation: isolate;
    background: var(--paper-surface-hover);
  }

  .work-card__media picture {
    display: contents;
  }

  .work-card__media :is(img, video) {
    position: relative;
    z-index: 1;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    display: block;
    object-fit: contain;
    object-position: center;
    border-radius: var(--radius-desktop-ui-media);
  }

  .work-card__body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    height: 100%;
    justify-content: flex-start;
  }

  .work-card--visual .work-card__body {
    flex: 1;
    height: auto;
    min-height: 8rem;
    padding: var(--s-4) var(--s-5) var(--s-5);
    background: transparent;
  }

  .work-card__name {
    font-family: var(--display);
    font-size: clamp(1rem, 2vw, var(--p-h2));
    font-weight: 900;
    line-height: 1;
    font-synthesis: none;
    overflow-wrap: anywhere;
  }

  .work-card__copy {
    max-width: none;
    color: var(--paper-muted);
    font-size: var(--p-small);
    line-height: 1.45;
  }
</style>
