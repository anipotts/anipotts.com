---
import InlineText from "./InlineText.astro";
import CardAction from "./CardAction.astro";
import type { Project } from "../lib/content";
import AmbientFlow from "./AmbientFlow.astro";
import ProjectMeta from "./ProjectMeta.astro";
import { phoneMedia, responsiveScreenshot } from "../lib/responsive-image";

interface Props {
  project: Project;
  variant?: "experience" | "project";
  flowVariant?: number;
  /** The first preview on a page is its likely lcp element. */
  priority?: boolean;
}

const {
  project,
  variant = project.data.kind,
  flowVariant,
  priority = false,
} = Astro.props;
const d = project.data;
const displayTitle =
  (project.data.slug ?? project.id) === "agents"
    ? "coding agent tips"
    : d.title;
const slug = project.data.slug ?? project.id;
const identity = d.identity;
const preview = d.preview_media;
const shot =
  preview?.kind === "video"
    ? undefined
    : responsiveScreenshot(preview?.src ?? "");
// Column width upper bound: one column up to 52rem, then 26rem tracks. The
// image is width: auto, so it never renders wider than this value; the
// single-column bound stays the full viewport rather than a gutter estimate.
const shotSizes = "(max-width: 52rem) 100vw, 26rem";
---

<a
  href={d.detail_path}
  class:list={[
    "work-card",
    `work-card--${variant}`,
    preview ? "work-card--visual" : "work-card--compact",
  ]}
>
  <AmbientFlow kind="work" seed={slug} variant={flowVariant} />
  {
    preview && (
      <span class="work-card__media landscape-frame">
        <span class="work-card__window">
          {preview.kind === "video" ? (
            <video
              src={preview.src}
              muted
              playsinline
              preload="metadata"
              aria-label={preview.alt}
            />
          ) : shot ? (
            <picture>
              <source media={phoneMedia} srcset={shot.src} />
              <img
                src={shot.src}
                srcset={shot.srcset}
                sizes={shotSizes}
                width={shot.width}
                height={shot.height}
                style={`aspect-ratio: ${shot.aspectRatio}`}
                alt={preview.alt}
                loading={priority ? "eager" : "lazy"}
                fetchpriority={priority ? "high" : undefined}
                decoding="async"
              />
            </picture>
          ) : (
            <img
              src={preview.src}
              alt={preview.alt}
              loading={priority ? "eager" : "lazy"}
              fetchpriority={priority ? "high" : undefined}
              decoding="async"
            />
          )}
        </span>
      </span>
    )
  }
  <span class="work-card__body">
    <span class="work-card__header">
      <span class="card-title-group">
        <span class="work-card__name">{displayTitle}</span>
        {
          variant === "project" && (
            <ProjectMeta status={d.status} year={d.year} inline />
          )
        }
      </span>
      <CardAction
        label="view project"
        largeMark={["nyu-purity-test", "pgi-research-platform"].includes(slug)}
        logoSrc={identity.logo_src}
        icon={identity.icon}
        adaptive={identity.logo_tone === "adaptive" ||
          slug === "pgi-research-platform"}
      />
    </span>
    <span class="work-card__copy"
      ><InlineText text={d.card_copy} links={false} /></span
    >
  </span>
</a>

<style>
  .work-card {
    position: relative;
    isolation: isolate;
    contain: paint;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--paper-radius);
    background: var(--paper-surface);
    color: var(--paper-ink);
    box-shadow: var(--paper-shadow);
    text-decoration: none;
    transition: background 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .work-card:hover {
      background: var(--paper-surface-hover);
    }
  }

  /* Scoped so the press ring outranks the card's own resting box-shadow. */
  @media (width < 880px), (pointer: coarse) {
    .work-card:active {
      background: var(--paper-surface-hover);
      box-shadow: inset 0 0 0 2px var(--paper-accent);
    }
  }

  .work-card--compact {
    padding: var(--card-inset);
  }

  .work-card--visual {
    padding: 0;
    background: var(--paper-surface);
    color: var(--paper-ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .work-card--visual:hover {
      background: var(--paper-surface-hover);
    }
  }

  .work-card__media {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    overflow: hidden;
    padding: var(--card-inset);
    padding-bottom: var(--s-2);
    isolation: isolate;
    background: var(--paper-surface-hover);
  }

  .work-card__window {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-desktop-ui-media);
  }

  .work-card__media picture {
    display: contents;
  }

  .work-card__media :is(img, video) {
    position: relative;
    z-index: 1;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    display: block;
    object-fit: contain;
    object-position: center;
    border-radius: var(--radius-desktop-ui-media);
  }

  .work-card__body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--card-content-gap);
    height: 100%;
    justify-content: flex-start;
  }

  .work-card--visual .work-card__body {
    flex: 1;
    height: auto;
    padding: var(--card-content-gap) var(--card-inset) var(--card-inset);
    background: transparent;
  }

  .work-card__name {
    font-family: var(--display);
    font-size: var(--card-title-size);
    font-weight: var(--card-title-weight);
    line-height: 1.12;
    font-synthesis: none;
    overflow-wrap: anywhere;
  }

  .work-card__copy {
    max-width: none;
    color: var(--paper-muted);
    font-size: var(--card-copy-size);
    font-weight: var(--card-copy-weight);
    line-height: var(--card-copy-leading);
  }
</style>
