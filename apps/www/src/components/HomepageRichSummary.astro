---
import InlineText from "./InlineText.astro";
import InlineMention from "./InlineMention.astro";
import {
  segmentHomepageSummaryParagraph,
  type HomepageMention,
} from "@anipotts/content/public";

interface Props {
  text: string;
  format?: "markdown";
  mentionKeys: string[];
  mentions: Record<string, HomepageMention>;
}

const { text, format, mentionKeys, mentions } = Astro.props;
const segments = segmentHomepageSummaryParagraph(text, mentionKeys, mentions);
---

{
  format === "markdown" || /!?\[[^\]]*\]\(/u.test(text) ? (
    <InlineText text={text} />
  ) : (
    segments.map((segment) =>
      segment.kind === "text" ? (
        segment.text
      ) : (
        <InlineMention
          {...mentions[segment.key]}
          label={segment.text}
          suffix={segment.suffix}
        />
      ),
    )
  )
}
