---
import InlineMention from "./InlineMention.astro";
import type {
  HomepageMention,
  HomepageRichSummarySegment,
  HomepageRichSummarySentence,
  HomepageRichSummarySimpleSegment,
} from "@anipotts/content/public";

interface Props {
  sentences: HomepageRichSummarySentence[];
  mentions: Record<string, HomepageMention>;
}

const { sentences, mentions: mentionMap } = Astro.props;

function mentionProps(key: string) {
  return Object.prototype.hasOwnProperty.call(mentionMap, key)
    ? mentionMap[key]
    : null;
}

function isText(segment: HomepageRichSummarySegment): segment is {
  kind: "text";
  text: string;
} {
  return segment.kind === "text";
}

function isMention(segment: HomepageRichSummarySegment): segment is {
  kind: "mention";
  key: string;
  suffix?: string;
} {
  return segment.kind === "mention";
}
---

{
  sentences.map((sentence: HomepageRichSummarySentence, index: number) => (
    <>
      {sentence.segments.map((segment: HomepageRichSummarySegment) => (
        <>
          {isText(segment) && segment.text}
          {isMention(segment) &&
            (() => {
              const props = mentionProps(segment.key);
              return props ? (
                <InlineMention {...props} suffix={segment.suffix} />
              ) : (
                `${segment.key}${segment.suffix ?? ""}`
              );
            })()}
          {segment.kind === "cluster" && (
            <span class="mention-cluster">
              {segment.segments.map((child: HomepageRichSummarySegment) => (
                <>
                  {isText(child) && child.text}
                  {isMention(child) &&
                    (() => {
                      const props = mentionProps(child.key);
                      return props ? (
                        <InlineMention {...props} suffix={child.suffix} />
                      ) : (
                        `${child.key}${child.suffix ?? ""}`
                      );
                    })()}
                  {child.kind === "parens" && (
                    <span class="brand-parens">
                      <span>(</span>
                      {child.segments.map(
                        (parenChild: HomepageRichSummarySimpleSegment) => (
                          <>
                            {parenChild.kind === "text" && parenChild.text}
                            {parenChild.kind === "mention" &&
                              (() => {
                                const props = mentionProps(parenChild.key);
                                return props ? (
                                  <InlineMention
                                    {...props}
                                    suffix={parenChild.suffix}
                                  />
                                ) : (
                                  `${parenChild.key}${parenChild.suffix ?? ""}`
                                );
                              })()}
                          </>
                        ),
                      )}
                      <span>)</span>
                    </span>
                  )}
                </>
              ))}
            </span>
          )}
          {segment.kind === "parens" && (
            <span class="brand-parens">
              <span>(</span>
              {segment.segments.map(
                (child: HomepageRichSummarySimpleSegment) => (
                  <>
                    {child.kind === "text" && child.text}
                    {child.kind === "mention" &&
                      (() => {
                        const props = mentionProps(child.key);
                        return props ? (
                          <InlineMention {...props} suffix={child.suffix} />
                        ) : (
                          `${child.key}${child.suffix ?? ""}`
                        );
                      })()}
                  </>
                ),
              )}
              <span>)</span>
            </span>
          )}
        </>
      ))}
      {index < sentences.length - 1 && " "}
    </>
  ))
}
