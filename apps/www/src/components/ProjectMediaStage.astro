---
import { Icon } from "astro-icon/components";

interface MediaItem {
  kind: "image" | "gif" | "video";
  src: string;
  alt: string;
  caption?: string;
  fit?: "cover" | "contain";
}

interface Props {
  items: MediaItem[];
  label: string;
}

const { items, label } = Astro.props;
const stageId = `project-media-${label.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

{
  items.length > 0 && (
    <figure
      class="project-media"
      data-project-media
      style={`--media-count: ${items.length}`}
    >
      <div class="project-media__stage" aria-live="polite">
        {items.map((item, index) => (
          <div
            class="project-media__panel"
            id={`${stageId}-panel-${index}`}
            data-media-panel={index}
            data-media-fit={item.fit ?? "cover"}
            hidden={index !== 0}
          >
            {item.kind === "video" ? (
              <video
                controls
                muted
                playsinline
                preload="metadata"
                aria-label={item.alt}
              >
                <source src={item.src} />
              </video>
            ) : (
              <img
                src={item.src}
                alt={item.alt}
                loading={index === 0 ? "eager" : "lazy"}
              />
            )}
          </div>
        ))}
      </div>

      {items.length > 1 && (
        <div
          class="project-media__rail"
          role="tablist"
          aria-label={`${label} views`}
        >
          {items.map((item, index) => (
            <button
              type="button"
              class="project-media__choice"
              role="tab"
              aria-controls={`${stageId}-panel-${index}`}
              aria-selected={index === 0 ? "true" : "false"}
              aria-label={`show ${item.caption ?? item.alt}`}
              data-media-choice={index}
              data-media-caption={item.caption ?? item.alt}
            >
              {item.kind === "video" ? (
                <span class="project-media__video-icon" aria-hidden="true">
                  <Icon name="ph:play" />
                </span>
              ) : (
                <img src={item.src} alt="" loading="lazy" />
              )}
              <span>{item.caption ?? `view ${index + 1}`}</span>
            </button>
          ))}
        </div>
      )}

      <figcaption data-media-figcaption>
        {items[0]?.caption ?? items[0]?.alt}
      </figcaption>
    </figure>
  )
}

<script is:inline>
  document.querySelectorAll("[data-project-media]").forEach((stage) => {
    const panels = [...stage.querySelectorAll("[data-media-panel]")];
    const choices = [...stage.querySelectorAll("[data-media-choice]")];
    const caption = stage.querySelector("[data-media-figcaption]");

    choices.forEach((choice, index) => {
      choice.addEventListener("click", () => {
        panels.forEach((panel, panelIndex) => {
          panel.hidden = panelIndex !== index;
        });
        choices.forEach((candidate, choiceIndex) => {
          candidate.setAttribute(
            "aria-selected",
            choiceIndex === index ? "true" : "false",
          );
        });
        if (caption) {
          caption.textContent = choice.getAttribute("data-media-caption") ?? "";
        }
      });
    });
  });
</script>

<style>
  .project-media {
    margin: 0;
    display: grid;
    gap: var(--s-3);
  }

  .project-media__stage {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--surface);
    border-radius: 1rem;
    overflow: hidden;
  }

  .project-media__panel {
    position: absolute;
    inset: 0;
    padding: clamp(0.75rem, 2vw, 1.5rem);
  }

  .project-media__panel:not([hidden]) {
    animation: media-in 160ms ease-out both;
  }

  .project-media__panel[hidden] {
    display: none;
  }

  .project-media__panel img,
  .project-media__panel video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: var(--radius-desktop-ui-media);
    background: #f7faff;
  }

  .project-media__panel[data-media-fit="contain"] img,
  .project-media__panel[data-media-fit="contain"] video {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .project-media__panel[data-media-fit="contain"] {
    display: grid;
    place-items: center;
  }

  .project-media__rail {
    display: grid;
    grid-template-columns: repeat(var(--media-count), minmax(0, 1fr));
    gap: var(--s-2);
  }

  .project-media__choice {
    min-width: 0;
    min-height: 64px;
    border: 0;
    border-radius: 0.65rem;
    padding: var(--s-2);
    background: var(--surface);
    color: var(--ink-muted);
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    align-items: center;
    gap: var(--s-2);
    text-align: left;
    font: inherit;
    cursor: pointer;
    transition:
      background 160ms ease,
      color 160ms ease;
  }

  .project-media__choice[aria-selected="true"] {
    background: color-mix(in srgb, var(--surface) 78%, var(--interactive) 22%);
    color: var(--ink);
  }

  .project-media__choice img,
  .project-media__video-icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 2.4rem;
    border-radius: 0.4rem;
    object-fit: cover;
    background: var(--bg);
  }

  .project-media__choice span:last-child {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-height: 1.2;
    font-size: var(--p-small);
    font-weight: 600;
  }

  figcaption {
    color: var(--ink-muted);
    font-size: var(--p-small);
  }

  @keyframes media-in {
    from {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-media__panel:not([hidden]) {
      animation: none;
    }

    .project-media__choice {
      transition: none;
    }
  }

  @media (max-width: 40rem) {
    .project-media__stage {
      border-radius: 0.75rem;
    }

    .project-media__rail {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: var(--s-1);
    }

    .project-media__choice {
      flex: 0 0 min(15rem, 78vw);
      scroll-snap-align: start;
    }
  }
</style>
