---
interface MediaItem {
  kind: "image" | "gif" | "video";
  src: string;
  alt: string;
  caption?: string;
  fit?: "cover" | "contain";
}

interface Props {
  items: MediaItem[];
  label: string;
  eager?: boolean;
}

const { items, label, eager = false } = Astro.props;
const stageId = `project-media-${label.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

{
  items.length > 0 && (
    <figure class="project-media" data-project-media>
      <div class="project-media__stage">
        {items.map((item, index) => (
          <div
            class="project-media__panel"
            id={`${stageId}-panel-${index}`}
            data-media-panel={index}
            hidden={index !== 0}
          >
            {item.kind === "video" ? (
              <video
                controls
                playsinline
                preload="metadata"
                aria-label={item.alt}
              >
                <source src={item.src} />
              </video>
            ) : (
              <a
                class="project-media__enlarge"
                href={item.src}
                target="_blank"
                rel="noopener noreferrer"
                data-media-enlarge
                data-media-alt={item.alt}
                aria-label={`enlarge image: ${item.alt}`}
              >
                <img
                  src={item.src}
                  alt={item.alt}
                  loading={eager && index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
                <span class="project-media__hint" aria-hidden="true">
                  enlarge ↗
                </span>
              </a>
            )}
          </div>
        ))}
      </div>

      {items.length > 1 && (
        <div class="project-media__rail" aria-label={`${label} views`}>
          {items.map((item, index) => (
            <button
              type="button"
              class="project-media__choice"
              aria-controls={`${stageId}-panel-${index}`}
              aria-pressed={index === 0 ? "true" : "false"}
              data-media-choice={index}
              data-media-caption={item.caption ?? item.alt}
            >
              {item.caption ?? `view ${index + 1}`}
            </button>
          ))}
        </div>
      )}

      <figcaption data-media-figcaption>
        {items[0]?.caption ?? items[0]?.alt}
      </figcaption>

      {items.some((item) => item.kind !== "video") && (
        <dialog
          class="image-viewer"
          data-image-viewer
          aria-label="enlarged project image"
        >
          <div class="image-viewer__toolbar">
            <button type="button" data-image-zoom aria-pressed="false">
              actual size
            </button>
            <a
              href={items[0]?.src}
              target="_blank"
              rel="noopener noreferrer"
              data-image-original
            >
              open original ↗
            </a>
            <button type="button" data-image-close autofocus>
              close
            </button>
          </div>
          <div
            class="image-viewer__canvas"
            tabindex="0"
            aria-label="image, scroll to inspect at actual size"
          >
            <img data-viewer-image alt="" />
          </div>
          <p class="image-viewer__description" data-image-description />
        </dialog>
      )}
    </figure>
  )
}

<script>
  function mount() {
    document
      .querySelectorAll<HTMLElement>("[data-project-media]")
      .forEach((stage) => {
        if (stage.dataset.mounted) return;
        stage.dataset.mounted = "true";
        const panels = [
          ...stage.querySelectorAll<HTMLElement>("[data-media-panel]"),
        ];
        const choices = [
          ...stage.querySelectorAll<HTMLButtonElement>("[data-media-choice]"),
        ];
        const caption = stage.querySelector("[data-media-figcaption]");

        choices.forEach((choice, index) => {
          choice.addEventListener("click", () => {
            panels.forEach((panel, panelIndex) => {
              panel.hidden = panelIndex !== index;
              if (panel.hidden) panel.querySelector("video")?.pause();
            });
            choices.forEach((candidate, choiceIndex) => {
              candidate.setAttribute(
                "aria-pressed",
                String(choiceIndex === index),
              );
            });
            if (caption)
              caption.textContent = choice.dataset.mediaCaption ?? "";
          });
        });

        const dialog = stage.querySelector<HTMLDialogElement>(
          "[data-image-viewer]",
        );
        const image = dialog?.querySelector<HTMLImageElement>(
          "[data-viewer-image]",
        );
        const zoom =
          dialog?.querySelector<HTMLButtonElement>("[data-image-zoom]");
        const original = dialog?.querySelector<HTMLAnchorElement>(
          "[data-image-original]",
        );
        const description = dialog?.querySelector("[data-image-description]");
        const canvas = dialog?.querySelector<HTMLElement>(
          ".image-viewer__canvas",
        );
        if (!dialog || !image || !zoom || !original || !canvas) return;

        stage
          .querySelectorAll<HTMLAnchorElement>("[data-media-enlarge]")
          .forEach((link) => {
            link.addEventListener("click", (event) => {
              if (
                event.metaKey ||
                event.ctrlKey ||
                event.shiftKey ||
                event.altKey
              )
                return;
              if (typeof dialog.showModal !== "function") return;
              event.preventDefault();
              image.src = link.href;
              image.alt = link.dataset.mediaAlt ?? "";
              original.href = link.href;
              if (description) description.textContent = image.alt;
              dialog.dataset.zoomed = "false";
              zoom.setAttribute("aria-pressed", "false");
              zoom.textContent = "actual size";
              dialog.showModal();
              canvas.scrollTo(0, 0);
            });
          });

        zoom.addEventListener("click", () => {
          const zoomed = dialog.dataset.zoomed !== "true";
          dialog.dataset.zoomed = String(zoomed);
          zoom.setAttribute("aria-pressed", String(zoomed));
          zoom.textContent = zoomed ? "fit image" : "actual size";
          canvas.scrollTo(0, 0);
          canvas.focus();
        });
        dialog
          .querySelector("[data-image-close]")
          ?.addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", (event) => {
          if (event.target !== dialog) return;
          const box = dialog.getBoundingClientRect();
          if (
            event.clientX < box.left ||
            event.clientX > box.right ||
            event.clientY < box.top ||
            event.clientY > box.bottom
          )
            dialog.close();
        });
      });
  }
  mount();
  document.addEventListener("astro:page-load", mount);
</script>

<style>
  .project-media {
    margin: 0;
    display: grid;
    gap: 0.85rem;
    color: var(--paper-ink);
  }

  .project-media__stage {
    border: 1px solid color-mix(in srgb, var(--paper-ink) 12%, transparent);
    border-radius: 1rem;
    padding: clamp(0.5rem, 1.8vw, 1.25rem);
    background: color-mix(in srgb, var(--paper-ink) 4%, var(--paper-surface));
  }

  .project-media__panel[hidden] {
    display: none;
  }

  .project-media__panel img,
  .project-media__panel video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-desktop-ui-media);
  }

  .project-media__enlarge {
    position: relative;
    display: block;
    border-radius: var(--radius-desktop-ui-media);
    cursor: zoom-in;
  }

  .project-media__hint {
    position: absolute;
    right: 0.65rem;
    bottom: 0.65rem;
    padding: 0.35rem 0.65rem;
    border-radius: 0.35rem;
    background: var(--paper-surface);
    color: var(--paper-ink);
    box-shadow: 0 1px 8px rgb(0 0 0 / 15%);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .project-media__rail {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-media__choice {
    border: 1px solid color-mix(in srgb, var(--paper-ink) 18%, transparent);
    border-radius: 0.4rem;
    padding: 0.5rem 0.75rem;
    min-height: 44px;
    background: transparent;
    color: var(--paper-muted);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .project-media__choice[aria-pressed="true"] {
    color: var(--paper-ink);
    background: color-mix(
      in srgb,
      var(--paper-accent) 10%,
      var(--paper-surface)
    );
    border-color: var(--paper-accent);
  }

  figcaption {
    max-width: 65ch;
    color: var(--paper-muted);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .image-viewer {
    width: min(96vw, 90rem);
    max-width: calc(100% - 1rem);
    max-height: calc(100dvh - 2rem);
    padding: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--paper-ink) 15%, transparent);
    border-radius: 0.8rem;
    color: var(--paper-ink);
    background: var(--paper-surface);
    overflow: auto;
  }

  .image-viewer::backdrop {
    background: rgb(0 0 0 / 78%);
  }

  .image-viewer__toolbar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    padding-bottom: 0.5rem;
  }

  .image-viewer__toolbar button,
  .image-viewer__toolbar a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.4rem 0.55rem;
    background: transparent;
    color: inherit;
    border: 0;
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .image-viewer__toolbar [data-image-close] {
    margin-left: auto;
  }

  .image-viewer__canvas {
    overflow: auto;
    overscroll-behavior: contain;
    max-height: 72dvh;
  }

  .image-viewer__canvas img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 72dvh;
    margin-inline: auto;
    object-fit: contain;
  }

  .image-viewer[data-zoomed="true"] .image-viewer__canvas img {
    max-width: none;
    max-height: none;
  }

  .image-viewer__description {
    margin: 0.75rem 0 0;
    color: var(--paper-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }
</style>
