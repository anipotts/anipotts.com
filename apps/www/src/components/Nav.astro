---
import { Icon } from "astro-icon/components";
import { navItems } from "../data/site";

const current = Astro.url.pathname;
---

<header class="frame nav">
  <a href="/" class="wordmark" aria-label="home">
    <img
      class="brand-mark brand-mark-light"
      src="/brand/favicon-light.svg?v=20260717a"
      width="48"
      height="48"
      alt=""
    />
    <img
      class="brand-mark brand-mark-dark"
      src="/brand/favicon-dark.svg?v=20260717a"
      width="48"
      height="48"
      alt=""
    />
  </a>
  <nav
    id="primary-nav"
    class="primary-nav"
    aria-label="primary"
    data-open="false"
  >
    <span class="nav-links">
      {
        navItems.map((item) => (
          <a
            href={item.path}
            class="nav-link"
            aria-current={
              current === item.path || current.startsWith(`${item.path}/`)
                ? "page"
                : undefined
            }
          >
            {item.name}
          </a>
        ))
      }
    </span>
  </nav>
  <button
    id="theme-toggle"
    class="theme-toggle"
    type="button"
    aria-pressed="false"
    aria-label="toggle theme"
  >
    <Icon name="ph:circle-half" />
  </button>
  <button
    id="nav-toggle"
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="primary-nav"
    aria-label="toggle navigation"
  >
    <span></span>
    <span></span>
  </button>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    padding-block: var(--s-4);
    margin-bottom: var(--s-6);
  }

  .wordmark {
    text-decoration: none;
    margin-right: auto;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .brand-mark {
    display: block;
    width: 4rem;
    height: 4rem;
  }

  .brand-mark-dark {
    display: none;
  }

  :global(html[data-theme="dark"]) .brand-mark-light {
    display: none;
  }

  :global(html[data-theme="dark"]) .brand-mark-dark {
    display: block;
  }

  .primary-nav {
    display: flex;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-4);
  }

  .nav-link {
    font-size: var(--p-small);
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 0.2s;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--accent);
  }

  .theme-toggle {
    background: none;
    border: 0;
    color: var(--ink-muted);
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    transition: color 0.2s;
  }

  .theme-toggle:hover {
    color: var(--accent);
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.36rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    width: 1.25rem;
    height: 1px;
    background: currentColor;
    transition:
      transform 180ms cubic-bezier(0.2, 0.7, 0.2, 1),
      color 180ms ease;
  }

  .nav-toggle:hover {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .nav {
      position: sticky;
      top: 0;
      z-index: 20;
      flex-wrap: wrap;
      gap: var(--s-2);
      padding-block: var(--s-3);
      margin-bottom: var(--s-5);
      background: color-mix(in srgb, var(--bg) 92%, transparent);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .brand-mark {
      width: 3.5rem;
      height: 3.5rem;
    }

    .theme-toggle {
      margin-left: auto;
    }

    .nav-toggle {
      display: inline-flex;
    }

    .primary-nav {
      order: 4;
      display: grid;
      grid-template-rows: 0fr;
      width: 100%;
      opacity: 0;
      transform: translateY(-0.35rem);
      transition:
        grid-template-rows 220ms cubic-bezier(0.2, 0.7, 0.2, 1),
        opacity 160ms ease,
        transform 220ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .primary-nav[data-open="true"] {
      grid-template-rows: 1fr;
      opacity: 1;
      transform: none;
    }

    .nav-links {
      min-height: 0;
      overflow: hidden;
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
    }

    .primary-nav[data-open="true"] .nav-links {
      padding-top: var(--s-2);
    }

    .nav-link {
      min-height: 42px;
      border-top: 1px solid var(--border);
    }

    .nav-toggle[aria-expanded="true"] span:first-child {
      transform: translateY(0.215rem) rotate(45deg);
    }

    .nav-toggle[aria-expanded="true"] span:last-child {
      transform: translateY(-0.215rem) rotate(-45deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-nav,
    .nav-toggle span {
      transition: none;
    }
  }
</style>

<script>
  const btn = document.getElementById("theme-toggle");
  const nav = document.getElementById("primary-nav");
  const navToggle = document.getElementById("nav-toggle");
  const setNavOpen = (open: boolean) => {
    nav?.setAttribute("data-open", String(open));
    navToggle?.setAttribute("aria-expanded", String(open));
  };
  const sync = () => {
    btn?.setAttribute(
      "aria-pressed",
      String(document.documentElement.dataset.theme === "dark"),
    );
  };
  sync();
  btn?.addEventListener("click", () => {
    const next =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
    sync();
  });
  navToggle?.addEventListener("click", () => {
    setNavOpen(navToggle.getAttribute("aria-expanded") !== "true");
  });
  nav?.addEventListener("click", (event) => {
    const target = event.target;
    if (target instanceof Element && target.closest("a")) {
      setNavOpen(false);
    }
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setNavOpen(false);
  });
</script>
