---
import { Icon } from "astro-icon/components";
import { navItems } from "@anipotts/content/public";
import BrandMark from "@anipotts/brand/BrandMark.astro";

const current = Astro.url.pathname;
---

<header class="frame nav">
  <a href="/" class="wordmark" aria-label="home">
    <BrandMark />
  </a>
  <nav
    id="primary-nav"
    class="primary-nav"
    aria-label="primary"
    data-open="false"
  >
    <span class="nav-links">
      {
        navItems.map((item) => (
          <a
            href={item.path}
            class="nav-link"
            aria-current={
              current === item.path || current.startsWith(`${item.path}/`)
                ? "page"
                : undefined
            }
          >
            {item.name}
          </a>
        ))
      }
    </span>
  </nav>
  <button
    id="theme-toggle"
    class="theme-toggle"
    type="button"
    aria-pressed="false"
    aria-label="toggle theme"
  >
    <Icon name="ph:circle-half" />
  </button>
  <button
    id="nav-toggle"
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="primary-nav"
    aria-label="toggle navigation"
  >
    <span></span>
    <span></span>
  </button>
</header>

<!-- Runs before paint so a home-link navigation keeps the hovered mark open. -->
<script is:inline>
  (() => {
    const mark = document.querySelector(".wordmark");
    if (!mark) return;
    const key = "ap-hover-continuity";
    const finePointer = matchMedia("(hover: hover) and (pointer: fine)");
    let pointer = null;
    let inside = null;
    const contains = (point) => {
      const rect = mark.getBoundingClientRect();
      return (
        point &&
        point.x >= rect.left &&
        point.x <= rect.right &&
        point.y >= rect.top &&
        point.y <= rect.bottom
      );
    };
    const show = (open) => {
      inside = open;
      if (open) mark.setAttribute("data-hover-continuity", "");
      else mark.removeAttribute("data-hover-continuity");
    };
    const save = () => {
      try {
        if (!finePointer.matches || !pointer) return;
        sessionStorage.setItem(
          key,
          JSON.stringify({
            ...pointer,
            width: innerWidth,
            height: innerHeight,
            time: Date.now(),
          }),
        );
      } catch {
        /* Pointer feedback never depends on storage access. */
      }
    };
    let restored = false;
    try {
      const previous = JSON.parse(sessionStorage.getItem(key) || "null");
      sessionStorage.removeItem(key);
      if (
        finePointer.matches &&
        previous &&
        Date.now() - previous.time < 30000 &&
        previous.width === innerWidth &&
        previous.height === innerHeight
      ) {
        pointer = previous;
        show(contains(previous));
        if (inside) mark.setAttribute("data-hover-restored", "");
        restored = true;
      }
    } catch {
      /* Storage is optional; native CSS hover remains available. */
    }
    // Embedded browsers may not recompute :hover until the mouse moves.
    // With no usable position on reload, start open until a real pointer event.
    if (
      !restored &&
      finePointer.matches &&
      performance.getEntriesByType("navigation")[0]?.type === "reload"
    ) {
      show(true);
      mark.setAttribute("data-hover-restored", "");
    }
    const track = (event) => {
      if (!finePointer.matches || event.pointerType === "touch") return;
      pointer = { x: event.clientX, y: event.clientY };
      mark.removeAttribute("data-hover-restored");
      const next = contains(pointer);
      const changed = next !== inside;
      show(next);
      // Save on boundary crossing and before a click, not on every mouse frame.
      if (changed || event.type === "pointerdown") save();
    };
    document.addEventListener("pointermove", track, { passive: true });
    document.addEventListener("pointerdown", track, {
      passive: true,
      capture: true,
    });
    window.addEventListener("resize", () => {
      show(finePointer.matches && !!contains(pointer));
      save();
    });
    finePointer.addEventListener("change", () => show(false));
    // Blur/leave events during document replacement are not pointer movement.
    window.addEventListener("pagehide", save);
  })();
</script>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    padding-block: var(--s-4);
    margin-bottom: var(--s-6);
  }

  .wordmark {
    text-decoration: none;
    margin-right: auto;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    width: 4rem;
    height: 4rem;
  }

  .primary-nav {
    display: flex;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-4);
  }

  .nav-link {
    font-size: var(--p-small);
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 0.2s;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--interactive);
  }

  .theme-toggle {
    background: none;
    border: 0;
    color: var(--ink-muted);
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    transition: color 0.2s;
  }

  .theme-toggle {
    cursor: pointer;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    color: var(--interactive);
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.36rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    width: 1.25rem;
    height: 1px;
    background: currentColor;
    transition:
      transform 180ms cubic-bezier(0.2, 0.7, 0.2, 1),
      color 180ms ease;
  }

  .nav-toggle:hover {
    color: var(--interactive);
  }

  :is(.wordmark, .theme-toggle, .nav-toggle, .nav-link):focus-visible {
    outline: 2px solid var(--interactive);
    outline-offset: 4px;
    border-radius: 0.5rem;
  }

  @media (max-width: 720px) {
    .nav {
      position: sticky;
      top: 0;
      z-index: 20;
      display: grid;
      grid-template-columns: 1fr 44px 44px;
      column-gap: var(--s-2);
      row-gap: 0;
      padding-block: 0.5rem;
      margin-bottom: var(--s-5);
      background: color-mix(in srgb, var(--bg) 92%, transparent);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .wordmark {
      width: 3.25rem;
      height: 3.25rem;
    }

    .theme-toggle {
      margin-left: 0;
      border-radius: 0.5rem;
    }

    :is(.theme-toggle, .nav-toggle):active {
      color: var(--ink);
      background: color-mix(in srgb, var(--ink) 10%, transparent);
    }

    .nav-toggle {
      display: inline-flex;
    }

    .primary-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      display: grid;
      grid-template-rows: 0fr;
      width: 100%;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.35rem);
      transition:
        grid-template-rows 220ms cubic-bezier(0.2, 0.7, 0.2, 1),
        opacity 160ms ease,
        transform 220ms cubic-bezier(0.2, 0.7, 0.2, 1),
        visibility 0s linear 220ms;
    }

    .primary-nav[data-open="true"] {
      grid-template-rows: 1fr;
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    .nav-links {
      min-height: 0;
      overflow: hidden;
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
    }

    .primary-nav[data-open="true"] .nav-links {
      padding-top: var(--s-2);
    }

    .nav-link {
      min-height: 52px;
      padding-inline: var(--s-3);
      border-radius: 0.5rem;
    }

    .nav-link[aria-current="page"],
    .nav-link:active {
      background: color-mix(in srgb, var(--ink) 7%, transparent);
    }

    .primary-nav[data-open="true"] .nav-links {
      padding-block: var(--s-2);
      border-top: 1px solid var(--border);
    }

    .nav-toggle[aria-expanded="true"] span:first-child {
      transform: translateY(0.215rem) rotate(45deg);
    }

    .nav-toggle[aria-expanded="true"] span:last-child {
      transform: translateY(-0.215rem) rotate(-45deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-nav,
    .nav-toggle span {
      transition: none;
    }
  }
</style>

<script>
  import {
    savedTheme,
    saveTheme,
    themedUrl,
    resolvedTheme,
  } from "@anipotts/brand/theme";
  document.documentElement.dataset.theme = resolvedTheme(savedTheme());
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
    if (savedTheme() === "system") {
      document.documentElement.dataset.theme = resolvedTheme("system");
      sync();
    }
  });
  const btn = document.getElementById("theme-toggle");
  const nav = document.getElementById("primary-nav");
  const navToggle = document.getElementById("nav-toggle");
  const setNavOpen = (open: boolean) => {
    nav?.setAttribute("data-open", String(open));
    navToggle?.setAttribute("aria-expanded", String(open));
    navToggle?.setAttribute(
      "aria-label",
      open ? "close navigation" : "open navigation",
    );
  };
  const sync = () => {
    btn?.setAttribute(
      "aria-pressed",
      String(document.documentElement.dataset.theme === "dark"),
    );
  };
  sync();
  btn?.addEventListener("click", () => {
    const next =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    saveTheme(next);
    sync();
  });
  document.addEventListener("click", (event) => {
    const link =
      event.target instanceof Element
        ? event.target.closest<HTMLAnchorElement>("a.admin-glyph")
        : null;
    if (link) link.href = themedUrl("/admin", savedTheme());
  });
  navToggle?.addEventListener("click", () => {
    setNavOpen(navToggle.getAttribute("aria-expanded") !== "true");
  });
  nav?.addEventListener("click", (event) => {
    const target = event.target;
    if (target instanceof Element && target.closest("a")) {
      setNavOpen(false);
    }
  });
  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      navToggle?.getAttribute("aria-expanded") === "true"
    ) {
      setNavOpen(false);
      navToggle.focus();
    }
  });
  document.addEventListener("click", (event) => {
    if (event.target instanceof Element && !event.target.closest("header.nav"))
      setNavOpen(false);
  });
  matchMedia("(max-width: 720px)").addEventListener("change", () =>
    setNavOpen(false),
  );
</script>
