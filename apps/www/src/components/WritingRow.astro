---
import InlineText from "./InlineText.astro";
import CardAction from "./CardAction.astro";
import { formatDate, writingSlug, type Writing } from "../lib/content";
import AmbientFlow from "./AmbientFlow.astro";

interface Props {
  item: Writing;
  flowVariant?: number;
}

const { item, flowVariant } = Astro.props;
const slug = writingSlug(item);
const { title, summary, published_at } = item.data;
---

<a
  href={`/writing/${slug}`}
  class="card writing-card"
  data-astro-prefetch="viewport"
>
  <AmbientFlow kind="writing" seed={slug} variant={flowVariant} />
  <span class="writing-card__header">
    <span class="card-title-group">
      <span class="title">{title}</span>
      {
        published_at && (
          <time class="date" datetime={published_at.toISOString()}>
            {formatDate(published_at)}
          </time>
        )
      }
    </span>
    <CardAction label="read" showMark={false} />
  </span>
  <span class="sub"><InlineText text={summary} links={false} /></span>
</a>

<style is:global>
  .writing-card {
    position: relative;
    isolation: isolate;
    contain: paint;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 0.5rem var(--card-header-gap);
    border-radius: var(--paper-radius);
    background: var(--paper-surface);
    color: var(--paper-ink);
    box-shadow: var(--paper-shadow);
    text-decoration: none;
    transition: background 0.2s;
  }

  @media (hover: hover) and (pointer: fine) {
    .writing-card:hover {
      background: var(--paper-surface-hover);
    }
  }

  .writing-card > :not(.ambient-flow) {
    position: relative;
    z-index: 1;
  }

  .writing-card .title {
    font-family: var(--display);
    font-size: var(--card-title-size);
    font-weight: var(--card-title-weight);
    line-height: 1.2;
    letter-spacing: 0;
    font-synthesis: none;
    text-wrap: pretty;
  }

  .writing-card__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--card-header-gap);
  }

  .writing-card .sub {
    grid-column: 1 / -1;
    position: relative;
    z-index: 1;
    color: var(--paper-muted);
    font-size: var(--card-copy-size);
    font-weight: var(--card-copy-weight);
    line-height: var(--card-copy-leading);
  }

  .writing-card > .ambient-flow {
    inset: 0;
    height: 100%;
    border-radius: inherit;
  }

  .writing-card .date {
    align-self: center;
    white-space: nowrap;
    color: var(--paper-muted);
    font-size: var(--control-size);
    font-weight: var(--card-copy-weight);
  }
</style>
