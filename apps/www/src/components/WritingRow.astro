---
import InlineText from "./InlineText.astro";
import { Icon } from "astro-icon/components";
import { formatDate, writingSlug, type Writing } from "../lib/content";
import AmbientFlow from "./AmbientFlow.astro";

interface Props {
  item: Writing;
  flowVariant?: number;
}

const { item, flowVariant } = Astro.props;
const slug = writingSlug(item);
const { title, summary, published_at } = item.data;
---

<a
  href={`/writing/${slug}`}
  class="card writing-card"
  data-astro-prefetch="viewport"
>
  <AmbientFlow kind="writing" seed={slug} variant={flowVariant} />
  <span class="title">{title}</span>
  {
    published_at && (
      <time class="date mono" datetime={published_at.toISOString()}>
        {formatDate(published_at)}
      </time>
    )
  }
  <Icon name="ph:arrow-bend-right-up" class="affordance" aria-hidden="true" />
  <span class="sub"><InlineText text={summary} links={false} /></span>
</a>

<style is:global>
  .writing-card {
    position: relative;
    isolation: isolate;
    contain: paint;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: start;
    gap: 0.5rem var(--card-header-gap);
    border-radius: var(--paper-radius);
    background: var(--paper-surface);
    color: var(--paper-ink);
    box-shadow: var(--paper-shadow);
    text-decoration: none;
    transition: background 0.2s;
  }

  @media (hover: hover) and (pointer: fine) {
    .writing-card:hover {
      background: var(--paper-surface-hover);
    }
  }

  .writing-card > :not(.ambient-flow) {
    position: relative;
    z-index: 1;
  }

  .writing-card .title {
    font-family: var(--display);
    font-size: var(--card-title-size);
    font-weight: var(--card-title-weight);
    line-height: 1.2;
    letter-spacing: 0;
    font-synthesis: none;
    text-wrap: pretty;
  }

  .writing-card .affordance {
    color: var(--paper-muted);
    width: 1rem;
    height: 1rem;
    align-self: center;
    transition:
      color 0.2s,
      transform 0.2s;
  }

  .writing-card:focus-visible .affordance {
    color: var(--paper-accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .writing-card:hover .affordance {
      color: var(--paper-accent);
    }
  }

  .writing-card .sub {
    grid-column: 1 / -1;
    position: relative;
    z-index: 1;
    color: var(--paper-muted);
    font-size: var(--card-copy-size);
    font-weight: var(--card-copy-weight);
    line-height: var(--card-copy-leading);
  }

  .writing-card > .ambient-flow {
    inset: 0;
    height: 100%;
    border-radius: inherit;
  }

  .writing-card .date {
    align-self: center;
    white-space: nowrap;
    color: var(--paper-muted);
    font-size: var(--control-size);
    font-weight: var(--card-copy-weight);
  }
  @media (max-width: 600px) {
    .writing-card {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: 0.375rem;
    }
    .writing-card .affordance {
      grid-column: 2;
      grid-row: 1;
    }
    .writing-card .date {
      grid-column: 1;
      grid-row: 2;
    }
    .writing-card .sub {
      grid-row: 3;
    }
  }
</style>
