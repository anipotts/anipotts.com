---
import { Icon } from "astro-icon/components";
import { projectSlug, type Project } from "../lib/content";

interface Props {
  project: Project;
  preview?: boolean;
}

const { project, preview = false } = Astro.props;
const slug = projectSlug(project);
const { title, subtitle, year, status, category, tags } = project.data;
const previews: Record<
  string,
  { eyebrow: string; primary: string; detail: string }
> = {
  quantercise: {
    eyebrow: "graded rep",
    primary: "12 × 17",
    detail: "204 · correct",
  },
  "quantercise-extension": {
    eyebrow: "quick drill",
    primary: "47 + 86",
    detail: "1.8s",
  },
  saeshify: {
    eyebrow: "live rhyme map",
    primary: "time / line",
    detail: "audio synced",
  },
  "nyu-purity-test": {
    eyebrow: "campus run",
    primary: "72 / 100",
    detail: "3,000+ scores",
  },
};
const previewCopy = previews[slug] ?? {
  eyebrow: category,
  primary: title,
  detail: status,
};
---

<a
  href={`/projects/${slug}`}
  data-category={category}
  data-project={slug}
  class:list={["card", "project-card", { "with-preview": preview }]}
>
  {
    preview && (
      <span class="preview" aria-hidden="true">
        <span class="preview-eyebrow mono">{previewCopy.eyebrow}</span>
        <span class="preview-primary">{previewCopy.primary}</span>
        <span class="preview-detail mono">{previewCopy.detail}</span>
        <span class="preview-signal" />
      </span>
    )
  }
  <span class="head">
    <span class="title">{title}</span>
    <Icon name="ph:arrow-bend-right-up" class="affordance" />
  </span>
  <span class="sub">{subtitle ?? project.data.description}</span>
  <span class="meta mono">
    <span class="status"><span class={`dot ${status}`}></span>{status}</span>
    <span>{year}</span>
    {tags.slice(0, 4).map((t) => <span class="muted">{t.toLowerCase()}</span>)}
  </span>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    text-decoration: none;
    transition: background 0.2s;
  }

  .project-card:hover {
    background: var(--accent-soft);
  }

  .with-preview {
    padding: 0;
    overflow: hidden;
    gap: 0;
    border: 1px solid var(--border);
    background: transparent;
  }

  .with-preview > :not(.preview) {
    margin-inline: var(--s-4);
  }

  .with-preview > .head {
    margin-top: var(--s-4);
  }

  .with-preview > .meta {
    margin-bottom: var(--s-4);
  }

  .preview {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-content: space-between;
    min-height: 9rem;
    padding: var(--s-3) var(--s-4);
    overflow: hidden;
    color: var(--ink);
    background:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px),
      color-mix(in srgb, var(--accent) 12%, var(--surface));
    background-size: 1.5rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .preview-eyebrow,
  .preview-detail {
    position: relative;
    z-index: 1;
    font-size: 0.68rem;
    color: var(--ink-muted);
  }

  .preview-detail {
    align-self: end;
    justify-self: end;
  }

  .preview-primary {
    position: relative;
    z-index: 1;
    grid-column: 1 / -1;
    align-self: center;
    font-family: var(--display);
    font-size: clamp(1.8rem, 4vw, 2.65rem);
    line-height: 0.95;
    font-weight: 900;
    color: var(--accent);
    -webkit-text-stroke: 0.75px var(--display-outline);
    paint-order: stroke fill;
  }

  .preview-signal {
    position: absolute;
    right: 1.5rem;
    top: 50%;
    width: 4.5rem;
    height: 4.5rem;
    border: 1px solid color-mix(in srgb, var(--accent) 60%, transparent);
    border-radius: 50%;
    transform: translateY(-50%);
    opacity: 0.55;
  }

  .with-preview:hover .preview-signal {
    background: var(--accent-soft);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .title {
    font-family: var(--display);
    font-size: var(--p-h2);
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0;
    font-synthesis: none;
  }

  .project-card:hover .title {
    color: var(--accent);
  }

  .affordance {
    color: var(--ink-muted);
    flex-shrink: 0;
    transition:
      color 0.2s,
      transform 0.2s;
  }

  .project-card:hover .affordance {
    color: var(--accent);
    transform: translate(0.14em, -0.14em);
  }

  .sub {
    color: var(--ink-muted);
    font-size: var(--p-small);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    font-size: 0.8rem;
    color: var(--ink-muted);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--ink-muted);
  }

  .dot.live {
    background: var(--accent);
  }
</style>
