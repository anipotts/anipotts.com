---
import InlineText from "./InlineText.astro";
import AmbientFlow from "./AmbientFlow.astro";
import { Icon } from "astro-icon/components";
import type { Project } from "../lib/content";
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<a
  class="coding-agent-card card"
  href={project.data.link_live ?? project.data.detail_path}
>
  <AmbientFlow kind="work" seed={project.data.slug ?? project.id} />
  <span class="guide-content">
    <span class="guide-identity">
      {
        project.data.identity.logo_src && (
          <img
            src={project.data.identity.logo_src}
            width="32"
            height="32"
            alt=""
            loading="lazy"
          />
        )
      }
      <span class="guide-label">{project.data.title}</span>
    </span>
    <span class="guide-title"
      ><InlineText text={project.data.subtitle ?? ""} links={false} /></span
    >
  </span>
  <span class="guide-action"
    >read the guide <span class="action-arrow"
      ><Icon name="ph:arrow-up-right-bold" aria-hidden="true" /></span
    ></span
  >
</a>

<style>
  .coding-agent-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: var(--paper-radius);
    color: var(--paper-ink);
    text-decoration: none;
    box-shadow: var(--paper-shadow);
  }
  .guide-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }
  .guide-identity {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .guide-identity img {
    width: 2rem;
    height: 2rem;
    flex: none;
    border-radius: 0.4rem;
  }
  .guide-label {
    color: var(--paper-muted);
    font-size: 0.8rem;
    font-weight: 550;
  }
  .guide-title {
    max-width: none;
    font-size: clamp(1.2rem, 2.3vw, 1.6rem);
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
  .guide-action {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    flex: none;
    min-height: 44px;
    color: var(--paper-ink);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .action-arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 0.6rem;
    background: #1247e6;
    color: #fff;
  }
  .action-arrow :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
    transition: transform 0.18s ease;
  }
  .coding-agent-card:hover .action-arrow :global(svg) {
    transform: translate(2px, -2px);
  }
  .coding-agent-card:focus-visible {
    outline: 3px solid #1247e6;
    outline-offset: 4px;
  }
  @media (max-width: 600px) {
    .coding-agent-card {
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
    }
    .guide-action {
      justify-content: space-between;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .action-arrow :global(svg) {
      transition: none;
    }
  }
</style>
