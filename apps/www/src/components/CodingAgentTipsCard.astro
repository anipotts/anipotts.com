---
import ResponsiveCopy from "./ResponsiveCopy.astro";
import AmbientFlow from "./AmbientFlow.astro";
import CardAction from "./CardAction.astro";
import type { Project } from "../lib/content";
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<a
  class="coding-agent-card card"
  href={project.data.link_live ?? project.data.detail_path}
>
  <AmbientFlow kind="work" seed={project.data.slug ?? project.id} />
  <span class="guide-mark" aria-hidden="true"
    ><img
      src={project.data.identity.logo_src ?? "/brand/ap-favicon.svg"}
      alt=""
      width="40"
      height="40"
    /></span
  >
  <span class="guide-content">
    <span class="guide-title"
      >{project.data.card_title?.trim() || project.data.title}</span
    >
    <span class="guide-copy"
      ><ResponsiveCopy
        text={project.data.card_copy}
        compact={project.data.card_copy_compact}
        links={false}
      /></span
    >
  </span>
  <CardAction
    label="read the guide"
    logoSrc={project.data.identity.logo_src}
    icon={project.data.identity.icon}
    adaptive={project.data.identity.logo_tone === "adaptive"}
  />
</a>

<style>
  .coding-agent-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--card-header-gap);
    padding: var(--card-inset);
    color: var(--paper-ink);
    text-decoration: none;
  }
  .coding-agent-card > :not(.ambient-flow) {
    position: relative;
    z-index: 1;
  }
  .coding-agent-card :global(.card-action) {
    position: relative;
    z-index: 1;
  }
  .coding-agent-card > :global(.ambient-flow) {
    inset: -1px;
    border-radius: 0;
  }
  .guide-mark {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--card-ui-radius);
    background: var(--card-ui-surface);
    color: var(--paper-ink);
    font-size: 1.5rem;
  }
  .guide-mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: inherit;
  }
  .guide-content {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }
  .guide-title {
    font-family: var(--display);
    font-size: 1.1rem;
    font-weight: var(--card-title-weight);
    line-height: 1.2;
  }
  .guide-copy {
    color: var(--paper-muted);
    font-size: var(--control-size);
    line-height: 1.4;
  }
  @media (max-width: 600px) {
    .coding-agent-card {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .coding-agent-card :global(.card-action) {
      grid-column: 1 / -1;
      width: 100%;
    }
  }
</style>
