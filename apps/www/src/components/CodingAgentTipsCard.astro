---
import InlineText from "./InlineText.astro";
import AmbientFlow from "./AmbientFlow.astro";
import CardAction from "./CardAction.astro";
import type { Project } from "../lib/content";
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<a
  class="coding-agent-card card"
  href={project.data.link_live ?? project.data.detail_path}
>
  <AmbientFlow kind="work" seed={project.data.slug ?? project.id} />
  <span class="guide-content">
    <span class="guide-identity">
      <span class="guide-label">{project.data.title}</span>
      <CardAction
        label="read the guide"
        logoSrc={project.data.identity.logo_src}
        icon={project.data.identity.icon}
        adaptive={project.data.identity.logo_tone === "adaptive"}
      />
    </span>
    <span class="guide-title"
      ><InlineText text={project.data.subtitle ?? ""} links={false} /></span
    >
  </span>
</a>

<style>
  .coding-agent-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: var(--paper-radius);
    color: var(--paper-ink);
    text-decoration: none;
    box-shadow: var(--paper-shadow);
  }
  .guide-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }
  .guide-identity img {
    width: 2rem;
    height: 2rem;
    flex: none;
    border-radius: 0.4rem;
  }
  .guide-label {
    color: var(--paper-muted);
    font-size: 0.8rem;
    font-weight: 550;
  }
  .guide-title {
    max-width: none;
    font-size: clamp(1.2rem, 2.3vw, 1.6rem);
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .coding-agent-card:focus-visible {
    outline: 3px solid #1247e6;
    outline-offset: 4px;
  }
  /* Scoped so the press ring outranks the card's own resting box-shadow. */
  @media (width < 880px), (pointer: coarse) {
    .coding-agent-card:active {
      background: var(--paper-surface-hover);
      box-shadow: inset 0 0 0 2px var(--paper-accent);
    }
  }
  @media (max-width: 600px) {
    .coding-agent-card {
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
    }
  }
</style>
