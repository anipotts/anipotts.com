---
import { Icon } from "astro-icon/components";
import AmbientFlow from "./AmbientFlow.astro";
import { projectSlug, type Project } from "../lib/content";

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<a
  class="coding-agent-card card"
  href={project.data.link_live ?? `/work/${projectSlug(project)}`}
  aria-label={`Open ${project.data.title}`}
>
  <span class="copy">
    <span class="label mono">{project.data.title}</span>
    <span class="lede">{project.data.subtitle}</span>
  </span>

  <span class="visual landscape-frame" aria-hidden="true">
    <AmbientFlow kind="work" seed="coding-agent-tips" />

    <Icon class="visual-arrow" name="ph:arrow-up-right" />

    <span class="cta">read the guide</span>
  </span>
</a>

<style>
  .coding-agent-card {
    --agent-tips-accent: #1247e6;
    --agent-tips-shell: var(--paper-surface);
    --agent-tips-ink: var(--paper-ink);
    --agent-tips-control: #ffffff;
    --agent-tips-control-ink: var(--agent-tips-accent);
    display: grid;
    grid-template-columns: minmax(15rem, 0.78fr) minmax(22rem, 1.22fr);
    align-items: stretch;
    gap: var(--s-5);
    width: 100%;
    padding: var(--s-5);
    overflow: hidden;
    border-radius: var(--paper-radius);
    background: var(--agent-tips-shell);
    color: var(--agent-tips-ink);
    box-shadow: var(--paper-shadow);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    align-self: center;
  }

  .label {
    color: var(--agent-tips-accent);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .lede {
    color: var(--agent-tips-ink);
    font-size: var(--p-body);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .visual {
    position: relative;
    min-width: 0;
    min-height: 9rem;
    display: grid;
    align-items: end;
    overflow: hidden;
    isolation: isolate;
    border-radius: 0.7rem;
    background: #61abea;
  }

  .visual > .visual-arrow {
    position: absolute;
    top: 50%;
    left: 52%;
    z-index: 1;
    width: clamp(3.75rem, 8vw, 5.5rem);
    height: clamp(3.75rem, 8vw, 5.5rem);
    color: #ffffff;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .cta {
    position: relative;
    z-index: 2;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    margin: var(--s-3);
    padding-inline: var(--s-4);
    border-radius: 0.45rem;
    background: var(--agent-tips-control);
    color: var(--agent-tips-control-ink);
    box-shadow: 0 0.5rem 1.4rem rgb(6 26 93 / 24%);
    font-weight: 650;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .coding-agent-card:focus-visible {
    outline: 3px solid var(--agent-tips-accent);
    outline-offset: 3px;
  }

  :global(html[data-theme="dark"]) .coding-agent-card {
    --agent-tips-accent: #61abea;
    --agent-tips-control: color-mix(in srgb, #61abea 16%, #11151d);
    --agent-tips-control-ink: #f7faff;
  }

  @media (max-width: 720px) {
    .coding-agent-card {
      grid-template-columns: 1fr;
    }

    .visual {
      min-height: 10rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coding-agent-card,
    .cta {
      transition: none;
    }
  }
</style>
