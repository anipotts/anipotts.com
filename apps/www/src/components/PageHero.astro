---
import InlineText from "./InlineText.astro";
interface Props {
  title: string;
  summary: string;
}

const { title, summary } = Astro.props;
---

<section data-rise class="page-hero">
  <h1 class="page-hero__title">{title}</h1>
  <p class="page-hero__summary"><InlineText text={summary} /></p>
</section>

<style>
  .page-hero__title {
    margin-bottom: var(--s-4);
    font-size: var(--d-hero);
    line-height: 0.9;
  }

  .page-hero__summary {
    max-width: none;
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--d-lede);
    line-height: 1.52;
    text-wrap: pretty;
  }

  @media (max-width: 640px) {
    .page-hero__title {
      margin-bottom: var(--s-3);
    }
  }
</style>
