---
import InlineText from "./InlineText.astro";
import WorkCard from "./WorkCard.astro";
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import ProjectMediaStage from "./ProjectMediaStage.astro";
import DetailWaves from "./DetailWaves.astro";
import "./editorial/editorial-media.css";
import ProjectMeta from "./ProjectMeta.astro";
import Shell from "../layouts/Shell.astro";
import { projectSlug, type Project } from "../lib/content";

interface Props {
  preview?: boolean;
  project: Project;
}
const { project } = Astro.props;

const slug = projectSlug(project);
const { Content } = await render(project);
const hasBody = Boolean(project.body?.trim());
const d = project.data;
---

<Shell
  title={d.title}
  description={d.description}
  path={`/work/${slug}`}
  mood="alert"
  detail
  robots={Astro.props.preview ? "noindex, nofollow, noarchive" : undefined}
>
  {
    Astro.props.preview && (
      <aside class="editorial-card-preview">
        <>
          <p class="muted">Card preview</p>
          <WorkCard project={project} />
          <p class="muted">Article preview</p>
        </>
      </aside>
    )
  }
  <article class="project-page">
    <DetailWaves seed={`work/${slug}`} tone="work" />
    <header data-rise class="project-head">
      <div class="project-topline">
        <a href="/work" class="quiet-link back">
          <Icon name="ph:arrow-left" /> work
        </a>

        <div class="project-actions">
          {
            d.link_live && (
              <a
                href={d.link_live}
                class="quiet-link project-action"
                target="_blank"
                rel="noopener noreferrer"
              >
                visit project <Icon name="ph:arrow-up-right" />
              </a>
            )
          }
          {
            d.link_repo && (
              <a
                href={d.link_repo}
                class="quiet-link project-action"
                target="_blank"
                rel="noopener noreferrer"
              >
                source <Icon name="ph:github-logo" />
              </a>
            )
          }
        </div>
      </div>

      <div class="project-heading">
        <div class="project-identity">
          {
            d.identity.logo_src ? (
              <img
                src={d.identity.logo_src}
                alt={d.identity.logo_alt ?? ""}
                class:list={[
                  "project-mark",
                  d.identity.logo_tone === "light" && "project-mark--light",
                  d.identity.logo_tone === "adaptive" &&
                    "project-mark--adaptive",
                ]}
              />
            ) : d.identity.icon ? (
              <Icon name={`ph:${d.identity.icon}`} class="project-mark-icon" />
            ) : null
          }
          <h1 class="hero-title">
            {d.title}
          </h1>
        </div>
        <p class="project-summary">
          <InlineText text={d.card_copy || d.subtitle || d.description} />
        </p>
      </div>

      <ProjectMeta status={d.status} year={d.year} role={d.role} />
    </header>

    {
      d.preview_media && (
        <section
          data-rise
          class="project-visual"
          aria-label={`${d.title} preview`}
        >
          <ProjectMediaStage
            items={[d.preview_media]}
            label={`${slug}-preview`}
            eager
          />
        </section>
      )
    }

    {
      hasBody && (
        <section data-rise class="project-overview">
          <div class="article-body project-prose">
            <Content />
          </div>
        </section>
      )
    }

    {
      d.story.length > 0 && (
        <div class="project-story">
          {d.story.map((section, index) => (
            <section data-rise class="story-section">
              <div class="story-copy">
                <span class="story-index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h2>{section.title}</h2>
                {section.paragraphs.map((paragraph) => (
                  <p>
                    <InlineText text={paragraph} />
                  </p>
                ))}
              </div>
              {section.media && (
                <div class="story-media">
                  <ProjectMediaStage
                    items={[section.media]}
                    label={`${slug}-section-${index + 1}`}
                  />
                </div>
              )}
            </section>
          ))}
        </div>
      )
    }

    {
      !hasBody && d.story.length === 0 && (
        <section data-rise class="project-overview">
          <p class="project-fallback">
            <InlineText text={d.description} />
          </p>
        </section>
      )
    }

    {
      d.technical && (
        <section data-rise class="project-detail-block">
          <h2 class="section-label">under the hood</h2>
          <div class="project-detail-grid">
            {d.technical.map((item) => (
              <article class="project-detail-card">
                <h3>{item.title}</h3>
                <p>
                  <InlineText text={item.content} />
                </p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {
      d.roadmap && (
        <section data-rise class="project-detail-block">
          <h2 class="section-label">next</h2>
          <ul class="project-roadmap">
            {d.roadmap.map((item) => (
              <li class={item.status}>
                <Icon
                  name={
                    item.status === "done"
                      ? "ph:check-circle"
                      : item.status === "in-progress"
                        ? "ph:circle-half"
                        : "ph:circle"
                  }
                />
                <span>{item.text}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Shell>

<style>
  .editorial-card-preview {
    display: grid;
    gap: var(--s-3);
    margin-bottom: var(--s-6);
  }
  .project-page {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: clamp(3.5rem, 8vw, 6.5rem);
    color: var(--paper-ink);
  }

  .project-head {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    width: 100%;
    padding-block: 0 clamp(0.5rem, 2vw, 2rem);
  }

  .project-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-bottom: clamp(1rem, 3vw, 2.5rem);
  }

  .back,
  .project-action {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.9rem;
    color: var(--paper-muted);
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
  }

  .project-heading {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    max-width: none;
  }

  .project-identity {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }

  .project-mark,
  :global(.project-mark-icon) {
    width: clamp(2.5rem, 6vw, 3.5rem);
    height: clamp(2.5rem, 6vw, 3.5rem);
    object-fit: contain;
    object-position: left center;
  }

  .project-mark--light,
  .project-mark--adaptive {
    filter: brightness(0);
  }

  :global(html[data-theme="dark"]) .project-mark--light,
  :global(html[data-theme="dark"]) .project-mark--adaptive {
    filter: brightness(0) invert(1);
  }

  .hero-title {
    color: var(--paper-ink);
    font-size: clamp(2.6rem, 6.6vw, 5.6rem);
    line-height: 1.03;
    letter-spacing: -0.035em;
    white-space: normal;
    overflow-wrap: anywhere;
    text-wrap: wrap;
  }

  .project-summary {
    max-width: none;
    margin: 0;
    color: var(--paper-muted);
    font-size: clamp(1.15rem, 2.15vw, 1.5rem);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .project-visual,
  .story-media {
    min-width: 0;
  }

  .project-overview {
    display: grid;
    grid-template-columns: minmax(0, 65ch);
    justify-content: center;
  }

  .project-prose,
  .project-fallback {
    max-width: 65ch;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.75;
  }

  .project-fallback {
    margin: 0;
    color: var(--paper-muted);
  }

  .project-prose :global(h2) {
    line-height: 1.2;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  .project-prose :global(h3) {
    line-height: 1.25;
    font-size: 1.35rem;
  }

  .project-prose :global(a) {
    color: var(--paper-accent);
  }

  .project-prose :global(video),
  .project-prose :global(iframe) {
    max-width: 100%;
  }

  .project-story {
    display: grid;
    gap: clamp(4rem, 9vw, 7rem);
  }

  .story-section {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    padding-top: clamp(1.75rem, 4vw, 3rem);
    border-top: 1px solid color-mix(in srgb, var(--paper-ink) 13%, transparent);
  }

  .story-copy {
    width: min(100%, 65ch);
    margin-inline: auto;
    display: grid;
    gap: 1.15rem;
  }

  .story-index {
    color: var(--paper-muted);
    font-family: var(--mono);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  .story-copy h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    line-height: 1.13;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .story-copy p {
    margin: 0;
    color: var(--paper-muted);
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.75;
    text-wrap: pretty;
  }

  .project-detail-block {
    display: grid;
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--paper-ink) 13%, transparent);
  }

  .project-detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: 2rem;
  }

  .project-detail-card {
    display: grid;
    align-content: start;
    gap: 0.85rem;
  }

  .project-detail-card h3 {
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .project-detail-card p {
    margin: 0;
    color: var(--paper-muted);
    line-height: 1.7;
  }

  .project-roadmap {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    max-width: 65ch;
  }

  .project-roadmap li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .project-roadmap li.done {
    color: var(--paper-muted);
  }

  .project-roadmap li :global([data-icon]) {
    flex: 0 0 auto;
    color: var(--paper-accent);
  }

  @media (max-width: 40rem) {
    .project-page {
      gap: 3rem;
    }

    .project-topline {
      align-items: flex-start;
    }

    .hero-title {
      font-size: clamp(2.3rem, 10vw, 3.5rem);
    }
  }
</style>
