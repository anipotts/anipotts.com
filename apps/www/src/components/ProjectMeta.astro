---
import { workStatusLabel } from "../lib/work-status";
interface Props {
  status: string;
  year: string;
  role?: string;
  inline?: boolean;
  kind?: "experience" | "project";
  catalogGroup?: "active" | "past" | "taken_down";
}
const { status, year, role, inline = false, kind, catalogGroup } = Astro.props;
const label = workStatusLabel({ kind, status, catalogGroup });
const showStatus =
  Boolean(label) && (!inline || kind === "experience" || status !== "live");
const timeframe = year
  .trim()
  .replace(/\s*[-–—]\s*$/u, " – present")
  .replace(/\s*[-–—]\s*/gu, " – ");
---

<span
  class:list={["project-meta-group", { "project-meta-group--inline": inline }]}
>
  {(showStatus || timeframe) && <span class="project-meta-ui">
    {showStatus && <span class="status">
      <span class="sr-only">Status: </span>
      {label}
      <span class="sr-only">.</span>
    </span>}
    {timeframe && <span class="timeframe">
      <span class="sr-only">Timeframe: </span>
      {timeframe}
    </span>}
  </span>}
  {role && <span class="role">{role}</span>}
</span>
<style>
  .project-meta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--control-group-gap);
  }
  .project-meta-ui {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--control-group-gap);
    width: fit-content;
    max-width: 100%;
    padding: var(--card-ui-padding);
    border: 1px solid var(--card-ui-border);
    border-radius: var(--card-ui-radius);
    background: var(--card-ui-surface);
    color: var(--paper-muted);
    font-size: var(--control-size);
    font-weight: var(--card-copy-weight);
    line-height: var(--control-leading);
  }
  .project-meta-group--inline .project-meta-ui {
    padding: 0;
    border: 0;
    background: transparent;
    gap: 0.5rem;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--control-icon-gap);
    font-weight: var(--status-weight);
    white-space: normal;
  }
  .timeframe {
    font-variant-numeric: tabular-nums;
    white-space: normal;
  }
  .role {
    font-size: var(--control-size);
    color: var(--ink-muted);
  }
  /* Generic spans cannot carry a name, so field labels ride along as hidden text. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
