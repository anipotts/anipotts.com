---
interface Props {
  status: string;
  year: string;
  role?: string;
}
const { status, year, role } = Astro.props;
const label = status === "wip" ? "in progress" : status;
const timeframe = year
  .trim()
  .replace(/\s*[-–—]\s*$/u, " – present")
  .replace(/\s*[-–—]\s*/gu, " – ");
---

<span class="project-meta-group">
  <span class="project-meta-ui">
    <span class="status"
      ><span
        class:list={["status-dot", `status-dot--${status}`]}
        aria-hidden="true"></span><span class="sr-only">Status: </span>{
        label
      }<span class="sr-only">.</span></span
    >
    <span class="timeframe"
      ><span class="sr-only">Timeframe: </span>{timeframe}</span
    >
  </span>
  {role && <span class="role">{role}</span>}
</span>
<style>
  .project-meta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--control-group-gap);
  }
  .project-meta-ui {
    display: inline-flex;
    align-items: center;
    gap: var(--control-group-gap);
    width: fit-content;
    max-width: 100%;
    padding: var(--card-ui-padding);
    border: 1px solid var(--card-ui-border);
    border-radius: var(--card-ui-radius);
    background: var(--card-ui-surface);
    color: var(--paper-muted);
    font-size: var(--control-size);
    font-weight: var(--card-copy-weight);
    line-height: var(--control-leading);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--control-icon-gap);
    font-weight: var(--status-weight);
    white-space: nowrap;
  }
  .status-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: currentColor;
    flex: none;
  }
  .status-dot--live {
    background: #16834a;
  }
  :global(html[data-theme="dark"]) .status-dot--live {
    background: #4ade80;
  }
  .status-dot--wip {
    background: #a86708;
  }
  :global(html[data-theme="dark"]) .status-dot--wip {
    background: #f5bd4f;
  }
  .status-dot--archived {
    background: #7b8491;
  }
  :global(html[data-theme="dark"]) .status-dot--archived {
    background: #8b96a6;
  }
  .timeframe {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .role {
    font-size: var(--control-size);
    color: var(--ink-muted);
  }
  /* Generic spans cannot carry a name, so field labels ride along as hidden text. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
