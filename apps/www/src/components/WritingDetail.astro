---
import InlineText from "./InlineText.astro";
import { inlinePlainText } from "@anipotts/content/public/inline";
import { render } from "astro:content";
import DetailWaves from "./DetailWaves.astro";
import "./editorial/editorial-media.css";
import WritingRow from "./WritingRow.astro";
import Shell from "../layouts/Shell.astro";
import { Icon } from "astro-icon/components";
import {
  publishedWriting,
  formatDate,
  writingSlug,
  type Writing,
} from "../lib/content";
import { siteConfig } from "@anipotts/content/public";
import { personId } from "../lib/identity";
import { writingCard } from "../lib/social-card/routes";

interface Props {
  preview?: boolean;
  item: Writing;
  allWriting?: Writing[];
}
const { item } = Astro.props;
const slug = writingSlug(item);
const { Content } = await render(item);
const d = item.data;
const moreWriting = (Astro.props.allWriting ?? (await publishedWriting()))
  .filter((post) => writingSlug(post) !== slug)
  .slice(0, 2);

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: d.title,
  description: inlinePlainText(d.summary),
  datePublished: d.published_at?.toISOString(),
  dateModified: item.publication?.publishedAt,
  author: {
    "@type": "Person",
    "@id": personId,
    name: siteConfig.name,
    url: siteConfig.url,
  },
  mainEntityOfPage: `${siteConfig.url}/writing/${slug}`,
};
---

<Shell
  title={d.title}
  description={d.summary}
  path={`/writing/${slug}`}
  ogType="article"
  jsonLd={articleLd}
  detail
  robots={Astro.props.preview ? "noindex, nofollow, noarchive" : undefined}
  socialCard={Astro.props.preview || item.publication
    ? undefined
    : writingCard(slug)}
>
  {
    Astro.props.preview && (
      <aside class="editorial-card-preview">
        <>
          <p class="muted">Card preview</p>
          <WritingRow item={item} />
          <p class="muted">Article preview</p>
        </>
      </aside>
    )
  }
  <article class="article" data-writing-article>
    <DetailWaves seed={`writing/${slug}`} />
    <header data-rise class="head">
      <div class="article-topline">
        <a
          href="/writing"
          data-astro-prefetch="viewport"
          class="quiet-link mono back"
        >
          <Icon name="ph:arrow-bend-up-left" /> all writing
        </a>
        {
          d.published_at && (
            <time
              class="date mono muted"
              datetime={d.published_at.toISOString()}
            >
              {formatDate(d.published_at)}
            </time>
          )
        }
      </div>
      <h1 class="title">{d.title}</h1>
      <p class="summary"><InlineText text={d.summary} /></p>
    </header>

    <div data-rise class="article-body">
      {d.opening?.trim() && <p data-article-opening>{d.opening}</p>}
      <Content />
    </div>
    <footer class="article-end">
      {
        d.tags.length > 0 && (
          <ul class="topics" aria-label="Topics" role="list">
            {d.tags.map((tag) => (
              <li class="pill">{tag.replaceAll("-", " ")}</li>
            ))}
          </ul>
        )
      }
      <div class="more-heading">
        <h2 class="section-label">more writing</h2><a
          href="/writing"
          class="quiet-link mono"
          >view all <Icon name="ph:arrow-bend-right-up" /></a
        >
      </div>
      <div class="more-writing">
        {moreWriting.map((post) => <WritingRow item={post} />)}
      </div>
    </footer>
  </article>
</Shell>

<style>
  .editorial-card-preview {
    display: grid;
    gap: var(--s-3);
    margin-bottom: var(--s-6);
  }
  .article {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .article-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .date {
    font-size: 0.85rem;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.85rem;
    width: fit-content;
    min-height: 44px;
  }
  .title {
    font-size: var(--d-hero-detail);
    line-height: 1.03;
    max-width: none;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  .summary {
    max-width: none;
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--d-lede);
    line-height: 1.52;
    text-wrap: pretty;
  }
  .article-body {
    align-self: flex-start;
  }
  .article-end {
    padding-top: 2rem;
    display: grid;
    gap: 1.5rem;
  }
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .topics .pill {
    border: 1px solid var(--border);
    padding: 0.4rem 0.7rem;
    border-radius: 0.6rem;
    font-size: 0.8rem;
    line-height: 1.3;
    background: color-mix(in srgb, var(--ink) 4%, transparent);
  }
  .more-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .more-heading a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    min-height: 44px;
  }
  .more-writing {
    display: grid;
    gap: 1rem;
  }
</style>
