---
import { Icon } from "astro-icon/components";

interface Props {
  label: string;
  href?: string;
  icon?: string;
  mark?: string;
  logoSrc?: string;
  logoAlt?: string;
  logoTone?: "native" | "white";
  logoShape?: "square" | "wide" | "mark" | "large";
  badgeSrc?: string;
  badgeAlt?: string;
  suffix?: string;
  wrap?: boolean;
}

const {
  label,
  href,
  icon,
  mark,
  logoSrc,
  logoAlt,
  logoTone,
  logoShape,
  badgeSrc,
  badgeAlt,
  suffix,
  wrap = false,
} = Astro.props;
const Tag = href ? "a" : "span";
const hasVisual = Boolean(logoSrc || icon || mark);
const accessibleLabel = logoAlt ? `${logoAlt}: ${label}` : label;
const mentionClass = ["inline-mention", wrap ? "inline-mention-wrap" : ""]
  .filter(Boolean)
  .join(" ");
const markClass = [
  "brand-mark",
  logoTone === "white" ? "brand-mark-white" : "",
  logoShape === "wide" ? "brand-mark-wide" : "",
]
  .filter(Boolean)
  .join(" ");
const logoClass = ["logo", logoTone === "white" ? "logo-white" : ""]
  .filter(Boolean)
  .join(" ");
---

<Tag
  href={href}
  class={mentionClass}
  target={href ? "_blank" : undefined}
  rel={href ? "noopener noreferrer" : undefined}
  aria-label={accessibleLabel}
>
  {
    hasVisual && (
      <span class={markClass} aria-hidden="true">
        {logoSrc && (
          <img
            src={logoSrc}
            alt=""
            class={logoClass}
            loading="lazy"
            decoding="async"
          />
        )}
        {icon && <Icon name={icon} />}
        {mark && <span class="mark">{mark}</span>}
      </span>
    )
  }<span class="text">{label}{suffix}</span>{
    badgeSrc && (
      <img
        src={badgeSrc}
        alt={badgeAlt ?? ""}
        class="logo badge"
        loading="lazy"
        decoding="async"
      />
    )
  }
</Tag>

<style>
  .inline-mention {
    display: inline-flex;
    align-items: center;
    gap: 0.28em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    vertical-align: -0.08em;
  }

  .inline-mention-wrap {
    max-width: 100%;
    white-space: normal;
  }

  .inline-mention-wrap .text {
    min-width: 0;
  }

  a.inline-mention {
    text-decoration: none;
  }

  a.inline-mention .text {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 72%, transparent);
    text-decoration-thickness: 0.052em;
    text-underline-offset: 0.22em;
  }

  a.inline-mention:hover {
    color: var(--accent);
  }

  a.inline-mention:hover .text {
    text-decoration-color: var(--accent);
  }

  .brand-mark {
    width: 1.08em;
    height: 1.08em;
    flex: 0 0 1.08em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.06em;
    overflow: hidden;
    border: 0;
    border-radius: 0.24em;
    background: color-mix(in srgb, var(--surface) 78%, var(--ink) 22%);
    box-shadow:
      inset 0 0 0 1px var(--border),
      inset 0 0 0 1px rgba(255, 255, 255, 0.03);
    transform: translateY(0.02em);
  }

  .brand-mark-white {
    background: color-mix(in srgb, var(--surface) 84%, var(--ink) 16%);
  }

  .brand-mark-wide {
    width: 1.48em;
    flex-basis: 1.48em;
    padding: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .brand-mark svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .logo {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 0.14em;
    object-fit: contain;
  }

  .brand-mark-wide .logo {
    border-radius: 0;
  }

  .logo-white {
    filter: none;
  }

  :global(html[data-theme="dark"]) .logo-white {
    filter: brightness(0) invert(1);
  }

  .badge {
    margin-left: -0.08em;
  }

  a.inline-mention:hover .logo {
    opacity: 0.86;
  }

  .mark {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.72em;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
  }
</style>
