---
import { staticCurrents } from "../lib/static-currents";

interface Props {
  kind: "work" | "writing";
  seed: string;
  variant?: number;
}
const { kind, seed, variant } = Astro.props;
const currents = staticCurrents(seed);
const mirrored =
  (variant ?? [...seed].reduce((sum, char) => sum + char.charCodeAt(0), 0)) %
    2 ===
  1;
// The same landscape is cropped at different scales, never stretched.
const paths = [
  "M-80 410C90 185 220 170 410 300S715 425 880 240 1100 135 1280 230V680H-80Z",
  "M-80 500C95 335 245 320 425 415S735 520 910 360 1110 285 1280 335V680H-80Z",
  "M-80 595C120 470 295 470 465 535S760 600 930 470 1120 435 1280 460V680H-80Z",
];
---

<span class:list={["ambient-flow", `ambient-flow--${kind}`]} aria-hidden="true">
  {
    kind === "writing" ? (
      <svg viewBox="0 0 600 320" preserveAspectRatio="none" focusable="false">
        {currents.map(({ d, color }) => (
          <path
            class={`ambient-flow__shape ambient-flow__shape--${color + 1}`}
            d={d}
          />
        ))}
      </svg>
    ) : (
      <svg
        viewBox="0 0 1200 600"
        preserveAspectRatio="xMidYMid slice"
        focusable="false"
      >
        <g transform={mirrored ? "translate(1200 0) scale(-1 1)" : undefined}>
          {paths.map((d, index) => (
            <path
              class={`ambient-flow__shape ambient-flow__shape--${index + 1}`}
              d={d}
            />
          ))}
        </g>
      </svg>
    )
  }
</span>

<style>
  .ambient-flow {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
    contain: strict;
    --flow-1: #83c7f4;
    --flow-2: #4d8bea;
    --flow-3: #174ee8;
    --flow-opacity: 0.64;
  }
  .ambient-flow svg {
    position: absolute;
    inset: -6px;
    width: calc(100% + 12px);
    height: calc(100% + 12px);
    display: block;
    opacity: var(--flow-opacity);
  }
  .ambient-flow__shape--1 {
    fill: var(--flow-1);
  }
  .ambient-flow__shape--2 {
    fill: var(--flow-2);
  }
  .ambient-flow__shape--3 {
    fill: var(--flow-3);
  }
  .ambient-flow--writing {
    inset: auto -1rem -1rem auto;
    width: min(44%, 22rem);
    height: 80%;
    mask-image: linear-gradient(to right, transparent, black 42%);
    --flow-1: #83c7f4;
    --flow-2: #4d8bea;
    --flow-3: #2459d8;
    --flow-opacity: 0.7;
  }
  :global(html[data-theme="dark"]) .ambient-flow {
    --flow-1: #61abea;
    --flow-2: #3e82e8;
    --flow-3: #2459d8;
    --flow-opacity: 0.38;
  }
  :global(html[data-theme="dark"]) .ambient-flow--writing {
    --flow-1: #416c94;
    --flow-2: #2e5590;
    --flow-3: #244273;
    --flow-opacity: 0.72;
  }

  @media (width < 880px) {
    .ambient-flow--writing {
      width: 45%;
      height: min(80%, 9rem);
    }
  }
</style>
