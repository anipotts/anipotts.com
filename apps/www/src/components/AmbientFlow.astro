const library = kind === "making" ? makingPaths : writingPaths;
const variant = Math.abs(requestedVariant ?? stableHash) % library.length;
const paths = library[variant];
---

<span
  class:list={[
    "ambient-flow",
    `ambient-flow--${kind}`,
    `ambient-flow--${variant}`,
  ]}
  aria-hidden="true"
>
  <svg
    viewBox={kind === "making" ? "0 0 600 300" : "0 0 960 194"}
    preserveAspectRatio="none"
  >
    {
      paths.map((path, index) => (
        <path
          class={`ambient-flow__shape ambient-flow__shape--${index + 1}`}
          d={path}
        />
      ))
    }
  </svg>
</span>

<style>
  .ambient-flow {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
    contain: strict;
    --flow-1: #bfe7ff;
    --flow-2: #83c7f4;
    --flow-3: #4d8bea;
    --flow-4: #174ee8;
    --flow-opacity-1: 0.72;
    --flow-opacity-2: 0.62;
    --flow-opacity-3: 0.5;
    --flow-opacity-4: 0.44;
  }

  .ambient-flow svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .ambient-flow__shape {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 260ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 200ms ease;
  }
  .ambient-flow__shape--1 {
    fill: var(--flow-1);
    opacity: var(--flow-opacity-1);
  }
  .ambient-flow__shape--2 {
    fill: var(--flow-2);
    opacity: var(--flow-opacity-2);
  }
  .ambient-flow__shape--3 {
    fill: var(--flow-3);
    opacity: var(--flow-opacity-3);
  }
  .ambient-flow__shape--4 {
    fill: var(--flow-4);
    opacity: var(--flow-opacity-4);
  }

  :global(html[data-theme="dark"]) .ambient-flow {
    --flow-1: #61abea;
    --flow-2: #3e82e8;
    --flow-3: #2459d8;
    --flow-4: #173b91;
    --flow-opacity-1: 0.18;
    --flow-opacity-2: 0.2;
    --flow-opacity-3: 0.24;
    --flow-opacity-4: 0.28;
  }

  @media (hover: hover) {
    :global(a:hover) > .ambient-flow .ambient-flow__shape--1 {
      transform: translate3d(-0.3rem, -0.12rem, 0);
    }
    :global(a:hover) > .ambient-flow .ambient-flow__shape--2 {
      transform: translate3d(0.22rem, -0.2rem, 0);
    }
    :global(a:hover) > .ambient-flow .ambient-flow__shape--3 {
      transform: translate3d(-0.18rem, 0.18rem, 0);
    }
    :global(a:hover) > .ambient-flow .ambient-flow__shape--4 {
      transform: translate3d(0.12rem, 0.1rem, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient-flow__shape {
      transition: none;
    }
  }
</style>
