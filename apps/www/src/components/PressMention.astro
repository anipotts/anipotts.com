---
import AmbientFlow from "./AmbientFlow.astro";
import { Icon } from "astro-icon/components";

interface Props {
  essayHref?: string;
}
const { essayHref } = Astro.props;
---

<aside class="press-mention" aria-label="press coverage">
  <AmbientFlow kind="work" seed="business-insider" />
  <img
    class="press-mention__logo"
    src="/images/brand/business-insider-wordmark.svg"
    alt="business insider"
    width="930"
    height="320"
    decoding="async"
  />
  <p class="press-mention__copy">
    read my feature in a story about claude code usage limits
  </p>
  <div class="press-mention__links">
    {
      essayHref && (
        <a class="site-action" href={essayHref} data-admin-motion-action>
          <img
            class="press-mention__link-mark"
            src="/images/brand/business-insider-favicon.svg"
            alt=""
            width="16"
            height="16"
            decoding="async"
          />
          <span>read the story</span>
          <Icon name="ph:arrow-bend-right-up" aria-hidden="true" />
        </a>
      )
    }
  </div>
</aside>

<style>
  .press-mention {
    container-type: inline-size;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem var(--s-4);
    margin-top: var(--s-5);
    padding: var(--experience-card-padding);
    border-radius: var(--paper-radius);
    background: var(--paper-surface);
    color: var(--paper-ink);
    box-shadow: var(--paper-shadow);
  }

  .press-mention__logo {
    grid-column: 1;
    width: 6rem;
    height: auto;
    display: block;
  }

  .press-mention__copy {
    grid-column: 1 / -1;
    grid-row: 2;
    text-align: center;
    margin: 0;
    font-size: min(0.95rem, 3.5cqi);
    font-weight: 500;
    line-height: 1.4;
    white-space: nowrap;
  }

  .press-mention__links {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    display: grid;
    grid-template-columns: auto;
  }

  :global(html[data-theme="dark"]) .press-mention__logo {
    filter: brightness(0) invert(1);
  }

  @media (max-width: 767px) {
    .press-mention {
      gap: 0.625rem;
      padding: 1rem;
    }
    .press-mention__logo {
      width: 5.5rem;
    }
    .press-mention__copy {
      line-height: 1.35;
    }
    .press-mention__links a {
      grid-template-columns: 1rem auto 1rem;
      min-height: 44px;
      padding-inline: 0.5rem;
      column-gap: 0.375rem;
      font-size: 0.75rem;
    }
  }
  @media (max-width: 359px) {
    .press-mention {
      gap: 0.5rem;
      padding: 0.75rem;
    }
    .press-mention__logo {
      width: 4.75rem;
    }
  }
</style>
