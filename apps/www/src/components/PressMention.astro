---
import AmbientFlow from "./AmbientFlow.astro";
import { Icon } from "astro-icon/components";

interface Props {
  essayHref?: string;
}
const { essayHref } = Astro.props;
---

<aside class="press-mention" aria-label="press coverage">
  <AmbientFlow kind="work" seed="business-insider" localCrop />
  <img
    class="press-mention__logo"
    src="/images/brand/business-insider-favicon.svg"
    alt="business insider"
    width="40"
    height="40"
    decoding="async"
  />
  <div class="press-mention__content">
    <span class="press-mention__title">saturdays are for claude code</span>
    <p class="press-mention__copy">
      my feature in a story about coding agent usage limits
    </p>
  </div>
  <div class="press-mention__links">
    {
      essayHref && (
        <a class="site-action" href={essayHref} data-admin-motion-action>
          <img
            class="press-mention__link-mark"
            src="/images/brand/business-insider-favicon.svg"
            alt=""
            width="16"
            height="16"
            decoding="async"
          />
          <span>read the story</span>
          <Icon name="ph:arrow-bend-right-up" aria-hidden="true" />
        </a>
      )
    }
  </div>
</aside>

<style>
  .press-mention {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--card-header-gap);
    margin-top: var(--s-5);
    padding: var(--card-inset);
    border-radius: var(--paper-radius);
    background: var(--paper-surface);
    color: var(--paper-ink);
    box-shadow: var(--paper-shadow);
  }
  .press-mention > :global(.ambient-flow) {
    inset: -1px;
    border-radius: 0;
  }
  .press-mention__logo {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
    border-radius: var(--card-ui-radius);
  }
  .press-mention__content {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }
  .press-mention__title {
    font-family: var(--display);
    font-size: 1.1rem;
    font-weight: var(--card-title-weight);
    line-height: 1.2;
  }
  .press-mention__copy {
    margin: 0;
    color: var(--paper-muted);
    font-size: var(--control-size);
    line-height: 1.4;
  }
  .press-mention__links {
    justify-self: end;
  }
  @media (max-width: 640px) {
    .press-mention {
      gap: 0.625rem;
      padding: 1rem;
    }
    .press-mention__logo {
      width: 2rem;
      height: 2rem;
    }
    .press-mention__content {
      display: contents;
    }
    .press-mention__title {
      grid-column: 2;
      grid-row: 1;
      font-size: 1rem;
    }
    .press-mention__copy {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .press-mention__links {
      grid-column: 3;
      grid-row: 1;
    }
    .press-mention__links a {
      min-height: 44px;
      padding-inline: 0.5rem;
      column-gap: 0.375rem;
      font-size: 0.8rem;
    }
  }
  @media (max-width: 359px) {
    .press-mention {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .press-mention__links {
      grid-column: 1 / -1;
      grid-row: 3;
    }
  }
</style>
