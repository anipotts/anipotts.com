---
import WritingDetail from "../../components/WritingDetail.astro";
import {
  publishedWriting,
  writingSlug,
  publicContentContext,
} from "../../lib/content";
export const prerender = false;
const entries = await publishedWriting(publicContentContext(Astro.locals));
const item = entries.find((entry) => writingSlug(entry) === Astro.params.slug);
if (!item)
  return new Response("Not found", {
    status: 404,
    headers: { "X-Robots-Tag": "noindex", "Cache-Control": "no-store" },
  });
---

<WritingDetail item={item} allWriting={entries} />
