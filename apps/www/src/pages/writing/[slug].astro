---
import WritingDetail from "../../components/WritingDetail.astro";
import { publishedWriting, writingSlug, type Writing } from "../../lib/content";

export const prerender = true;
export async function getStaticPaths() {
  return (await publishedWriting()).map((item) => ({
    params: { slug: writingSlug(item) },
    props: { item },
  }));
}
interface Props {
  item: Writing;
}
const { item } = Astro.props;
---

<WritingDetail item={item} />
