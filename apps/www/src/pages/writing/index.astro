---
import Shell from "../../layouts/Shell.astro";
import WritingRow from "../../components/WritingRow.astro";
import PageHero from "../../components/PageHero.astro";
import { publishedWriting } from "../../lib/content";
import { publicPage, publicContentContext } from "../../lib/content";

export const prerender = false;
const context = publicContentContext(Astro.locals);

const writingEntries = await publishedWriting(context);
const page = await publicPage("writing", context);
if (!page) throw new Error("Missing canonical writing page");
const copy = page;
---

<Shell title={copy.title} description={copy.description} path="/writing">
  <PageHero title={copy.hero_title} summary={copy.hero_summary} />

  <section data-rise class="stack">
    <div class="list">
      {
        writingEntries.map((item, index) => (
          <WritingRow item={item} flowVariant={index} />
        ))
      }
    </div>
  </section>
</Shell>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
</style>
