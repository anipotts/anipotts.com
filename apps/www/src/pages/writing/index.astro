---
import Shell from "../../layouts/Shell.astro";
import WritingRow from "../../components/WritingRow.astro";
import { publishedWriting } from "../../lib/content";
import {
  DEFAULT_WRITING_INDEX_CONTENT,
  normalizeListingPageContent,
} from "@anipotts/content/public";

export const prerender = false;

const writingEntries = await publishedWriting();
const copy = normalizeListingPageContent(
  DEFAULT_WRITING_INDEX_CONTENT,
  DEFAULT_WRITING_INDEX_CONTENT,
);
---

<Shell
  title={copy.title}
  description={copy.description}
  path="/writing"
  mood="drowsy"
>
  <section data-rise>
    <h1 class="hero-title">{copy.hero_title}</h1>
    <p class="hero-summary">{copy.hero_summary}</p>
  </section>

  <section data-rise class="stack">
    <div class="list">
      {
        writingEntries.map((item, index) => (
          <WritingRow item={item} flowVariant={index} />
        ))
      }
    </div>
  </section>
</Shell>

<style>
  .hero-title {
    margin-bottom: var(--s-3);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
</style>
