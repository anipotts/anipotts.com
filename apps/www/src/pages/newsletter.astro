---
import { siteConfig } from "@anipotts/content/public";
import Shell from "../layouts/Shell.astro";
import NewsletterSubscribe from "../components/NewsletterSubscribe.astro";
import { getEntry } from "astro:content";

export const prerender = true;

const page = await getEntry("newsletterPage", "newsletter");
if (!page) throw new Error("Missing canonical newsletter page");
const copy = page.data;
---

<Shell
  title="newsletter"
  description="ani's notes on building with agents, software, and the small systems around them."
  path="/newsletter"
  canonicalUrl={siteConfig.newsletterUrl}
>
  <section data-rise class="hero">
    <p class="section-label">newsletter</p>
    <h1 class="hero-title">{copy.headline}</h1>
    <p class="hero-summary">
      {copy.deck}
    </p>
  </section>

  <section data-rise>
    <NewsletterSubscribe
      mode="form"
      lede={copy.deck}
      ctaLabel={copy.cta_label}
      footerText={copy.footer_text}
      successMessage={copy.success_message}
      errorMessage={copy.error_message}
    />
  </section>

  <section data-rise class="stack">
    <h2 class="section-label">{copy.archive_label}</h2>
    <p class="copy">{copy.archive_copy}</p>
    <a href={copy.archive_url} class="quiet-link archive">
      {copy.archive_link_label}
    </a>
  </section>
</Shell>

<style>
  .hero,
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .section-label {
    margin: 0;
  }

  .copy {
    margin: 0;
    max-width: var(--measure);
    color: var(--ink-muted);
  }

  .archive {
    align-self: flex-start;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
</style>
