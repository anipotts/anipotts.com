---
import { getEntry } from "astro:content";
import HomePage from "../components/HomePage.astro";
import { publishedWriting, visibleProjects } from "../lib/content";
export const prerender = true;
const home = await getEntry("home", "home");
if (!home) throw new Error("Missing canonical homepage content");
---

<HomePage
  cmsHome={home.data}
  allWork={await visibleProjects()}
  allWriting={await publishedWriting()}
/>
