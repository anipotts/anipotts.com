---
import HomePage from "../components/HomePage.astro";
import {
  publishedWriting,
  visibleProjects,
  publicPage,
  publicContentContext,
} from "../lib/content";
export const prerender = false;
const context = publicContentContext(Astro.locals);
const home = await publicPage("home", context);
---

<HomePage
  cmsHome={home}
  allWork={await visibleProjects(context)}
  allWriting={await publishedWriting(context)}
/>
