---
import HomePage from "../components/HomePage.astro";
import {
  publishedWriting,
  visibleProjects,
  publicPage,
  publicContentContext,
} from "../lib/content";
export const prerender = false;
const content = publicContentContext(Astro.locals);
const home = await publicPage("home", content);
if (!home) throw new Error("Missing canonical homepage content");
---

<HomePage
  cmsHome={home}
  allWork={await visibleProjects(content)}
  allWriting={await publishedWriting(content)}
/>
