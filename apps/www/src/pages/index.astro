---
import Shell from "../layouts/Shell.astro";
import ProjectCard from "../components/ProjectCard.astro";
import WritingRow from "../components/WritingRow.astro";
import NewsletterSubscribe from "../components/NewsletterSubscribe.astro";
import HomepageRichSummary from "../components/HomepageRichSummary.astro";
import { Icon } from "astro-icon/components";
import { publishedWriting, visibleProjects } from "../lib/content";
import { setDB } from "@anipotts/lib/db";
import type { D1Database } from "@anipotts/lib/db";
import {
  homepageSummaryText,
  normalizeHomepageContent,
  normalizeNewsletterContent,
} from "@anipotts/content/public";
import { fetchPageContent } from "@anipotts/lib/cms";

export const prerender = false;

setDB(Astro.locals.runtime.env.DB as unknown as D1Database);
const [homePage, newsletterPage] = await Promise.all([
  fetchPageContent("home"),
  fetchPageContent("newsletter"),
]);
const cmsHome = normalizeHomepageContent(homePage?.content);
const newsletterCopy = normalizeNewsletterContent(newsletterPage?.content);
const intro = cmsHome.sections.intro;
const work = cmsHome.sections.past_work;
const writing = cmsHome.sections.latest_thoughts;
const heading = intro.heading;
const proofCards = cmsHome.proof_cards;
const mentionMap = cmsHome.mentions;
const selectedMakingSlugs = work.project_slugs ?? [];
const selectedWritingSlugs = writing.writing_slugs ?? [];
const homeMakingOrder = new Map<string, number>(
  selectedMakingSlugs.map((slug, index) => [slug, index]),
);
const homeWritingOrder = new Map<string, number>(
  selectedWritingSlugs.map((slug, index) => [slug, index]),
);
const projects = (await visibleProjects())
  .filter((project) => homeMakingOrder.has(project.slug))
  .sort(
    (a, b) =>
      (homeMakingOrder.get(a.slug) ?? 0) - (homeMakingOrder.get(b.slug) ?? 0),
  )
  .slice(0, work.limit ?? 4);
const writingEntries = (await publishedWriting())
  .filter((item) => homeWritingOrder.has(item.slug))
  .sort(
    (a, b) =>
      (homeWritingOrder.get(a.slug) ?? 0) - (homeWritingOrder.get(b.slug) ?? 0),
  )
  .slice(0, writing.limit ?? 3);
const workLabel = work.label || "making";
const workHref = work.view_all ?? work.links?.[0]?.href ?? "/making";
const summaryText = homepageSummaryText(cmsHome);
---

<Shell title="ani potts" description={summaryText} path="/">
  <section data-rise>
    <h1 class="home-hero">
      {heading}<span class="spark">.</span>
    </h1>
    <p class="hero-summary hero-line">
      {
        intro.rich_summary && intro.rich_summary.length > 0 ? (
          <HomepageRichSummary
            sentences={intro.rich_summary}
            mentions={mentionMap}
          />
        ) : (
          summaryText
        )
      }
    </p>
    <div
      class="proof-grid mobile-carousel"
      aria-label="selected engineering proof"
    >
      {
        proofCards.map((item) => (
          <a href={item.href} class="proof-card">
            <span class="proof-label mono">{item.label}</span>
            <span class="proof-title">{item.title}</span>
            <span class="proof-detail">{item.detail}</span>
          </a>
        ))
      }
    </div>
  </section>

  {
    work.visible && (
      <section data-rise class="stack">
        <span class="head-row">
          <h2 class="section-label">{workLabel}</h2>
          <a href={workHref} class="quiet-link mono view-all">
            {work.links?.[0]?.label ?? "view all"}
            <Icon name="ph:arrow-bend-right-up" />
          </a>
        </span>
        <div class="grid mobile-carousel">
          {projects.map((project) => (
            <ProjectCard project={project} preview />
          ))}
        </div>
      </section>
    )
  }

  {
    writing.visible && (
      <section data-rise class="stack">
        <span class="head-row">
          <h2 class="section-label">{writing.label}</h2>
          <a
            href={writing.view_all ?? "/writing"}
            class="quiet-link mono view-all"
          >
            {writing.links?.[0]?.label ?? "view all"}
            <Icon name="ph:arrow-bend-right-up" />
          </a>
        </span>
        <div class="list">
          {writingEntries.map((item) => (
            <WritingRow item={item} />
          ))}
        </div>
      </section>
    )
  }

  <section data-rise>
    <NewsletterSubscribe
      lede={newsletterCopy.deck}
      href={newsletterCopy.buttondown_url}
      ctaLabel={newsletterCopy.cta_label}
      footerText={newsletterCopy.footer_text}
      variant="minimal"
    />
  </section>
</Shell>

<style>
  .home-hero {
    font-size: clamp(3rem, 12vw, 7rem);
    letter-spacing: 0;
    line-height: 0.9;
    margin-bottom: var(--s-4);
    font-weight: 900;
  }

  .spark {
    color: var(--accent);
  }

  .hero-line {
    max-width: 64ch;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .hero-line :global(.mention-cluster) {
    display: inline;
  }

  .hero-line :global(.inline-mention) {
    gap: 0.2em;
    vertical-align: -0.06em;
  }

  .hero-line :global(.brand-parens) {
    display: inline-flex;
    align-items: baseline;
    gap: 0;
    white-space: nowrap;
  }

  .hero-line :global(.inline-mention .brand-mark) {
    width: 0.92em;
    height: 0.92em;
    flex-basis: 0.92em;
    padding: 0;
    border-radius: 0.14em;
    background: transparent;
    box-shadow: none;
    transform: none;
  }

  .hero-line :global(.inline-mention .brand-mark-wide) {
    width: 1.24em;
    flex-basis: 1.24em;
  }

  .text-link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
  }

  .text-link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: var(--s-6);
    border-top: 1px solid var(--border);
  }

  .proof-card {
    display: grid;
    grid-template-columns: minmax(8rem, 0.72fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    min-height: 11rem;
    column-gap: var(--s-4);
    row-gap: var(--s-3);
    padding: var(--s-4);
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition:
      background 160ms ease,
      color 160ms ease;
  }

  .proof-card:nth-child(odd) {
    border-right: 1px solid var(--border);
  }

  .proof-card:hover {
    background: var(--accent-soft);
  }

  .proof-label {
    color: var(--ink-muted);
    font-size: 0.72rem;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .proof-title {
    grid-column: 1;
    align-self: end;
    font-family: var(--display);
    color: var(--ink);
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0;
    font-synthesis: none;
  }

  .proof-detail {
    grid-column: 2;
    grid-row: 1 / -1;
    align-self: center;
    padding-left: var(--s-4);
    border-left: 1px solid var(--border);
    color: var(--ink-muted);
    font-size: var(--p-small);
    line-height: 1.45;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .head-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-size: 0.85rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: var(--s-4);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  @media (max-width: 640px) {
    .home-hero {
      margin-bottom: var(--s-3);
    }

    .hero-line {
      font-size: clamp(1rem, 3.9vw, 1.12rem);
      line-height: 1.55;
    }

    .hero-line :global(.inline-mention) {
      gap: 0.18em;
    }

    .proof-grid {
      grid-template-columns: 1fr;
    }

    .proof-card:nth-child(odd) {
      border-right: 0;
    }

    .proof-card {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto 1fr;
      min-height: 14rem;
      padding-inline: 0;
    }

    .proof-title {
      grid-column: 1;
      align-self: auto;
    }

    .proof-detail {
      grid-column: 1;
      grid-row: auto;
      align-self: end;
      padding-top: var(--s-3);
      padding-left: 0;
      border-top: 1px solid var(--border);
      border-left: 0;
    }
  }
</style>
