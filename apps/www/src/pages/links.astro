---
import Shell from "../layouts/Shell.astro";
import { navItems, siteLinks, siteConfig } from "@anipotts/content/public";

const links = [
  ...navItems.map(({ name, path }) => ({ label: name, href: path })),
  siteLinks.email,
  siteLinks.github,
  siteLinks.linkedin,
  siteLinks.x,
];
---

<Shell
  title="links"
  description={`useful links for ${siteConfig.displayName}.`}
  path="/links"
  robots="noindex,follow"
>
  <section data-rise class="links-page">
    <p class="mono">{siteConfig.displayName}</p>
    <h1>links</h1>
    <nav aria-label="profile links">
      {
        links.map((link) => (
          <a href={link.href}>
            {link.label}
            <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </nav>
  </section>
</Shell>

<style>
  .links-page {
    display: grid;
    gap: var(--s-4);
    max-width: 38rem;
    padding-block: var(--s-5);
  }
  .links-page p,
  .links-page h1 {
    margin: 0;
  }
  .links-page h1 {
    font-size: clamp(3rem, 10vw, 6rem);
  }
  nav {
    display: grid;
    gap: var(--s-2);
  }
  nav a {
    display: flex;
    justify-content: space-between;
    padding: var(--s-3);
    color: var(--ink);
    border: 1px solid var(--border);
    border-radius: 0.8rem;
    text-decoration: none;
  }
  nav a:hover,
  nav a:focus-visible {
    border-color: var(--interactive);
    color: var(--interactive);
  }
</style>
