---
import { Icon } from "astro-icon/components";
import Shell from "../layouts/Shell.astro";
import { navItems, siteLinks, siteConfig } from "@anipotts/content/public";
import { isExternalDestination } from "../lib/link-destination";

// Only rows that leave the site open a new tab and carry the outbound glyph;
// the nav paths and the mailto: row stay in the current tab, unmarked.
const links = [
  ...navItems.map(({ name, path }) => ({ label: name, href: path })),
  siteLinks.email,
  siteLinks.github,
  siteLinks.linkedin,
  siteLinks.x,
].map((link) => ({ ...link, external: isExternalDestination(link.href) }));
---

<Shell
  title="links"
  description={`useful links for ${siteConfig.displayName}.`}
  path="/links"
  robots="noindex,follow"
>
  <section data-rise class="links-page">
    <p class="mono">{siteConfig.displayName}</p>
    <h1>links</h1>
    <nav aria-label="profile links">
      {
        links.map((link) => (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            {link.label}
            {link.external && (
              <Icon
                name="ph:arrow-bend-right-up"
                class="links-affordance"
                aria-hidden="true"
              />
            )}
          </a>
        ))
      }
    </nav>
  </section>
</Shell>

<style>
  .links-page {
    display: grid;
    gap: var(--s-4);
    padding-block: var(--s-5);
  }
  .links-page p,
  .links-page h1 {
    margin: 0;
  }
  .links-page h1 {
    font-size: var(--d-hero-compact);
  }
  nav {
    max-width: 38rem;
    display: grid;
    gap: var(--s-2);
  }
  nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    min-height: 44px;
    padding: var(--s-3);
    color: var(--ink);
    border: 1px solid var(--border);
    border-radius: 0.8rem;
    text-decoration: none;
  }
  nav a:focus-visible {
    border-color: var(--interactive);
    color: var(--interactive);
  }
  .links-affordance {
    flex: 0 0 auto;
    color: var(--ink-muted);
    transition: color 160ms ease;
  }
  nav a:focus-visible .links-affordance {
    color: var(--interactive);
  }
  @media (hover: hover) and (pointer: fine) {
    nav a:hover {
      border-color: var(--interactive);
      color: var(--interactive);
    }
    nav a:hover .links-affordance {
      color: var(--interactive);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .links-affordance {
      transition: none;
    }
  }
</style>
