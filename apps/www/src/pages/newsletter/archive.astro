---
import { siteConfig } from "@anipotts/content/public";
import Shell from "../../layouts/Shell.astro";
import { getEntry } from "astro:content";

export const prerender = true;

const page = await getEntry("newsletterArchivePage", "newsletter_archive");
if (!page) throw new Error("Missing canonical newsletter archive page");
const copy = page.data;
---

<Shell
  title={copy.title}
  description={copy.description}
  path="/newsletter/archive"
  canonicalUrl={`${siteConfig.newsletterUrl}/archive`}
>
  <section data-rise class="stack">
    <p class="section-label">{copy.section_label || "archive"}</p>
    <h1 class="hero-title">{copy.hero_title}</h1>
    <p class="hero-summary">{copy.hero_summary}</p>
  </section>
</Shell>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .section-label {
    margin: 0;
  }
</style>
