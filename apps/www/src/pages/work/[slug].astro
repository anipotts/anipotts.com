---
import WorkDetail from "../../components/WorkDetail.astro";
import { projectSlug, visibleProjects, type Project } from "../../lib/content";

export const prerender = true;
export async function getStaticPaths() {
  return (await visibleProjects()).map((project) => ({
    params: { slug: projectSlug(project) },
    props: { project },
  }));
}
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<WorkDetail project={project} />
