---
import WorkDetail from "../../components/WorkDetail.astro";
import {
  visibleProjects,
  projectSlug,
  publicContentContext,
} from "../../lib/content";
export const prerender = false;
const entries = await visibleProjects(publicContentContext(Astro.locals));
const project = entries.find(
  (entry) => projectSlug(entry) === Astro.params.slug,
);
if (!project)
  return new Response("Not found", {
    status: 404,
    headers: { "X-Robots-Tag": "noindex", "Cache-Control": "no-store" },
  });
---

<WorkDetail project={project} />
