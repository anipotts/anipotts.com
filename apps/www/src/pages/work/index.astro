---
import Shell from "../../layouts/Shell.astro";
import WorkCard from "../../components/WorkCard.astro";
import PageHero from "../../components/PageHero.astro";
import { visibleProjects } from "../../lib/content";
import { getEntry } from "astro:content";

export const prerender = true;
const projects = await visibleProjects();
const entry = await getEntry("workPage", "work");
if (!entry) throw new Error("Missing canonical work page");
const copy = entry.data;
const groups = [
  {
    id: "experience",
    items: projects.filter((p) => p.data.kind === "experience"),
  },
  {
    id: "selected",
    items: projects.filter(
      (p) => p.data.kind === "project" && p.data.public_state === "featured",
    ),
  },
  {
    id: "archive",
    items: projects.filter(
      (p) => p.data.kind === "project" && p.data.public_state === "listed",
    ),
  },
];
---

<Shell
  title={copy.title}
  description={copy.description}
  path="/work"
  mood="alert"
>
  <PageHero title={copy.hero_title} summary={copy.hero_summary} />
  <div class="catalog">
    {
      groups
        .filter((group) => group.items.length)
        .map((group) => (
          <section id={group.id} aria-labelledby={`heading-${group.id}`}>
            <h2 id={`heading-${group.id}`}>
              {copy.buckets?.find((bucket) => bucket.id === group.id)?.label ??
                group.id}
            </h2>
            <div class="work-grid">
              {group.items.map((project, index) => (
                <WorkCard project={project} flowVariant={index} />
              ))}
            </div>
          </section>
        ))
    }
  </div>
</Shell>

<style>
  .catalog {
    display: grid;
    gap: var(--s-7);
  }
  section {
    min-width: 0;
    scroll-margin-top: 6rem;
  }
  h2 {
    font-size: var(--d-section);
    margin: 0 0 var(--s-5);
  }
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--s-4);
  }
</style>
