---
import Shell from "../layouts/Shell.astro";
import SystemMap from "../components/SystemMap.astro";
import { Icon } from "astro-icon/components";
import {
  DEFAULT_SYSTEMS_CONTENT,
  normalizeSystemsPageContent,
} from "@anipotts/content/public";

export const prerender = false;

const content = normalizeSystemsPageContent(DEFAULT_SYSTEMS_CONTENT);
---

<Shell title={content.title} description={content.description} path="/systems">
  <section data-rise>
    <h1 class="hero-title">{content.hero_title}</h1>
    <p class="hero-summary">{content.hero_summary}</p>
  </section>

  <section data-rise class="stack">
    <SystemMap
      principle={content.map_principle}
      domains={content.map_domains}
    />
  </section>

  <section data-rise class="stack">
    <h2 class="section-label">{content.writing_label}</h2>
    <a class="feature" href={content.featured_writing.href}>
      <strong>{content.featured_writing.title}</strong>
      <span>{content.featured_writing.detail}</span>
      <Icon name="ph:arrow-bend-right-up" aria-hidden="true" />
    </a>
  </section>

  <section data-rise class="stack">
    <h2 class="section-label">{content.tools_label}</h2>
    <div class="tool-grid">
      {
        content.public_tools.map((tool) => (
          <a
            class="feature"
            href={tool.href}
            target={tool.href.startsWith("/") ? undefined : "_blank"}
            rel={tool.href.startsWith("/") ? undefined : "noopener noreferrer"}
          >
            <strong>{tool.title}</strong>
            <span>{tool.detail}</span>
            <Icon name="ph:arrow-bend-right-up" aria-hidden="true" />
          </a>
        ))
      }
    </div>
  </section>
</Shell>

<style>
  .stack,
  .feature {
    display: grid;
  }
  .hero-title {
    margin-bottom: var(--s-3);
  }
  .stack {
    gap: var(--s-4);
  }
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .feature {
    position: relative;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-2);
    padding: var(--s-4);
    border-radius: 0.75rem;
    background: var(--surface);
  }
  .feature {
    margin: 0;
  }
  .feature span {
    grid-column: 1;
    color: var(--ink-muted);
    line-height: 1.55;
  }
  .feature {
    color: var(--ink);
    text-decoration: none;
    transition:
      background 0.18s ease,
      transform 0.18s ease;
  }
  .feature:hover,
  .feature:focus-visible {
    background: var(--accent-soft);
    transform: translateY(-2px);
  }

  @media (max-width: 980px) {
    .tool-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature {
      transition: none;
    }

    .feature:hover,
    .feature:focus-visible {
      transform: none;
    }
  }
</style>
