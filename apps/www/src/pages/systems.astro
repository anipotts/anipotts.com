---
import InlineText from "../components/InlineText.astro";
import Shell from "../layouts/Shell.astro";
import SystemMap from "../components/SystemMap.astro";
import PageHero from "../components/PageHero.astro";
import { publicPage, publicContentContext } from "../lib/content";

export const prerender = false;
const page = await publicPage("systems", publicContentContext(Astro.locals));
if (!page) throw new Error("Missing canonical systems page");
const content = page;
---

<Shell title={content.title} description={content.description} path="/systems">
  <PageHero title={content.hero_title} summary={content.hero_summary} />
  <section class="stack" aria-label="Working with agents">
    <div class="intro">
      {
        content.workflow.intro
          .split(/\n\s*\n/)
          .filter(Boolean)
          .map((paragraph) => (
            <p class="page-intro">
              <InlineText text={paragraph} />
            </p>
          ))
      }
    </div>
    <SystemMap workflow={content.workflow} />
    {
      content.workflow.outro && (
        <p class="page-intro workflow-outro">
          <InlineText text={content.workflow.outro} />
        </p>
      )
    }
  </section>
</Shell>

<style>
  .stack {
    display: grid;
    gap: var(--s-6);
  }
  .intro {
    display: grid;
    gap: 1.25em;
    margin: 0;
  }
</style>
