---
import Shell from "../layouts/Shell.astro";
import SystemMap from "../components/SystemMap.astro";
import PageHero from "../components/PageHero.astro";
import { getEntry } from "astro:content";

export const prerender = true;
const page = await getEntry("systemsPage", "systems");
if (!page) throw new Error("Missing canonical systems page");
const content = page.data;
---

<Shell title={content.title} description={content.description} path="/systems">
  <PageHero title={content.hero_title} summary={content.hero_summary} />
  <section class="stack" aria-label="Working with agents">
    <div class="intro">
      {
        content.workflow.intro
          .split(/\n\s*\n/)
          .filter(Boolean)
          .map((paragraph) => <p class="page-intro">{paragraph}</p>)
      }
    </div>
    <SystemMap workflow={content.workflow} />
    {
      content.workflow.outro && (
        <p class="page-intro workflow-outro">{content.workflow.outro}</p>
      )
    }
  </section>
</Shell>

<style>
  .stack {
    display: grid;
    gap: var(--s-6);
  }
  .intro {
    display: grid;
    gap: 1.25em;
    margin: 0;
  }
</style>
