---
import { inlinePlainText } from "@anipotts/content/public/inline";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageCurrent from "../components/PageCurrent.astro";
import { siteConfig } from "@anipotts/content/public";
import { personId, websiteId } from "../lib/identity";
import {
  CARD_HEIGHT,
  CARD_WIDTH,
  SITE_CARD,
  cardPath,
} from "../lib/social-card/routes";

interface Props {
  title: string;
  description: string;
  path: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;
  canonicalUrl?: string;
  detail?: boolean;
  /** Card name under /social, from lib/social-card/routes. */
  socialCard?: string;
}

const {
  title,
  description: rawDescription,
  path,
  ogType = "website",
  jsonLd,
  canonicalUrl,
  robots,
  detail = false,
} = Astro.props;
const description = inlinePlainText(rawDescription);
const canonical =
  canonicalUrl ?? `${siteConfig.url}${path === "/" ? "" : path}`;
const fullTitle = path === "/" ? title : `${title} / ${siteConfig.displayName}`;
// Every route uses the approved canonical brand card.
const cardUrl = `${siteConfig.url}${cardPath(SITE_CARD)}?v=corner-1`;

const siteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": websiteId,
  name: siteConfig.displayName,
  url: siteConfig.url,
  author: { "@id": personId },
};
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html
  lang="en"
  class:list={{
    "editorial-detail": detail,
    "writing-detail": detail && ogType === "article",
  }}
>
  <head>
    <ClientRouter fallback="swap" />
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href="/brand/ap-favicon-96.png?v=20260929"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/brand/ap-favicon-32.png?v=20260929"
    />
    <link
      rel="icon"
      href="/brand/ap-favicon.svg?v=20260929"
      type="image/svg+xml"
      sizes="any"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/brand/apple-touch-icon.png?v=20260929"
    />
    <link rel="alternate" type="application/rss+xml" href="/feed.xml" />
    <meta name="theme-color" content="#61abea" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:width" content={String(CARD_WIDTH)} />
    <meta property="og:image:height" content={String(CARD_HEIGHT)} />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={cardUrl} />
    <meta name="twitter:image:alt" content={fullTitle} />
    <script is:inline>
      (() => {
        let stored;
        try {
          const incoming = new URL(location.href).searchParams.get("theme");
          const cookie = document.cookie.match(
            /(?:^|;\s*)ap-theme=(light|dark|system)(?:;|$)/,
          )?.[1];
          stored =
            (["light", "dark", "system"].includes(incoming)
              ? incoming
              : null) ||
            cookie ||
            localStorage.getItem("theme");
        } catch {
          // Storage can be disabled; the default theme still renders normally.
        }
        const theme =
          stored === "system"
            ? matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : stored === "dark"
              ? "dark"
              : "light";
        const root = document.documentElement;
        root.dataset.theme = theme;
        if (window.__apThemeSync) {
          window.__apThemeSync();
          return;
        }
        // Safari's surrounding canvas and older theme-color consumers must use
        // the site's selected theme, even when it differs from the OS theme.
        const syncBrowserTheme = () => {
          if (window.__apCanvasSync) {
            window.__apCanvasSync();
            return;
          }
          root.style.colorScheme =
            root.dataset.theme === "dark" ? "dark" : "light";
          const background = getComputedStyle(root).backgroundColor;
          if (
            background &&
            background !== "rgba(0, 0, 0, 0)" &&
            background !== "transparent"
          ) {
            document
              .querySelector('meta[name="theme-color"]')
              ?.setAttribute("content", background);
          }
        };
        window.__apThemeSync = syncBrowserTheme;
        syncBrowserTheme();
        new MutationObserver(syncBrowserTheme).observe(root, {
          attributes: true,
          attributeFilter: ["data-theme"],
        });
        document.addEventListener("DOMContentLoaded", syncBrowserTheme, {
          once: true,
        });
        window.addEventListener("pageshow", syncBrowserTheme);
      })();
    </script>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(siteLd)}
    />
    {
      jsonLdItems.map((item) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(item)}
        />
      ))
    }
  </head>
  <body>
    {!detail && <PageCurrent />}
    <Nav />
    <main
      class:list={[
        "frame page",
        { "page--listing": ["/systems", "/work", "/writing"].includes(path) },
      ]}
    >
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/writing-transitions";
      import { installPointerModality } from "../scripts/pointer-modality";
      installPointerModality(document);
    </script>
  </body>
</html>
