{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".prettierrc*",
    "tsconfig.json",
    "pnpm-workspace.yaml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "tsup.config.*", "package.json"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NODE_ENV"]
    },
    "@anipotts/www#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_ROOT$/content/public/**",
        "src/**",
        "public/**",
        "tsconfig.json",
        "package.json",
        "astro.config.mjs",
        "wrangler.toml"
      ],
      "outputs": ["dist/**"],
      "env": [
        "NODE_ENV",
        "PUBLIC_POSTHOG_KEY",
        "PUBLIC_TURNSTILE_SITE_KEY",
        "PUBLIC_RELEASE_SHA"
      ]
    },
    "@anipotts/admin#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_ROOT$/content/public/**",
        "$TURBO_ROOT$/content/editorial/**",
        "$TURBO_ROOT$/scripts/dev/editorial-updates.mjs",
        "src/**",
        "public/**",
        "tsconfig.json",
        "package.json",
        "astro.config.mjs",
        "wrangler.toml"
      ],
      "outputs": ["dist/**"],
      "env": [
        "NODE_ENV",
        "PUBLIC_STATE_API",
        "PUBLIC_RELEASE_SHA",
        "PUBLIC_RELEASE_SCHEMA_VERSION"
      ]
    },
    "@anipotts/state#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json", "wrangler.toml"],
      "outputs": [],
      "env": ["NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "eslint.config.*", "package.json"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "vitest.config.*", "package.json"],
      "outputs": []
    },
    "@anipotts/www#test": {
      "dependsOn": ["build"],
      "inputs": ["test/**", "package.json"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "@anipotts/content#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_ROOT$/content/public/**",
        "$TURBO_ROOT$/scripts/content/generate-public-content.mjs",
        "src/**",
        "!src/public/generated.ts",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**",
        "src/public/generated.ts",
        "generated/admin-public-content.json"
      ]
    },
    "@anipotts/admin#test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "vitest*.config.ts", "package.json"],
      "outputs": []
    }
  }
}
